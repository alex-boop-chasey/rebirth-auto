# =============================================================================
#  Rebirth Auto — environment variables
#
#  There are TWO SEPARATE WORLDS (see CLAUDE.md → "Stack"). Getting a var into
#  the wrong one is the #1 cause of "works locally, breaks on Cloudflare":
#
#   A) BUILD-TIME, PUBLIC  →  PUBLIC_* prefixed. Vite INLINES these into the
#      bundle at build. A var WITHOUT the PUBLIC_ prefix is invisible to
#      `import.meta.env`.
#         local:  this .env file
#         prod:   Cloudflare → your Worker → Settings → Build → Variables & Secrets
#
#   B) RUNTIME, SERVER-ONLY  →  everything else. Read from the Worker runtime env
#      via `import { env } from 'cloudflare:workers'`. NEVER inlined into the
#      client bundle.
#         local:  .dev.vars          (NOT this file)
#         prod:   `wrangler secret put <NAME>`  (or runtime Variables)
# =============================================================================


# -----------------------------------------------------------------------------
#  A) BUILD-TIME PUBLIC vars  —  .env (local)  +  Cloudflare BUILD variables
# -----------------------------------------------------------------------------

# Sanity — public project coordinates. REQUIRED AT BUILD (listings are prerendered
# from Sanity). A missing PUBLIC_SANITY_PROJECT_ID fails the Cloudflare build.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
PUBLIC_SANITY_API_VERSION=

# Supabase — public project URL only (safe to expose). The KEY is NOT here — it is
# a server-only runtime var; see world B (SUPABASE_PUBLISHABLE_KEY).
PUBLIC_SUPABASE_URL=

# Turnstile — public site keys (safe to expose; used in the browser).
#   PUBLIC_USER_TURNSTILE_KEY  auth/login widget (sign-up, sign-in, reset).
#   PUBLIC_BOT_TURNSTILE_KEY   chatbot widget.
PUBLIC_USER_TURNSTILE_KEY=
PUBLIC_BOT_TURNSTILE_KEY=

# Canonical site URL (OG / canonical / sitemap).
PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
#  Node-script secret  —  .env only (read by dotenv in seed/import/migrate)
# -----------------------------------------------------------------------------

# Sanity token, Editor scope, for the data scripts. NOTE: the Worker ALSO needs
# this at runtime (the /api/generate-description draft read) — so the same value
# ALSO goes in world B (.dev.vars / `wrangler secret put SANITY_TOKEN`).
SANITY_TOKEN=


# =============================================================================
#  B) RUNTIME / SERVER-ONLY  —  put these in `.dev.vars` (local) and
#     `wrangler secret put <NAME>` (prod). Do NOT put them here, and do NOT add
#     them to Cloudflare BUILD variables. Listed here as documentation only.
#     (See `.dev.vars` for the live local values.)
#
#   SUPABASE_PUBLISHABLE_KEY   Supabase publishable key (the new `sb_publishable_…`).
#                              Server-only (createServerClient). Replaces the legacy
#                              anon key. NO PUBLIC_ prefix — read from the runtime env.
#   SUPABASE_SECRET_KEY        Supabase secret key. NOT used yet — the seam for future
#                              server-side admin / RLS-enforcing operations. Never public.
#   SECRET_USER_TURNSTILE_KEY  Turnstile server secret for the auth/login widget.
#   SECRET_BOT_TURNSTILE_KEY   Turnstile server secret for the chatbot widget.
#   OPENROUTER_API_KEY         All LLM calls (via src/ai).
#   SANITY_TOKEN               Same token as world A — the Worker needs it at runtime too.
#   TELEGRAM_BOT_TOKEN         Handoff notifications (optional).
#   TELEGRAM_CHAT_ID           Handoff target chat (optional).
#   TELEGRAM_WEBHOOK_SECRET    Telegram webhook verification (optional).
# =============================================================================
