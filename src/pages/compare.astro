---
export const prerender = false;

import '../styles/global.css';
import { client } from '../sanity/lib/client';
import { urlFor } from '../sanity/lib/image';
import ChatWidget from '../components/widgets/ChatWidget.astro';
import AskRebiButton from '../components/AskRebiButton.astro';
import { dealerConfig } from '../config/dealer';
import {
  type Listing,
  type ListingDetail,
  LISTING_FIELDS,
  formatPrice,
  detailDisplay,
  buildSpecRows,
  iconSvg,
  detailIconName,
  isLowerBetter,
} from '../lib/listing';
import {
  type CompareCar,
  type DimKey,
  buildVerdict,
  LENSES,
} from '../lib/compare-verdict';

const year = new Date().getFullYear();

// Parse ?ids=a,b,c — trim, drop blanks, dedupe, cap at 3 (the Verdict Board is
// designed for a 2–3 car head-to-head; more columns dilute a decisive verdict).
const idsParam = Astro.url.searchParams.get('ids') ?? '';
const ids = [
  ...new Set(
    idsParam
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean),
  ),
].slice(0, 3);

let listings: Listing[] = [];
if (ids.length > 0) {
  const fetched = await client.fetch<Listing[]>(
    `*[_type == "listing" && _id in $ids]{ ${LISTING_FIELDS} }`,
    { ids },
  );
  // Preserve the order given in the URL (GROQ `in` doesn't guarantee it).
  const byId = new Map(fetched.map((l) => [l._id, l]));
  listings = ids.map((id) => byId.get(id)).filter((l): l is Listing => Boolean(l));
}

// The board needs at least two cars to compare; below that we show a prompt.
const canCompare = listings.length >= 2;

// Unified spec rows per listing (typed fields, with details[] fallback).
const rowsById = new Map<string, ListingDetail[]>(
  listings.map((l) => [l._id, buildSpecRows(l)]),
);

// Union of row labels across all listings, in first-appearance order.
const labels: string[] = [];
for (const l of listings) {
  for (const d of rowsById.get(l._id) ?? []) {
    if (!labels.includes(d.label)) labels.push(d.label);
  }
}

const detailFor = (l: Listing, label: string): ListingDetail | undefined =>
  (rowsById.get(l._id) ?? []).find((d) => d.label === label);

// Which columns win a numeric row? Set of column indexes, or null when the row
// isn't comparable (any value missing, mixed units, or everyone ties). This is
// the existing, shared winner heuristic — the verdict card reuses the same idea
// via compare-verdict.ts; row highlighting stays here.
function winners(
  values: (number | null)[],
  units: (string | undefined)[],
  lowerBetter: boolean,
): Set<number> | null {
  if (values.length < 2 || values.some((v) => v == null)) return null;
  const unit0 = units[0];
  if (!units.every((u) => u === unit0)) return null;
  const nums = values as number[];
  const best = lowerBetter ? Math.min(...nums) : Math.max(...nums);
  const set = new Set<number>();
  nums.forEach((n, i) => {
    if (n === best) set.add(i);
  });
  return set.size === nums.length ? null : set; // no highlight if all tie
}

// Gap between the winning value and the next-best, formatted as a delta chip.
function deltaText(
  nums: (number | null)[],
  win: Set<number> | null,
  lowerBetter: boolean,
  unit: string | undefined,
  isPrice: boolean,
  currency: string,
): string | null {
  if (!win || win.size !== 1) return null;
  const present = nums.filter((n): n is number => n != null);
  if (present.length < 2) return null;
  const winner = lowerBetter ? Math.min(...present) : Math.max(...present);
  const rest = present.filter((v) => v !== winner);
  if (!rest.length) return null;
  const next = lowerBetter ? Math.min(...rest) : Math.max(...rest);
  const gap = Math.abs(next - winner);
  if (gap === 0) return null;
  if (isPrice) return `${formatPrice(gap, currency)} less`;
  const n = gap.toLocaleString(dealerConfig.locale.locale);
  if (unit) return `${n} ${unit} ${lowerBetter ? 'less' : 'more'}`;
  return `${gap} ${lowerBetter ? 'fewer' : 'more'}`;
}

// --- Grouped spec matrix -----------------------------------------------------
// Map each spec label into a quiet section. Anything unmatched lands in Identity.
const GROUP_ORDER = [
  'Price & value',
  'Age & usage',
  'Running costs',
  'Drivetrain & size',
  'Identity',
] as const;
type GroupTitle = (typeof GROUP_ORDER)[number];

const LABEL_GROUP: Record<string, GroupTitle> = {
  year: 'Age & usage',
  odometer: 'Age & usage',
  fuel: 'Running costs',
  'fuel type': 'Running costs',
  body: 'Drivetrain & size',
  transmission: 'Drivetrain & size',
  drive: 'Drivetrain & size',
  seats: 'Drivetrain & size',
  doors: 'Drivetrain & size',
};

// Which scoring dimension (if any) a row maps to — drives lens relevance accents.
const LABEL_DIM: Record<string, DimKey> = {
  year: 'newer',
  odometer: 'lowkm',
  seats: 'space',
};

interface CellVM {
  display: string;
  missing: boolean;
  win: boolean;
  delta: string | null;
  mono: boolean;
}
interface RowVM {
  label: string;
  icon: string;
  dim: DimKey | null;
  same: boolean;
  scored: boolean;
  cells: CellVM[];
}

const tallies = listings.map(() => 0);
let scoredRowCount = 0;

function buildLabelRow(label: string): RowVM {
  const cells = listings.map((l) => detailFor(l, label));
  const nums = cells.map((d) =>
    d && d.valueType === 'number' && d.valueNumber != null ? d.valueNumber : null,
  );
  const units = cells.map((d) => d?.unit);
  const lowerBetter = isLowerBetter(label);
  const win = winners(nums, units, lowerBetter);
  const displays = cells.map((d) => (d ? detailDisplay(d) : ''));
  const same = displays.every((v) => v === displays[0] && v !== '') && listings.length > 1;
  if (win) {
    scoredRowCount++;
    win.forEach((i) => (tallies[i] += 1));
  }
  const isPrice = false;
  const unit0 = units.find((u) => u);
  const delta = deltaText(nums, win, lowerBetter, unit0, isPrice, '');
  const mono = label.toLowerCase() === 'vin';
  return {
    label,
    icon: detailIconName(label),
    dim: LABEL_DIM[label.toLowerCase()] ?? null,
    same,
    scored: !!win,
    cells: cells.map((d, i) => ({
      display: d ? detailDisplay(d) : '',
      missing: !d,
      win: !!win?.has(i),
      delta: win?.has(i) ? delta : null,
      mono,
    })),
  };
}

// Price is a first-class row (top-level field, lower wins).
const priceNums = listings.map((l) => l.price ?? null);
const priceWin = winners(priceNums, listings.map(() => 'currency'), true);
if (priceWin) {
  scoredRowCount++;
  priceWin.forEach((i) => (tallies[i] += 1));
}
const priceDelta = deltaText(
  priceNums,
  priceWin,
  true,
  undefined,
  true,
  listings[0]?.currency ?? dealerConfig.locale.currency,
);
const priceRow: RowVM = {
  label: 'Price',
  icon: 'tag',
  dim: 'value',
  same: priceNums.every((v) => v === priceNums[0]) && listings.length > 1,
  scored: !!priceWin,
  cells: listings.map((l, i) => ({
    display: formatPrice(l.price, l.currency),
    missing: !(l.price && l.price > 0),
    win: !!priceWin?.has(i),
    delta: priceWin?.has(i) ? priceDelta : null,
    mono: false,
  })),
};

// Assemble ordered groups, dropping any that end up empty.
const grouped = new Map<GroupTitle, RowVM[]>();
grouped.set('Price & value', [priceRow]);
for (const label of labels) {
  const g = LABEL_GROUP[label.toLowerCase()] ?? 'Identity';
  const arr = grouped.get(g) ?? [];
  arr.push(buildLabelRow(label));
  grouped.set(g, arr);
}
const sections = GROUP_ORDER.map((title) => ({ title, rows: grouped.get(title) ?? [] })).filter(
  (s) => s.rows.length > 0,
);

// Count of identical rows (hidden by "Differences only").
const sameCount =
  (priceRow.same ? 1 : 0) +
  sections.flatMap((s) => s.rows).filter((r) => r !== priceRow && r.same).length;

// --- Scoring data (shared with the client) -----------------------------------
const cars: CompareCar[] = listings.map((l) => ({
  id: l._id,
  name: [l.make, l.model].filter(Boolean).join(' ') || l.title,
  currency: l.currency || dealerConfig.locale.currency,
  price: l.price ?? null,
  year: l.vehicleSpecs?.year ?? null,
  odometer: l.vehicleSpecs?.odometer ?? null,
  seats: l.vehicleSpecs?.seatCount ?? null,
}));

// Initial (no-JS) verdict for the default "Balanced" lens.
const verdict = canCompare ? buildVerdict(cars, 'balanced') : null;
const pickId = verdict?.pickId ?? '';

const heroFor = (l: Listing) =>
  l.images?.[0]
    ? urlFor(l.images[0]).width(480).height(300).fit('crop').auto('format').url()
    : null;

const crownSvg =
  '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12h12M2 12l1-6 3 3 2-4 2 4 3-3 1 6"/></svg>';
const boltSvg =
  '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 1.5L3.5 9H8l-1 5.5L12.5 7H8z"/></svg>';

const title = 'Compare vehicles — Rebirth Auto';
const description = 'Compare listings side by side — with Rebi’s verdict.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
  </head>
  <body class="vboard">
    <div class="wrap">
      <!-- Header -->
      <div class="topbar">
        <a class="brand" href="/">Rebirth<span> Auto</span></a>
        <a class="back" href="/">
          <Fragment set:html={iconSvg('arrowLeft', 'ic')} />
          Back to inventory
        </a>
      </div>

      <main id="main-content">
        {
          canCompare ? (
            <>
              <div class="mast">
                <p class="eyebrow"><span class="dot" /> Compare · Verdict board</p>
                <h1>Which should you buy, <span class="mut">and why?</span></h1>
                <p class="lede">
                  A full side-by-side, but Rebi calls it first. Pick the lens that fits how you'll
                  use the car — the recommendation and spotlight update live, while the columns stay
                  put. Best value in each comparable row is highlighted.
                </p>
              </div>

              {/* CONTROL BAR */}
              <div class="controls">
                <span class="lens-label">
                  <Fragment set:html={iconSvg('filter', 'ic')} />
                  Compare for
                </span>
                <div class="lenses" id="lenses">
                  {LENSES.map((l) => (
                    <button
                      class:list={['lens', l.id === 'balanced' && 'active']}
                      data-lens={l.id}
                      type="button"
                    >
                      {l.label}
                    </button>
                  ))}
                </div>
                <span class="spacer" />
                <label class="toggle">
                  <input type="checkbox" id="diffToggle" />
                  <span class="track"><span class="knob" /></span>
                  <span class="lbl">Differences only</span>
                </label>
                <AskRebiButton
                  id="compare-decide"
                  class="ask"
                  data-rebi-open
                  data-rebi-kind="compare"
                  data-rebi-refs={ids.join(',')}
                  data-rebi-title={`these ${listings.length} vehicles`}
                  label="Ask Rebi to decide"
                />
              </div>

              {/* BOARD */}
              <div class="board" id="board">
                <div class="scroller">
                  <div class="grid" style={`--n:${listings.length}`}>
                    <div class="beam" id="beam" />

                    {/* header row: verdict corner + car headers */}
                    <div class="row hrow">
                      <div class="verdict-corner">
                        <div class="vc-top">
                          <div class="rebi-orb">
                            <Fragment set:html={iconSvg('sparkle', 'ic')} />
                          </div>
                          <div>
                            <div class="vc-kick">Rebi's pick</div>
                            <div class="vc-role" id="vc-role">for the balanced buyer</div>
                          </div>
                        </div>
                        <div class="vc-pick">Go with the <em id="vc-pick">{verdict?.pickName}</em></div>
                        <div class="vc-score-row">
                          <span class="vc-score num" id="vc-score">{verdict?.score}</span>
                          <span class="vc-score-lbl">match</span>
                        </div>
                        <div class="vc-reasons" id="vc-reasons" aria-live="polite">
                          {verdict?.reasons.map((r) => (
                            <div class:list={['vc-reason', r.caveat && 'caveat']}>
                              <Fragment set:html={r.caveat ? boltSvg : iconSvg('check', 'ic')} />
                              <span>{r.text}</span>
                            </div>
                          ))}
                        </div>
                        <div class="vc-lens-note">
                          Weighing <b id="vc-weighing">{verdict?.weighing}</b>
                        </div>
                      </div>

                      {listings.map((l, i) => {
                        const hero = heroFor(l);
                        const isPick = l._id === pickId;
                        return (
                          <div
                            class:list={['chead', isPick && 'pick']}
                            data-car-id={l._id}
                          >
                            <div class="photo">
                              <button
                                class="remove"
                                type="button"
                                data-remove={l._id}
                                title="Remove from compare"
                                aria-label={`Remove ${l.title} from compare`}
                              >
                                <Fragment set:html={iconSvg('cross', 'ic')} />
                              </button>
                              <span class="ribbon"><Fragment set:html={crownSvg} /> Rebi's pick</span>
                              <a href={`/listings/${l.slug?.current ?? ''}`}>
                                {hero ? (
                                  <img src={hero} alt={l.title} loading="lazy" />
                                ) : (
                                  <span class="photo-empty">
                                    <Fragment set:html={iconSvg('image', 'ic-lg')} />
                                  </span>
                                )}
                              </a>
                            </div>
                            <h3 class="ctitle">
                              <a href={`/listings/${l.slug?.current ?? ''}`}>{l.title}</a>
                            </h3>
                            <div class="cprice-row">
                              <span class="cprice num">{formatPrice(l.price, l.currency)}</span>
                            </div>
                            <div class="tally">
                              <span class="pips">
                                {[0, 1, 2].map((k) => (
                                  <span class:list={['pip', k < Math.min(tallies[i], 3) && 'on']} />
                                ))}
                              </span>
                              wins {tallies[i]} of {scoredRowCount} specs
                            </div>
                          </div>
                        );
                      })}
                    </div>

                    {/* sections + spec rows */}
                    {sections.map((sec) => (
                      <>
                        <div class="row section">
                          <div class="rail">{sec.title}</div>
                          <div class="fill" />
                        </div>
                        {sec.rows.map((r) => (
                          <div
                            class:list={['row', 'spec', r.same && 'same']}
                            data-dim={r.dim ?? undefined}
                          >
                            <div class="rail">
                              <Fragment set:html={iconSvg(r.icon, 'ic')} />
                              {r.label}
                            </div>
                            {r.cells.map((c) => (
                              <div class:list={['cell', c.win && 'win']}>
                                {c.missing ? (
                                  <span class="val missing">—</span>
                                ) : (
                                  <span class:list={['val', c.mono && 'mono']}>{c.display}</span>
                                )}
                                {c.win && (
                                  <span class="win-badge">
                                    <Fragment set:html={iconSvg('check', 'ic')} /> Best
                                  </span>
                                )}
                                {c.delta && (
                                  <span class="delta">
                                    {c.delta}<span class="vs">vs next</span>
                                  </span>
                                )}
                              </div>
                            ))}
                          </div>
                        ))}
                      </>
                    ))}
                  </div>
                </div>
                <div class="same-note" id="sameNote">
                  <b>{sameCount} spec{sameCount === 1 ? '' : 's'} identical</b> across these
                  {' '}{listings.length} vehicles and hidden. Toggle off to see everything.
                </div>
              </div>
            </>
          ) : (
            /* Empty / not-enough state */
            <div class="empty">
              <div class="empty-ic">
                <Fragment set:html={iconSvg('image', 'ic-lg')} />
              </div>
              <h2>{listings.length === 1 ? 'Add one more to compare' : 'Nothing to compare yet'}</h2>
              <p>
                {listings.length === 1
                  ? 'The Verdict Board needs at least two vehicles side by side.'
                  : 'Add a couple of listings using the “Compare” button on any card.'}
              </p>
              <a class="empty-cta" href="/">
                Browse listings
                <Fragment set:html={iconSvg('arrow', 'ic')} />
              </a>
            </div>
          )
        }
      </main>

      <footer>
        © {year} {dealerConfig.identity.name} · All vehicles subject to availability. Comparison is
        indicative only.
      </footer>
    </div>

    {canCompare && (
      <script type="application/json" id="vboard-data" is:inline set:html={JSON.stringify(cars)} />
    )}

    <!-- Continuity-journey beacon: record this comparison (fail-open, best-effort). -->
    {canCompare && (
      <script
        is:inline
        define:vars={{
          payload: {
            kind: 'compare',
            ref: ids.join(','),
            label: listings.map((l) => l.title).join(', '),
          },
        }}
      >
        (function () {
          try {
            var data = JSON.stringify(payload);
            var url = '/api/journey';
            var sent = false;
            if (navigator.sendBeacon) {
              sent = navigator.sendBeacon(url, new Blob([data], { type: 'application/json' }));
            }
            if (!sent) {
              fetch(url, {
                method: 'POST',
                body: data,
                headers: { 'Content-Type': 'application/json' },
                keepalive: true,
                credentials: 'same-origin',
              }).catch(function () {});
            }
          } catch (e) {
            /* fail-open — the beacon never affects the page */
          }
        })();
      </script>
    )}

    <!-- Floating AI chat assistant (Rebi) -->
    <ChatWidget />

    <style is:global>
      /* ==========================================================================
         The Verdict Board — dark, premium comparison surface. All rules are scoped
         under `.vboard` so nothing leaks to the rest of the (light) site. Brand
         blue is the real token rgb(1 97 239). Client-injected verdict reasons are
         styled here (hence is:global) rather than via Astro's scoped hash.
         ========================================================================== */
      .vboard {
        --bg: #070a11;
        --bg-2: #0b0f18;
        --panel: #10141d;
        --panel-2: #141a26;
        --panel-3: #1a2130;
        --line: rgba(146, 170, 222, 0.12);
        --line-2: rgba(146, 170, 222, 0.06);
        --ink: #eef2fa;
        --ink-mut: #8f99b0;
        --ink-dim: #59647a;
        --rebi: rgb(1 97 239);
        --rebi-2: #3b86ff;
        --rebi-soft: rgba(1, 97, 239, 0.16);
        --rebi-line: rgba(1, 97, 239, 0.48);
        --rebi-glow: rgba(1, 97, 239, 0.34);
        --gold: #f3b64b;
        --good: #37d39b;
        --good-soft: rgba(55, 211, 155, 0.13);
        --rail: 210px;
        --col: minmax(196px, 1fr);
        --r: 16px;
        --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
        color-scheme: dark;
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        color: var(--ink);
        font-size: 15px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        background:
          radial-gradient(1200px 540px at 82% -8%, rgba(1, 97, 239, 0.15), transparent 60%),
          radial-gradient(900px 480px at 6% 2%, rgba(1, 97, 239, 0.05), transparent 55%),
          var(--bg);
      }
      .vboard * { box-sizing: border-box; }
      .vboard .num { font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; }
      .vboard .mono { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 12.5px; letter-spacing: 0.02em; }
      .vboard .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
      .vboard .ic { width: 15px; height: 15px; }
      .vboard .ic-lg { width: 40px; height: 40px; }

      /* top bar */
      .vboard .topbar { display: flex; align-items: center; justify-content: space-between; padding: 22px 0 8px; }
      .vboard .brand { font-weight: 700; letter-spacing: -0.02em; font-size: 16px; text-decoration: none; color: var(--ink); }
      .vboard .brand span { color: var(--ink-dim); font-weight: 600; }
      .vboard .back { display: inline-flex; align-items: center; gap: 7px; color: var(--ink-mut); text-decoration: none; font-size: 13.5px; font-weight: 500; transition: color 0.2s var(--ease); }
      .vboard .back:hover { color: var(--ink); }

      /* masthead */
      .vboard .mast { padding: 22px 0 6px; }
      .vboard .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--rebi-2); }
      .vboard .eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--rebi); box-shadow: 0 0 10px var(--rebi-glow); }
      .vboard h1 { font-size: clamp(28px, 4.3vw, 44px); line-height: 1.03; letter-spacing: -0.03em; margin: 0.32em 0 0; font-weight: 800; text-wrap: balance; }
      .vboard h1 .mut { color: var(--ink-mut); font-weight: 800; }
      .vboard .lede { color: var(--ink-mut); font-size: 14.5px; margin: 12px 0 0; max-width: 64ch; }

      /* control bar */
      .vboard .controls { margin-top: 22px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--r); background: linear-gradient(180deg, var(--panel), var(--bg-2)); }
      .vboard .lens-label { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: var(--ink-mut); }
      .vboard .lens-label .ic { color: var(--rebi-2); }
      .vboard .lenses { display: flex; flex-wrap: wrap; gap: 6px; }
      .vboard .lens { appearance: none; font: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer; color: var(--ink-mut); background: var(--panel-2); border: 1px solid var(--line); padding: 7px 13px; border-radius: 999px; transition: 0.16s var(--ease); white-space: nowrap; }
      .vboard .lens:hover { color: var(--ink); border-color: var(--rebi-line); }
      .vboard .lens.active { color: #fff; background: var(--rebi-soft); border-color: var(--rebi-line); box-shadow: 0 0 0 1px var(--rebi-line) inset, 0 6px 18px -8px var(--rebi-glow); }
      .vboard .spacer { flex: 1 1 auto; }
      .vboard .toggle { display: inline-flex; align-items: center; gap: 9px; cursor: pointer; user-select: none; }
      .vboard .toggle input { position: absolute; opacity: 0; pointer-events: none; }
      .vboard .toggle .track { width: 38px; height: 22px; border-radius: 20px; background: rgba(146, 170, 222, 0.16); position: relative; transition: background 0.2s var(--ease); }
      .vboard .toggle .knob { position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #cdd6e8; transition: transform 0.22s var(--ease), background 0.2s; }
      .vboard .toggle input:checked + .track { background: var(--rebi); }
      .vboard .toggle input:checked + .track .knob { transform: translateX(16px); background: #fff; }
      .vboard .toggle .lbl { font-size: 12.5px; font-weight: 600; color: var(--ink); }
      /* Ask Rebi pill (from AskRebiButton) — tuned to sit on the dark bar */
      .vboard .ask { box-shadow: 0 8px 22px -8px var(--rebi-glow), inset 0 1px 0 rgba(255, 255, 255, 0.22); }

      /* board */
      .vboard .board { margin-top: 16px; border: 1px solid var(--line); border-radius: var(--r); background: linear-gradient(180deg, var(--panel), var(--bg-2)); overflow: hidden; }
      .vboard .scroller { overflow-x: auto; overflow-y: visible; scrollbar-width: thin; scrollbar-color: var(--rebi-line) transparent; }
      .vboard .scroller::-webkit-scrollbar { height: 9px; }
      .vboard .scroller::-webkit-scrollbar-thumb { background: var(--rebi-line); border-radius: 20px; }
      .vboard .grid { min-width: max-content; position: relative; }

      .vboard .beam { position: absolute; top: 0; bottom: 0; left: 0; width: 0; z-index: 0; pointer-events: none; opacity: 0; background: linear-gradient(180deg, rgba(1, 97, 239, 0.22), rgba(1, 97, 239, 0.05) 42%, rgba(1, 97, 239, 0.1)); box-shadow: inset 0 0 0 1px var(--rebi-line); transition: transform 0.5s var(--ease), width 0.5s var(--ease), opacity 0.35s var(--ease); }

      .vboard .row { display: grid; grid-template-columns: var(--rail) repeat(var(--n, 3), var(--col)); position: relative; z-index: 1; border-top: 1px solid var(--line-2); }
      .vboard .row:first-child { border-top: 0; }

      .vboard .rail { position: sticky; left: 0; z-index: 4; background: linear-gradient(90deg, var(--panel-2) 84%, rgba(20, 26, 38, 0)); padding: 13px 16px; display: flex; align-items: center; gap: 9px; border-right: 1px solid var(--line); color: var(--ink-mut); font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
      .vboard .rail .ic { color: var(--ink-dim); flex: none; }

      .vboard .cell { padding: 13px 18px; border-left: 1px solid var(--line-2); display: flex; flex-direction: column; justify-content: center; min-width: 0; transition: opacity 0.25s var(--ease); }

      /* header row */
      .vboard .hrow { position: sticky; top: 0; z-index: 5; }
      .vboard .verdict-corner { position: sticky; left: 0; z-index: 7; grid-column: 1; background: radial-gradient(130% 120% at 18% 0%, rgba(1, 97, 239, 0.2), transparent 60%), var(--panel-2); border-right: 1px solid var(--rebi-line); border-bottom: 1px solid var(--line); padding: 16px 15px; display: flex; flex-direction: column; gap: 11px; }
      .vboard .vc-top { display: flex; align-items: center; gap: 10px; }
      .vboard .rebi-orb { width: 34px; height: 34px; border-radius: 11px; flex: none; display: grid; place-items: center; background: radial-gradient(circle at 32% 26%, var(--rebi-2), var(--rebi) 72%); box-shadow: 0 6px 18px -4px var(--rebi-glow), inset 0 1px 0 rgba(255, 255, 255, 0.35); color: #fff; }
      .vboard .rebi-orb .ic { width: 18px; height: 18px; }
      .vboard .vc-kick { font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--rebi-2); }
      .vboard .vc-role { font-size: 11px; color: var(--ink-mut); margin-top: 1px; }
      .vboard .vc-pick { font-size: 18px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.12; color: var(--ink-mut); }
      .vboard .vc-pick em { font-style: normal; color: #fff; }
      .vboard .vc-score-row { display: flex; align-items: baseline; gap: 8px; }
      .vboard .vc-score { font-size: 26px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--gold); }
      .vboard .vc-score-lbl { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mut); }
      .vboard .vc-reasons { display: flex; flex-direction: column; gap: 6px; margin-top: 1px; }
      .vboard .vc-reason { display: flex; gap: 7px; align-items: flex-start; font-size: 12px; color: #c6cfe0; line-height: 1.4; }
      .vboard .vc-reason svg { width: 13px; height: 13px; flex: none; margin-top: 1px; color: var(--good); }
      .vboard .vc-reason.caveat svg { color: var(--gold); }
      .vboard .vc-lens-note { font-size: 11px; color: var(--ink-dim); margin-top: 1px; }
      .vboard .vc-lens-note b { color: var(--ink-mut); font-weight: 700; }

      /* car header lanes */
      .vboard .chead { position: relative; padding: 14px 15px 16px; border-left: 1px solid var(--line-2); border-bottom: 1px solid var(--line); background: var(--bg-2); transition: background 0.25s var(--ease); }
      .vboard .chead.pick { background: linear-gradient(180deg, rgba(1, 97, 239, 0.1), var(--bg-2)); }
      .vboard .photo { position: relative; aspect-ratio: 16/9; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: radial-gradient(120% 130% at 50% 8%, #1b2434, #0b0f18); }
      .vboard .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .vboard .photo-empty { position: absolute; inset: 0; display: grid; place-items: center; color: var(--ink-dim); }
      .vboard .remove { position: absolute; top: 8px; right: 8px; z-index: 3; width: 26px; height: 26px; border-radius: 8px; cursor: pointer; border: 1px solid var(--line); background: rgba(8, 11, 18, 0.62); backdrop-filter: blur(6px); color: var(--ink-mut); display: grid; place-items: center; transition: color 0.18s, background 0.18s, transform 0.18s var(--ease); }
      .vboard .remove:hover { color: #ff8f8f; background: rgba(60, 12, 12, 0.6); transform: rotate(90deg); }
      .vboard .remove .ic { width: 12px; height: 12px; }
      .vboard .ribbon { position: absolute; top: 8px; left: 8px; z-index: 3; display: inline-flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: #0c1220; background: linear-gradient(180deg, #ffd479, var(--gold)); padding: 4px 8px 4px 6px; border-radius: 8px; box-shadow: 0 5px 14px -4px rgba(243, 182, 75, 0.5); opacity: 0; transform: translateY(-4px) scale(0.92); transition: all 0.35s var(--ease); }
      .vboard .ribbon svg { width: 12px; height: 12px; }
      .vboard .chead.pick .ribbon { opacity: 1; transform: none; }
      .vboard .ctitle { margin: 12px 0 0; font-size: 15px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.22; }
      .vboard .ctitle a { color: var(--ink); text-decoration: none; }
      .vboard .ctitle a:hover { color: var(--rebi-2); }
      .vboard .cprice-row { display: flex; align-items: baseline; gap: 8px; margin-top: 10px; }
      .vboard .cprice { font-size: 21px; font-weight: 800; letter-spacing: -0.02em; }
      .vboard .tally { margin-top: 9px; display: flex; align-items: center; gap: 7px; font-size: 11px; color: var(--ink-mut); }
      .vboard .pips { display: inline-flex; gap: 4px; }
      .vboard .pip { width: 7px; height: 7px; border-radius: 50%; background: rgba(146, 170, 222, 0.2); }
      .vboard .pip.on { background: var(--good); box-shadow: 0 0 7px var(--good-soft); }

      /* section header rows */
      .vboard .section .rail { background: var(--panel-3); color: var(--ink); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; }
      .vboard .section .fill { grid-column: 2 / -1; background: var(--panel-3); border-bottom: 1px solid var(--line-2); }

      /* value cells */
      .vboard .val { font-size: 14.5px; color: var(--ink); font-weight: 500; }
      .vboard .cell.win .val { color: #c9f6e4; font-weight: 700; }
      .vboard .val.missing { color: var(--ink-dim); }
      .vboard .win-badge { display: inline-flex; align-items: center; gap: 5px; margin-top: 5px; font-size: 10px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: var(--good); }
      .vboard .win-badge svg { width: 12px; height: 12px; }
      .vboard .delta { display: inline-flex; align-items: center; gap: 5px; margin-top: 5px; font-size: 11px; font-weight: 700; color: var(--good); }
      .vboard .delta .vs { color: var(--ink-mut); font-weight: 600; }

      /* lens relevance */
      .vboard .row.relevant .rail { color: var(--rebi-2); box-shadow: inset 3px 0 0 var(--rebi); }
      .vboard .row.muted .cell { opacity: 0.5; }
      .vboard .row.muted .rail { opacity: 0.6; }

      /* differences-only */
      .vboard .board.diff .row.same { display: none; }
      .vboard .same-note { display: none; color: var(--ink-mut); font-size: 12.5px; padding: 12px 16px; border-top: 1px solid var(--line-2); }
      .vboard .board.diff .same-note { display: block; }
      .vboard .same-note b { color: var(--ink); font-weight: 600; }

      /* empty state */
      .vboard .empty { margin-top: 40px; border: 1px solid var(--line); border-radius: var(--r); background: linear-gradient(180deg, var(--panel), var(--bg-2)); padding: 64px 24px; text-align: center; }
      .vboard .empty-ic { display: flex; justify-content: center; color: var(--ink-dim); margin-bottom: 16px; }
      .vboard .empty h2 { font-size: 18px; font-weight: 700; color: var(--ink); }
      .vboard .empty p { margin-top: 6px; color: var(--ink-mut); font-size: 14px; }
      .vboard .empty-cta { margin-top: 24px; display: inline-flex; align-items: center; gap: 7px; border-radius: 12px; background: var(--rebi); padding: 12px 20px; font-weight: 700; color: #fff; text-decoration: none; transition: filter 0.2s var(--ease); }
      .vboard .empty-cta:hover { filter: brightness(1.08); }

      .vboard footer { color: var(--ink-dim); font-size: 12.5px; text-align: center; padding: 44px 0 40px; }

      /* entrance stagger */
      .vboard .anim { opacity: 0; transform: translateY(14px); }
      .vboard .anim.in { animation: vboard-up 0.55s var(--ease) forwards; }
      @keyframes vboard-up { to { opacity: 1; transform: none; } }

      @media (max-width: 820px) {
        .vboard { --rail: 148px; --col: 78vw; }
        .vboard .scroller { scroll-snap-type: x proximity; }
        .vboard .chead { scroll-snap-align: start; }
        .vboard .hrow { position: static; }
        .vboard .verdict-corner { padding: 14px 12px; }
        .vboard .vc-pick { font-size: 16px; }
        .vboard .spacer { flex-basis: 100%; height: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .vboard *,
        .vboard .beam { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
        .vboard .anim { opacity: 1; transform: none; }
      }
    </style>

    <script>
      import { buildVerdict, LENSES, type CompareCar, type DimKey } from '../lib/compare-verdict';

      const board = document.getElementById('board');
      const dataEl = document.getElementById('vboard-data');
      if (board && dataEl?.textContent) {
        const cars = JSON.parse(dataEl.textContent) as CompareCar[];
        const grid = board.querySelector('.grid') as HTMLElement | null;
        const beam = document.getElementById('beam');
        let currentIds = cars.map((c) => c.id);
        let lensId = 'balanced';

        const esc = (s: string) =>
          s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        const CHECK =
          '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.2l3 3 7-7"/></svg>';
        const BOLT =
          '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 1.5L3.5 9H8l-1 5.5L12.5 7H8z"/></svg>';

        const $ = (id: string) => document.getElementById(id);

        function renderVerdict(id: string) {
          const v = buildVerdict(cars, id);
          const lens = LENSES.find((l) => l.id === id) ?? LENSES[0];
          const pick = $('vc-pick');
          const role = $('vc-role');
          const scoreEl = $('vc-score');
          const weighEl = $('vc-weighing');
          const reasonsEl = $('vc-reasons');
          if (pick) pick.textContent = v.pickName;
          if (role) role.textContent = `for the ${lens.label.toLowerCase()} buyer`;
          if (scoreEl) scoreEl.textContent = String(v.score);
          if (weighEl) weighEl.textContent = v.weighing;
          if (reasonsEl) {
            reasonsEl.innerHTML = v.reasons
              .map(
                (r) =>
                  `<div class="vc-reason${r.caveat ? ' caveat' : ''}">${
                    r.caveat ? BOLT : CHECK
                  }<span>${esc(r.text)}</span></div>`,
              )
              .join('');
          }
          return v;
        }

        function moveBeam(pickId: string) {
          if (!beam || !grid) return;
          const cell = grid.querySelector(`.chead[data-car-id="${CSS.escape(pickId)}"]`) as HTMLElement | null;
          if (!cell) {
            beam.style.opacity = '0';
            return;
          }
          beam.style.width = `${cell.offsetWidth}px`;
          beam.style.transform = `translateX(${cell.offsetLeft}px)`;
          beam.style.opacity = '1';
        }

        function applyRelevance(id: string) {
          const lens = LENSES.find((l) => l.id === id) ?? LENSES[0];
          const w = lens.w as Partial<Record<DimKey, number>>;
          const balanced = id === 'balanced';
          grid?.querySelectorAll<HTMLElement>('.row.spec[data-dim]').forEach((row) => {
            const dim = row.dataset.dim as DimKey | undefined;
            const weighted = dim ? (w[dim] ?? 0) > 0 : false;
            row.classList.toggle('relevant', !balanced && weighted);
            row.classList.toggle('muted', !balanced && !weighted);
          });
        }

        function apply(id: string) {
          lensId = id;
          const v = renderVerdict(id);
          grid?.querySelectorAll<HTMLElement>('.chead').forEach((h) => {
            h.classList.toggle('pick', h.dataset.carId === v.pickId);
          });
          applyRelevance(id);
          moveBeam(v.pickId);
        }

        // Lens pills
        document.getElementById('lenses')?.querySelectorAll<HTMLButtonElement>('[data-lens]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.dataset.lens || 'balanced';
            document
              .getElementById('lenses')
              ?.querySelectorAll('.lens')
              .forEach((x) => x.classList.toggle('active', x === btn));
            apply(id);
          });
        });

        // Differences-only toggle
        const diff = document.getElementById('diffToggle') as HTMLInputElement | null;
        diff?.addEventListener('change', () => board.classList.toggle('diff', diff.checked));

        // Remove-from-compare (min-two guard) — reloads so the server recomputes
        // winners/deltas with the shared logic; also syncs the compare tray store.
        const COMPARE_KEY = 'astro-listings-compare';
        const META_KEY = 'astro-listings-compare-meta';
        function removeFromStore(id: string) {
          try {
            const raw = localStorage.getItem(COMPARE_KEY);
            const arr = raw ? (JSON.parse(raw) as string[]) : [];
            const next = Array.isArray(arr) ? arr.filter((x) => x !== id) : [];
            localStorage.setItem(COMPARE_KEY, JSON.stringify(next));
            const mraw = localStorage.getItem(META_KEY);
            const meta = mraw ? JSON.parse(mraw) : {};
            if (meta && typeof meta === 'object') {
              delete meta[id];
              localStorage.setItem(META_KEY, JSON.stringify(meta));
            }
          } catch {
            /* localStorage unavailable — no-op */
          }
        }
        function flashCorner() {
          const cp = grid?.querySelector('.verdict-corner') as HTMLElement | null;
          cp?.animate(
            [
              { boxShadow: 'inset 0 0 0 1px transparent' },
              { boxShadow: 'inset 0 0 0 2px #ff8f8f' },
              { boxShadow: 'inset 0 0 0 1px transparent' },
            ],
            { duration: 600 },
          );
        }
        grid?.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const id = btn.dataset.remove || '';
            const remaining = currentIds.filter((x) => x !== id);
            if (remaining.length < 2) {
              flashCorner();
              return;
            }
            removeFromStore(id);
            window.location.href = `/compare?ids=${remaining.map(encodeURIComponent).join(',')}`;
          });
        });

        // Keep the beam aligned when columns reflow.
        let rz: ReturnType<typeof setTimeout>;
        window.addEventListener('resize', () => {
          clearTimeout(rz);
          rz = setTimeout(() => {
            const v = buildVerdict(cars, lensId);
            moveBeam(v.pickId);
          }, 120);
        });

        // Entrance stagger
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) {
          grid?.querySelectorAll<HTMLElement>('.verdict-corner, .chead').forEach((el, i) => {
            el.classList.add('anim');
            el.style.animationDelay = `${i * 55}ms`;
            requestAnimationFrame(() => el.classList.add('in'));
          });
        }

        // Boot: position beam + verdict for the default lens.
        apply('balanced');
        requestAnimationFrame(() => moveBeam(buildVerdict(cars, 'balanced').pickId));
      }
    </script>
  </body>
</html>
