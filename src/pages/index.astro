---
// Home — the browse experience IS the front door. Typing the bare domain lands
// on the grid: intro + SearchDock island + facet sidebar + Filters drawer + the
// swappable `#inventory-results` region. This page owns the grid + filter
// contract; `/listings` is now a 301 that forwards its query string here so
// saved searches and Rebi deep-links keep resolving.
//
// SSR (not prerendered): it reads filter/pagination params from the URL and
// filters server-side, so it can't be baked at build time. The grid-swap /
// SearchDock / query-planner code path is preserved verbatim from the previous
// `/listings` page — byte-for-byte the same components and props.
export const prerender = false;

import '../styles/global.css';
import '../components/search/stage.css';
import { client } from '../sanity/lib/client';
import CompareTray from '../components/CompareTray.astro';
import ChatWidget from '../components/widgets/ChatWidget.astro';
import SearchDock from '../components/search/SearchDock.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import FilterDrawer from '../components/filters/FilterDrawer.astro';
import InventoryResults from '../components/filters/InventoryResults.astro';
import { dealerConfig } from '../config/dealer';
import { iconSvg } from '../lib/listing';
import {
  parseFilters,
  buildListingsQuery,
  activeChips,
  type InventoryResult,
} from '../lib/listings-query';
import { priceDropsFor } from '../lib/price-history-data';

// Edge caching (DECISION.md Decision 5): anonymous/unfiltered hits get served
// from Cloudflare's cache and feel static; each unique filter URL caches
// separately. Recovers most of the TTFB we'd otherwise lose by dropping
// prerender.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// URL is the single source of truth. Parse the filter state, then filter +
// paginate server-side via the shared query builder (reused by the partial).
const filterState = parseFilters(Astro.url.searchParams);
const { query, params } = buildListingsQuery(filterState);
const { items: listings, total } = await client.fetch<InventoryResult>(query, params);

// Resolve each card's honest price drop once (the STUB_PRICE_HISTORY demo flag is
// read inside priceDropsFor, at this data layer — never in the card). Request-time
// clock passed in (no module-level new Date()).
const priceDrops = priceDropsFor(listings, Date.now());

const activeCount = activeChips(filterState).length;

// Presentation-layer icon set (stroke, 24-grid) for the inline-contextual look —
// self-contained, no dealer data (mirrors the pattern in SiteNav.astro). The
// shared `iconSvg` (16-grid) is used only for the Filters-button glyph so it
// matches the drawer.
const icon = (name: string, size = 16): string => {
  const a = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"`;
  const p: Record<string, string> = {
    bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    spark: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" fill="currentColor" stroke="none"/>',
    filter: '<path d="M3 5h18l-7 8v6l-4-2v-4z"/>',
  };
  return `<svg ${a}>${p[name] ?? ''}</svg>`;
};

// Dealer name is config-as-data (never a literal in a page).
const title = `${dealerConfig.identity.name} — every car, one list`;
const description = `Browse the full range at ${dealerConfig.identity.name}. New, Demo and Used are filter facets, not separate pages — one list, sliced how you like, with Rebi on hand to refine.`;
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://rebirth-listings-auto.pages.dev',
).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="page-surface min-h-screen antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <!-- Reusable sticky glass nav (smart-hubs). "Ask Rebi" carries data-rebi-open. -->
    <SiteNav active="browse" />

    <main id="main-content" tabindex="-1">
      <!-- FULL-BLEED HERO — the front door. The photograph spans the viewport
           edge-to-edge (this section is a direct child of <main>, which is no
           longer the container; the inner .site-container keeps copy on the same
           gutter as every other surface). Copy is left-weighted so it never sits
           on the busiest part of the frame (the car is dead-centre); a two-axis
           scrim guarantees AA contrast over the photo. -->
      <section class="home-hero">
        <div class="home-hero-media" aria-hidden="true">
          <picture>
            <source type="image/webp" srcset="/images/home/hero3.webp" />
            <img
              src="/images/home/hero3.png"
              width="1307"
              height="656"
              alt=""
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>

        <div class="home-hero-inner site-container">
          <div class="home-hero-copy">
            <span class="eyebrow">
              <Fragment set:html={icon('spark', 15)} />
              Browse the yard
            </span>
            <h1 class="home-hero-title">
              Every car we have.<br />One list.
            </h1>
            <p class="home-hero-lead">
              New, Demo and Used are <b>filter facets</b> here — not separate pages. Slice
              the list how you like, or just tell Rebi what you're after.
            </p>

            <p class="home-hero-count mono">
              {activeCount === 0
                ? `${total} vehicles on the lot right now`
                : `${total} vehicles match your current filters`}
            </p>

            {/* Rebi-fronted plain-English search — the SAME SearchDock island,
                unmodified. On submit it POSTs /api/search, drives the ONE filter
                URL via applyFilterUrl, and swaps #inventory-results below. Only
                page-level scoped CSS below adapts it to sit on a photograph. */}
            <div class="home-hero-search">
              <SearchDock />
            </div>
          </div>
        </div>
      </section>

      <div class="site-container">
      <div class="grid grid-cols-1 gap-8 pt-10 pb-16 lg:grid-cols-[230px_minmax(0,1fr)] lg:items-start">
        <!-- FACET SIDEBAR — quick wayfinding via real filter URLs (SSR-navigate;
             the drawer + AI search do the in-place swaps). Plus an inline .entry
             jump to the EV hub, in context of the Fuel facet. -->
        <aside class="lg:sticky lg:top-[92px]">
          <div class="card p-5">
            <div class="site-foot-h" style="color:var(--ink-faint); margin-bottom:10px">Condition</div>
            <div class="mb-5 flex flex-wrap gap-2">
              <a class:list={['facet', { 'is-on': filterState.condition.length === 0 }]} href="/">All</a>
              <a class:list={['facet', { 'is-on': filterState.condition.includes('new') }]} href="/?condition=new">New</a>
              <a class:list={['facet', { 'is-on': filterState.condition.includes('demo') }]} href="/?condition=demo">Demo</a>
              <a class:list={['facet', { 'is-on': filterState.condition.includes('used') }]} href="/?condition=used">Used</a>
            </div>

            <div class="site-foot-h" style="color:var(--ink-faint); margin-bottom:10px">Fuel</div>
            <div class="mb-3 flex flex-wrap gap-2">
              <a class:list={['facet', { 'is-on': filterState.fuelType.includes('petrol') }]} href="/?fuelType=petrol">Petrol</a>
              <a class:list={['facet', { 'is-on': filterState.fuelType.includes('diesel') }]} href="/?fuelType=diesel">Diesel</a>
              <a class:list={['facet', { 'is-on': filterState.fuelType.includes('hybrid') }]} href="/?fuelType=hybrid">Hybrid</a>
              <a class:list={['facet', { 'is-on': filterState.fuelType.includes('electric') }]} href="/?fuelType=electric">Electric</a>
            </div>
            <!-- fuel facet surfaces the EV hub, in context (hub ships in a later wave) -->
            <a href="/electric" class="entry mb-5 w-full" style="box-shadow:none">
              <span class="entry-ic" set:html={icon('bolt', 16)}></span>
              <span class="entry-tx"><b>New to EVs?</b><span>Open the electric hub</span></span>
              <span class="entry-go" set:html={icon('arrow', 15)}></span>
            </a>

            <hr class="divider" style="margin:4px 0 16px" />
            <div class="site-foot-h" style="color:var(--ink-faint); margin-bottom:10px">Body</div>
            <div class="flex flex-wrap gap-2">
              {[['suv', 'SUV'], ['ute', 'Ute'], ['wagon', 'Wagon'], ['hatchback', 'Hatch'], ['van', 'Van']].map(([code, label]) => (
                <a class:list={['facet', { 'is-on': filterState.bodyType.includes(code) }]} href={`/?bodyType=${code}`}>{label}</a>
              ))}
            </div>
            <p class="faint mt-3 text-[11px]">Quick jumps. For price, year, odometer &amp; more, open <b>Filters</b>.</p>
          </div>
        </aside>

        <!-- RESULTS COLUMN -->
        <div>
          {/* Inventory heading + Filters button (the drawer's trigger, id="filters-trigger"). */}
          <div id="inventory" class="flex items-end justify-between border-b border-line pb-4">
            <div>
              <span class="eyebrow">Live inventory</span>
              <h2 id="inventory-heading" class="mt-2 text-2xl font-bold tracking-tight text-ink">
                Current inventory
              </h2>
            </div>
            <button type="button" id="filters-trigger" class="btn btn-ghost btn-sm">
              <Fragment set:html={iconSvg('filter', 'h-4 w-4')} />
              Filters
              <span
                data-filter-count
                hidden={activeCount === 0}
                class="inline-flex min-w-5 items-center justify-center rounded-full bg-ink px-1.5 py-0.5 text-xs font-semibold text-white"
              >
                {activeCount}
              </span>
            </button>
          </div>

          <!-- Filter drawer (persistent; lives outside the swappable results) -->
          <FilterDrawer state={filterState} triggerId="filters-trigger" />

          <!-- Swappable inventory results (chips + grid + pagination) -->
          <InventoryResults listings={listings} total={total} state={filterState} priceDrops={priceDrops} />
        </div>
      </div>

      {dealerConfig.capture.enabled && (
        <p class="mt-8 mb-4 text-center text-xs text-ink-faint">
          <a href="/capture" class="underline underline-offset-2 hover:text-ink-soft">Dealer: add a vehicle</a>
        </p>
      )}
      </div>
    </main>

    <!-- Reusable dark footer (full directory) -->
    <SiteFooter />

    <!-- Floating comparison tray (self-contained, appears when ≥1 selected) -->
    <CompareTray />

    <!-- Floating AI chat assistant (Rebi) — self-contained global overlay -->
    <ChatWidget />

    <!-- `?q=` handoff: any surface that routes a raw plain-English query here
         (an external link, a legacy `/listings?q=…` redirect, a search box on
         another page) gets fed into the SAME SearchDock flow (the island's own
         onSubmit → /api/search → applyFilterUrl → grid swap). This is page-level
         wiring only; the island's internals are untouched. No-JS degrades
         gracefully to the full SSR grid. -->
    <script is:inline>
      (function () {
        var q = new URL(window.location.href).searchParams.get('q');
        if (!q) return;
        var fired = false;
        function tryRun() {
          if (fired) return true;
          var form = document.getElementById('search-dock-form');
          var input = document.getElementById('search-dock-input');
          var dock = document.getElementById('search-dock');
          if (form && input && dock && !dock.hasAttribute('hidden')) {
            fired = true;
            input.value = q;
            if (typeof form.requestSubmit === 'function') form.requestSubmit();
            else form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
            return true;
          }
          return false;
        }
        if (tryRun()) return;
        var obs = new MutationObserver(function () {
          if (tryRun()) obs.disconnect();
        });
        obs.observe(document.body, { subtree: true, childList: true, attributes: true });
        setTimeout(function () { obs.disconnect(); }, 8000);
      })();
    </script>

    <!-- Page-level hero styling ONLY. Nothing here reaches into the SearchDock /
         FilterDrawer / InventoryResults contracts — the few :global() rules are
         cosmetic overrides scoped under `.home-hero-search`, so the island's own
         stylesheet, ids and behaviour are untouched. -->
    <style>
      /* ------------------------------------------------------------------
         FULL-BLEED HERO
         `<main>` is no longer the container — this section spans the viewport
         and the inner `.site-container` re-applies the ONE shared gutter
         (--site-gutter / --site-max in global.css). No 100vw/negative-margin
         tricks, so no horizontal-overflow or sticky-nav side effects.
         ------------------------------------------------------------------ */
      .home-hero {
        position: relative;
        isolation: isolate;
        display: flex;
        align-items: center;
        /* A contained band, never a 100vh splash — this is a browse-first page,
           so the inventory grid stays near the fold. The `24vw` term only bites
           past ~2100px, where a pure vh band would crop the photo to a sliver. */
        min-height: 92vh;
        min-height: 92dvh;
        overflow: hidden;
        background: #060B14; /* fallback until the photo paints */
        /* Cinematic collapse when the dock goes active (see :has() rule below). */
        transition: min-height 620ms cubic-bezier(0.22, 0.61, 0.30, 1);
      }

      .home-hero-media {
        position: absolute;
        inset: 0;
        z-index: -2;
        /* Scale + blur are driven by the active state; keep the transform on the
           WRAPPER so it never collides with the img's own hero-drift keyframes. */
        transform-origin: 50% 50%;
        transition:
          filter 620ms cubic-bezier(0.22, 0.61, 0.30, 1),
          transform 620ms cubic-bezier(0.22, 0.61, 0.30, 1);
      }
      .home-hero-media picture,
      .home-hero-media img {
        display: block;
        width: 100%;
        height: 100%;
      }
      .home-hero-media img {
        object-fit: cover;
        /* The car sits centre-frame; bias the crop DOWN so the nose + bumper
           stay in shot on a wide, short band instead of being clipped. */
        object-position: 50% 50%;
        animation: hero-drift 9s cubic-bezier(0.16, 0.8, 0.24, 1) both;
      }

      /* Two-axis scrim. The horizontal pass is weighted hard to the left so the
         copy column never fights the (bright red, dead-centre) car; the vertical
         pass darkens the bottom where the composer sits and keeps the top edge
         from clashing with the light glass nav. */
      .home-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
          180deg,
          rgba(6, 11, 20, 0.55) 0%,
          rgba(6, 11, 20, 0.30) 22%,
          rgba(6, 11, 20, 0.34) 50%,
          rgba(6, 11, 20, 0.52) 78%,
          rgba(6, 11, 20, 0.72) 100%
        );
      }

      /* Aurora hairline: crisp band edge into the page mist below. */
      .home-hero::after {
        content: '';
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        height: 3px;
        background: var(--aurora);
      }

      .home-hero-inner {
        position: relative;
        padding-block: clamp(2.25rem, 5.5vh, 4rem);
      }
      .home-hero-copy {
        max-width: 44rem;
        margin-inline: auto;
        text-align: center;
      }

      /* Lift the teal toward white: the shipped --teal-deep fails AA on a dark
         photo, and on mobile this line can land on the (bright) red bonnet. */
      .home-hero .eyebrow {
        color: var(--teal);
        color: color-mix(in srgb, var(--teal) 58%, #fff);
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.65);
      }

      .home-hero-title {
        margin: 16px 0 0;
        font-family: var(--font-display);
        font-size: clamp(2.05rem, 5.1vw, 3.5rem);
        font-weight: 800;
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: #fff;
        text-shadow: 0 2px 26px rgba(0, 0, 0, 0.5);
      }

      .home-hero-lead {
        margin: 14px 0 0;
        max-width: 34rem;
        margin-inline: auto;
        font-size: clamp(15.5px, 1.15vw, 18px);
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.84);
        text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
      }
      .home-hero-lead b {
        color: #fff;
        font-weight: 650;
      }

      .home-hero-count {
        margin: 18px 0 0;
        font-size: 11.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.72);
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
      }

      /* Prose collapse targets — transition set on the base so the active-state
         clear (opacity + height/margin to 0) animates. `overflow:hidden` is NOT
         set here so the idle text-shadows never clip; it is added only in the
         active rule, while the copy is fading out anyway. */
      .home-hero .eyebrow,
      .home-hero-title,
      .home-hero-lead,
      .home-hero-count {
        transition:
          opacity 340ms ease,
          transform 340ms cubic-bezier(0.22, 0.61, 0.30, 1),
          max-height 620ms cubic-bezier(0.22, 0.61, 0.30, 1),
          margin 620ms cubic-bezier(0.22, 0.61, 0.30, 1);
        max-height: 12rem;
      }

      /* ---- the AI search bar, on the photograph ------------------------
         The dock renders a composer + hint only (its old carousel "stage"
         chrome was retired upstream), so the whole island sits happily in
         the hero. These overrides just make the glass read as solid enough
         over a photo and left-align it with the copy column. */
      .home-hero-search {
        margin-top: 22px;
      }
      .home-hero-search :global(.search-dock) {
        width: 70vw;
        max-width: 70vw;
        margin-left: 50%;
        transform: translateX(-50%);
      }
      .home-hero-search :global(.search-dock .entry) {
        margin-top: 0;
        padding: 1.05rem 1.05rem 1.05rem 1.7rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.97);
        border: 1px solid rgba(1, 97, 239, 0.22);
        border-bottom: 2px solid rgba(1, 97, 239, 0.55);
        box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.85);
        /* padding/shadow morph on activate — the transform delta is the JS FLIP;
           these two properties give the morph a real docked-composer feel. */
        transition:
          padding 460ms cubic-bezier(0.22, 0.61, 0.30, 1),
          box-shadow 460ms cubic-bezier(0.22, 0.61, 0.30, 1);
      }
      .home-hero-search :global(.search-dock .entry:focus-within) {
        background: #fff;
      }
      .home-hero-search :global(.search-dock .search-dock-input) {
        font-size: 1.18rem;
        padding: 0.5rem 0;
      }
      .home-hero-search :global(.search-dock .search-dock-submit) {
        font-size: 1rem;
        padding: 0.72rem 1.4rem;
      }
      .home-hero-search :global(.search-dock .entry .mag svg) {
        width: 1.4rem;
        height: 1.4rem;
      }
      .home-hero-search :global(.search-dock .hint) {
        text-align: center;
        color: rgba(255, 255, 255, 0.78);
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
      }
      .home-hero-search :global(.search-dock-manual) {
        color: #8ED4FF;
      }

      /* ==================================================================
         CINEMATIC ACTIVE STATE
         The island adds `is-active` to `.search-dock` on submit. Everything
         here is rooted at `.home-hero` / `.search-dock` — the nav and the
         `#inventory-results` region below are NEVER touched.
         ================================================================== */

      /* ---- the stage viewport (idle: collapsed + clipped) --------------
         `.search-dock` is `transform: translateX(-50%)` — a transformed
         ancestor — so the stage MUST own its own positioning context, which
         the active rule below establishes (`position: relative`). Idle it is a
         0-height clipped box: the absolutely-positioned `.turn` cards inside
         stay clipped, so nothing leaks before the first search. */
      .home-hero-search :global(.search-dock .focus-stage) {
        height: 0;
        overflow: hidden;
        transition: height 560ms cubic-bezier(0.22, 0.61, 0.30, 1);
      }
      /* Active: real height + the 3D depth model the receding cards animate in.
         `overflow: visible` lets the receding cards fade ABOVE the box instead
         of being hard-clipped at the top edge. */
      .home-hero-search :global(.search-dock.is-active .focus-stage) {
        position: relative;
        height: clamp(300px, 42vh, 440px);
        overflow: visible;
        perspective: 1200px;
        transform-style: preserve-3d;
      }

      /* ---- hero reactions, driven off the dock's active state ---------- */
      /* Background BLUR ONLY (no greyscale / no desaturate). The small scale on
         the WRAPPER keeps the blur's soft edge off-screen; the img keeps its own
         hero-drift transform, uncollided. */
      .home-hero:has(.search-dock.is-active) .home-hero-media {
        filter: blur(14px);
        transform: scale(1.06);
      }

      /* Collapse the band to a compact frame — the top of `#inventory` below
         rises toward the fold (the "the AI did something" reveal). */
      .home-hero:has(.search-dock.is-active) {
        min-height: clamp(430px, 62vh, 580px);
      }

      /* Clear the prose — fade AND leave layout so the collapse genuinely
         shrinks. `.home-hero-search` is intentionally NOT in this list. */
      .home-hero:has(.search-dock.is-active) .eyebrow,
      .home-hero:has(.search-dock.is-active) .home-hero-title,
      .home-hero:has(.search-dock.is-active) .home-hero-lead,
      .home-hero:has(.search-dock.is-active) .home-hero-count {
        opacity: 0;
        max-height: 0;
        margin-top: 0;
        margin-bottom: 0;
        overflow: hidden;
        transform: translateY(-6px);
        pointer-events: none;
      }

      /* ---- docked composer + hint ------------------------------------- */
      /* Slightly tighter padding + softer shadow so the FLIP morph has a real,
         pleasing delta. Pill radius is preserved. */
      .home-hero-search :global(.search-dock.is-active .entry) {
        padding: 0.85rem 0.85rem 0.85rem 1.5rem;
        box-shadow: 0 16px 34px -22px rgba(0, 0, 0, 0.7);
      }
      /* Hide the hint over the stage — it reads as clutter once active. */
      .home-hero-search :global(.search-dock.is-active .hint) {
        opacity: 0;
        pointer-events: none;
      }
      .home-hero-search :global(.search-dock .hint) {
        transition: opacity 300ms ease;
      }

      /* ---- reduced motion: every hero-layer change is INSTANT ---------- */
      @media (prefers-reduced-motion: reduce) {
        .home-hero,
        .home-hero-media,
        .home-hero .eyebrow,
        .home-hero-title,
        .home-hero-lead,
        .home-hero-count,
        .home-hero-search :global(.search-dock .focus-stage),
        .home-hero-search :global(.search-dock .entry),
        .home-hero-search :global(.search-dock .hint) {
          transition: none;
        }
      }

      /* ---- motion ------------------------------------------------------ */
      @keyframes hero-drift {
        from { transform: scale(1.07); }
        to   { transform: scale(1); }
      }
      @keyframes hero-rise {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: none; }
      }
      .home-hero-copy > * {
        animation: hero-rise 0.65s cubic-bezier(0.2, 0.7, 0.3, 1) both;
      }
      .home-hero-copy > *:nth-child(2) { animation-delay: 0.06s; }
      .home-hero-copy > *:nth-child(3) { animation-delay: 0.12s; }
      .home-hero-copy > *:nth-child(4) { animation-delay: 0.18s; }
      .home-hero-copy > *:nth-child(5) { animation-delay: 0.24s; }

      /* ---- narrow viewports -------------------------------------------
         The band crops horizontally on a phone, so the car fills the frame;
         swap to a purely vertical scrim and let the copy sit on the dark
         lower third rather than trying to dodge the subject sideways. */
      @media (max-width: 767px) {
        .home-hero {
          min-height: clamp(500px, 64vh, 640px);
        }
        .home-hero::before {
          background: linear-gradient(
            180deg,
            rgba(6, 11, 20, 0.5) 0%,
            rgba(6, 11, 20, 0.14) 20%,
            rgba(6, 11, 20, 0.45) 42%,
            rgba(6, 11, 20, 0.92) 62%,
            rgba(6, 11, 20, 1) 70%,
            rgba(6, 11, 20, 1) 100%
          );
        }
        .home-hero-media {
          inset: 0;
          height: 100%;
        }
        .home-hero-media img {
          object-position: 50% 45%;
        }
        .home-hero-search :global(.search-dock) {
          width: 100%;
          max-width: 100%;
          margin-left: 0;
          transform: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .home-hero-media img,
        .home-hero-copy > * {
          animation: none;
        }
      }
    </style>
  </body>
</html>
