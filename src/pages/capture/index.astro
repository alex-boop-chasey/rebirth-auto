---
/**
 * Dealer listing-creation PWA — the /capture surface.
 *
 * A STANDALONE, mobile-first, installable surface (its OWN manifest + a service
 * worker SCOPED to /capture) — deliberately NOT built on the shopper `Layout`, so
 * nothing here (least of all the service worker) can bleed onto the main site.
 *
 * SSR-guarded by `dealerConfig.capture.enabled` (DEFAULT OFF): when off this
 * redirects home, matching the /api/capture/* endpoints that 404 while off.
 *
 * The flow (capture → assemble → review → create draft) is driven client-side by
 * a self-contained inline script that talks to /api/capture/*. Voice uses the Web
 * Speech API (feature-detected; the upgrade point to Whisper/Deepgram is marked).
 * The "Create draft" button ends at the STUB writer — no real Sanity write.
 */
import { dealerConfig } from '~/config/dealer';

export const prerender = false;

// DEFAULT OFF — a separate, opt-in dealer surface. Redirect home while disabled.
if (!dealerConfig.capture.enabled) {
  return Astro.redirect('/');
}

const cfg = dealerConfig.capture;
const { copy } = cfg;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F5F8FC" />
    <link rel="manifest" href="/capture/manifest.webmanifest" />
    <link rel="icon" href="/capture/icon.svg" type="image/svg+xml" />
    <title>{copy.appName} — {copy.heading}</title>
    <style>
      /* -----------------------------------------------------------------------
         Near-Future Yard (NFY) light skin — standalone dealer Capture PWA.
         This surface is deliberately self-contained (its own <html> + inline
         styles, no shopper Layout) so nothing bleeds onto the main site. The
         token values below MIRROR src/styles/theme.css (the Wave-0 NFY tokens)
         exactly, kept local to preserve that isolation. Reskin only — every id /
         data-attribute / class the inline script reads is unchanged.
         -------------------------------------------------------------------- */
      :root {
        color-scheme: light;
        --bg:        #F5F8FC;
        --bg-2:      #EBF1F8;
        --surface:   #FFFFFF;
        --ink:       #0D1626;
        --ink-soft:  #47566B;
        --ink-faint: #8494A8;
        --line:      rgba(13, 22, 38, 0.09);
        --line-2:    rgba(13, 22, 38, 0.05);
        --teal:       #0FB5A6;
        --teal-deep:  #0A867B;
        --indigo:     #5566F0;
        --indigo-deep:#3A46C8;
        --amber:      #E0813B;
        --amber-soft: #FBEBDD;
        --mint-glow:   rgba(15, 181, 166, 0.14);
        --indigo-glow: rgba(85, 102, 240, 0.14);
        --aurora:     linear-gradient(115deg, #0FB5A6 0%, #2E86E4 48%, #5566F0 100%);
        --sh-1: 0 1px 2px rgba(13, 22, 38, 0.05), 0 2px 8px rgba(13, 22, 38, 0.04);
        --sh-2: 0 6px 22px rgba(13, 22, 38, 0.09), 0 2px 6px rgba(13, 22, 38, 0.05);
        --sh-glow: 0 10px 40px -12px rgba(15, 181, 166, 0.45);
        --r-sm: 10px;
        --r:    16px;
        --r-lg: 22px;
        --r-pill: 999px;
        --font-ui: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, "Noto Sans", sans-serif;
        --font-mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas,
          "Liberation Mono", monospace;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--font-ui);
        background: var(--bg);
        background-image:
          radial-gradient(60rem 40rem at 82% -8%, var(--mint-glow), transparent 60%),
          radial-gradient(50rem 40rem at -6% 8%, var(--indigo-glow), transparent 55%);
        background-attachment: fixed;
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
      }
      main { max-width: 640px; margin: 0 auto; padding: 24px 16px 72px; }

      /* app header — keeps this recognisable as the standalone Capture tool */
      .app-head { display: flex; align-items: center; gap: 12px; margin: 4px 0 18px; }
      .orb {
        position: relative; width: 34px; height: 34px; border-radius: 50%; flex: none;
        background: var(--aurora); background-size: 180% 180%;
        animation: aurora-shift 6s ease infinite;
        box-shadow: 0 6px 18px -4px rgba(85, 102, 240, 0.55),
          inset 0 0 0 1px rgba(255, 255, 255, 0.35);
      }
      .orb::after {
        content: ""; position: absolute; inset: 22%; border-radius: 50%;
        background: rgba(255, 255, 255, 0.9); filter: blur(1px);
        animation: orb-pulse 2.6s ease-in-out infinite;
      }
      .app-name {
        font-family: var(--font-mono); font-size: 11px; font-weight: 500;
        letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-faint);
      }
      .eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--font-mono); font-size: 11.5px; font-weight: 500;
        letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal-deep);
        margin: 0 0 10px;
      }
      .eyebrow::before {
        content: ""; width: 22px; height: 1.5px; background: var(--teal);
        display: inline-block;
      }

      h1 { font-size: 1.55rem; line-height: 1.15; letter-spacing: -0.01em; margin: 0 0 8px; }
      .sub { color: var(--ink-soft); font-size: 0.94rem; margin: 0 0 24px; max-width: 52ch; }

      section {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.62));
        backdrop-filter: blur(16px) saturate(1.2);
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: var(--r-lg);
        box-shadow: var(--sh-2);
        padding: 20px;
        margin-bottom: 16px;
      }
      section h2 {
        font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase;
        letter-spacing: 0.12em; color: var(--teal-deep); margin: 0 0 14px;
      }
      label { display: block; font-size: 0.82rem; font-weight: 500; color: var(--ink-soft); margin: 0 0 6px; }
      input[type=text], input[type=number], textarea, select {
        width: 100%; padding: 11px 13px; font-size: 1rem; font-family: var(--font-ui);
        color: var(--ink); background: var(--surface);
        border: 1px solid var(--line); border-radius: var(--r-sm);
        transition: border-color 0.16s ease, box-shadow 0.16s ease;
      }
      input[type=text]:focus, input[type=number]:focus, textarea:focus, select:focus {
        outline: 0; border-color: var(--teal);
        box-shadow: 0 0 0 3px var(--mint-glow);
      }
      input::placeholder, textarea::placeholder { color: var(--ink-faint); }
      input[type=file] {
        width: 100%; font-size: 0.9rem; color: var(--ink-soft);
        padding: 10px 0;
      }
      input[type=file]::file-selector-button {
        font: inherit; font-weight: 600; cursor: pointer; margin-right: 12px;
        padding: 9px 15px; border-radius: var(--r-pill);
        border: 1px solid var(--line); background: rgba(255, 255, 255, 0.7);
        color: var(--ink); transition: border-color 0.16s, color 0.16s;
      }
      input[type=file]::file-selector-button:hover { border-color: var(--teal); color: var(--teal-deep); }
      textarea { min-height: 88px; resize: vertical; }
      .row { display: flex; gap: 10px; }
      .row > * { flex: 1; }
      button {
        font: inherit; font-weight: 600; font-size: 15px; cursor: pointer;
        border: 1px solid transparent; border-radius: var(--r-pill);
        padding: 13px 18px; width: 100%; color: #fff;
        background: var(--aurora); background-size: 160% 160%;
        box-shadow: var(--sh-glow);
        transition: transform 0.18s ease, box-shadow 0.22s ease;
      }
      button:hover { transform: translateY(-2px); }
      button:active { transform: translateY(0); }
      button.secondary {
        background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px);
        border-color: var(--line); color: var(--ink); box-shadow: none;
      }
      button.secondary:hover { border-color: var(--teal); color: var(--teal-deep); }
      button:disabled { opacity: 0.5; cursor: default; transform: none; }
      .hint { font-size: 0.78rem; color: var(--ink-faint); margin: 8px 0 0; }
      .field { padding: 12px 0; border-bottom: 1px solid var(--line-2); }
      .field:last-child { border-bottom: 0; }
      .field-head { display: flex; align-items: center; gap: 6px; margin: 0 0 7px; }
      .field-name { font-size: 0.82rem; font-weight: 500; color: var(--ink-soft); flex: 1; }
      .badge { font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 3px 9px; border-radius: var(--r-pill); font-weight: 700; border: 1px solid transparent; }
      .src { background: var(--bg-2); color: var(--ink-soft); border-color: var(--line-2); }
      .conf-high { background: var(--mint-glow); color: var(--teal-deep); border-color: rgba(15, 181, 166, 0.22); }
      .conf-medium { background: var(--amber-soft); color: #B4611F; border-color: rgba(224, 129, 59, 0.25); }
      .conf-low { background: #FCE7EC; color: #C43254; border-color: rgba(196, 50, 84, 0.22); }
      .field.review { background: #FDF1F4; border-left: 3px solid #E86A87; padding-left: 12px; border-radius: 8px; }
      .prompt {
        background: linear-gradient(180deg, rgba(85, 102, 240, 0.06), rgba(15, 181, 166, 0.05));
        border: 1px solid rgba(85, 102, 240, 0.2); border-radius: var(--r-sm);
        padding: 14px; margin-bottom: 14px;
      }
      .prompt p { margin: 0 0 10px; font-size: 0.86rem; color: var(--indigo-deep); }
      .issues { list-style: none; padding: 0; margin: 8px 0 0; }
      .issues li { font-size: 0.82rem; padding: 8px 11px; border-radius: var(--r-sm); margin-bottom: 6px; border: 1px solid transparent; }
      .issue-error { background: #FCE7EC; color: #C43254; border-color: rgba(196, 50, 84, 0.2); }
      .issue-warning { background: var(--amber-soft); color: #B4611F; border-color: rgba(224, 129, 59, 0.25); }
      .ok { background: var(--mint-glow); color: var(--teal-deep); padding: 13px; border-radius: var(--r-sm); font-size: 0.9rem; border: 1px solid rgba(15, 181, 166, 0.22); }
      .demo-note { font-size: 0.72rem; color: var(--ink-faint); margin-top: 12px; line-height: 1.5; }
      [hidden] { display: none !important; }

      @keyframes aurora-shift {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      @keyframes orb-pulse {
        0%, 100% { transform: scale(0.7); opacity: 0.85; }
        50%      { transform: scale(1);   opacity: 1; }
      }
      @media (prefers-reduced-motion: reduce) {
        .orb, .orb::after { animation: none; }
        button:hover { transform: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="app-head">
        <span class="orb" aria-hidden="true"></span>
        <span class="app-name">{copy.appName}</span>
      </div>
      <p class="eyebrow">Add a vehicle</p>
      <h1>{copy.heading}</h1>
      <p class="sub">{copy.subheading}</p>

      <!-- STEP 1: capture inputs -->
      <div id="capture-step">
        <section>
          <h2>VIN / rego</h2>
          <label for="vin">Enter a VIN (17 chars) or registration</label>
          <div class="row">
            <input type="text" id="vin" placeholder="e.g. JTMRWRFVXND123456 or 123ABC" autocomplete="off" />
            <button type="button" id="lookup-btn" class="secondary" style="flex:0 0 auto;width:auto;">{copy.lookupLabel}</button>
          </div>
          <p class="hint" id="lookup-status"></p>
        </section>

        <section>
          <h2>Photos</h2>
          <label for="photos">Add photos of the car (used for colour, body &amp; condition)</label>
          <input type="file" id="photos" accept="image/*" multiple capture="environment" />
          <p class="hint" id="photos-status">No photos added.</p>
        </section>

        <section>
          <h2>Voice note</h2>
          <p class="hint" id="voice-support"></p>
          <div class="row" style="margin-bottom:8px;">
            <button type="button" id="voice-btn" class="secondary" hidden>Start voice note</button>
          </div>
          <label for="transcript">Notes (odometer, price, condition, owner history, marks)</label>
          <textarea id="transcript" placeholder="e.g. One owner, full service history, 142,000 km, asking $25,000, used, tow bar."></textarea>
        </section>

        <button type="button" id="assemble-btn">{copy.assembleLabel}</button>
        <p class="hint" id="assemble-status"></p>
      </div>

      <!-- STEP 2: review -->
      <div id="review-step" hidden>
        <div class="prompt" id="ref-prompt" hidden>
          <p id="ref-prompt-text">{copy.createNewReferencePrompt}</p>
          <div class="row">
            <button type="button" id="ref-create-new" class="secondary">Create as new</button>
          </div>
        </div>

        <section>
          <h2>Review draft</h2>
          <div class="field">
            <div class="field-head"><span class="field-name">Title</span></div>
            <input type="text" id="f-title" />
          </div>
          <div id="fields"></div>
          <div class="field">
            <div class="field-head"><span class="field-name">Dealer notes (for AI, never shown to buyers)</span></div>
            <textarea id="f-dealerNotes"></textarea>
          </div>
        </section>

        <section id="validation-section" hidden>
          <h2>Validation</h2>
          <ul class="issues" id="issues"></ul>
        </section>

        <button type="button" id="create-btn">{copy.createDraftLabel}</button>
        <div id="create-result" hidden></div>
        <p class="demo-note">
          Demo scaffold: every external (VIN decode, photo vision, voice transcription) is stubbed,
          and "Create draft" ends at a stubbed writer — no listing is written to Sanity.
        </p>
        <div class="row" style="margin-top:12px;">
          <button type="button" id="back-btn" class="secondary">Start over</button>
        </div>
      </div>
    </main>

    <div id="voice-copy" data-voice-unsupported={copy.voiceUnsupported} hidden></div>

    <script is:inline>
      // Register the service worker SCOPED to /capture only — it lives at
      // /capture/sw.js (max scope /capture/) and is registered with an explicit
      // scope, so it can never control the shopper site at /.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker
            .register('/capture/sw.js', { scope: '/capture/' })
            .catch(function (err) { console.warn('[capture] SW registration failed', err); });
        });
      }

      (function () {
        var VS_KEYS = ['bodyType', 'transmission', 'fuelType', 'driveType', 'seatCount', 'year', 'odometer', 'condition'];
        var NUM_KEYS = { doors: 1, price: 1, seatCount: 1, year: 1, odometer: 1 };
        var photoRefs = [];

        function $(id) { return document.getElementById(id); }
        function setStatus(id, msg) { $(id).textContent = msg || ''; }

        // --- VIN/rego lookup ---
        $('lookup-btn').addEventListener('click', function () {
          var v = $('vin').value.trim();
          if (!v) { setStatus('lookup-status', 'Enter a VIN or rego first.'); return; }
          setStatus('lookup-status', 'Looking up…');
          fetch('/api/capture/lookup', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ vinOrRego: v }),
          }).then(function (r) { return r.json(); }).then(function (data) {
            if (data.error) { setStatus('lookup-status', data.error); return; }
            if (!data.oemSpec) { setStatus('lookup-status', 'No factory match — the photo & notes will fill the draft.'); return; }
            var s = data.oemSpec;
            var label = [s.year, s.make, s.model, s.badge].filter(Boolean).join(' ');
            var flags = (s.status && (s.status.writtenOff || s.status.stolen)) ? ' ⚠ status flag!' : '';
            setStatus('lookup-status', 'Found: ' + label + ' (stub decode)' + flags);
          }).catch(function () { setStatus('lookup-status', 'Lookup failed — try again.'); });
        });

        // --- Photos → opaque deterministic refs (no upload; vision is stubbed) ---
        $('photos').addEventListener('change', function (e) {
          var files = e.target.files || [];
          photoRefs = [];
          for (var i = 0; i < files.length; i++) {
            photoRefs.push('photo:' + files[i].name + ':' + files[i].size);
          }
          setStatus('photos-status', photoRefs.length ? (photoRefs.length + ' photo(s) added.') : 'No photos added.');
        });

        // --- Voice via Web Speech API (feature-detected) ---
        // UPGRADE POINT: swap this browser Web Speech capture for a Whisper/Deepgram
        // transcription upload (see TODO_KEYS.md — voice transcription).
        var SR = window['SpeechRecognition'] || window['webkitSpeechRecognition'];
        if (SR) {
          setStatus('voice-support', 'Tap to dictate — your words fill the notes below.');
          var btn = $('voice-btn'); btn.hidden = false;
          var rec = new SR(); rec.continuous = true; rec.interimResults = false; rec.lang = 'en-AU';
          var listening = false;
          rec.onresult = function (ev) {
            var t = '';
            for (var i = ev.resultIndex; i < ev.results.length; i++) t += ev.results[i][0].transcript;
            var ta = $('transcript'); ta.value = (ta.value ? ta.value + ' ' : '') + t.trim();
          };
          rec.onend = function () { listening = false; btn.textContent = 'Start voice note'; };
          btn.addEventListener('click', function () {
            if (listening) { rec.stop(); return; }
            try { rec.start(); listening = true; btn.textContent = 'Stop (listening…)'; }
            catch (e2) { listening = false; }
          });
        } else {
          var vc = $('voice-copy');
          setStatus('voice-support', (vc && vc.dataset.voiceUnsupported) || 'Voice capture is not supported in this browser — type your notes below.');
        }

        // --- Assemble ---
        $('assemble-btn').addEventListener('click', function () {
          setStatus('assemble-status', 'Assembling…');
          fetch('/api/capture/extract', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              vinOrRego: $('vin').value.trim(),
              imageRefs: photoRefs,
              transcript: $('transcript').value,
            }),
          }).then(function (r) { return r.json(); }).then(function (data) {
            if (data.error) { setStatus('assemble-status', data.error); return; }
            renderReview(data);
            $('capture-step').hidden = true;
            $('review-step').hidden = false;
            window.scrollTo(0, 0);
          }).catch(function () { setStatus('assemble-status', 'Assembly failed — try again.'); });
        });

        function badge(cls, text) {
          var s = document.createElement('span'); s.className = 'badge ' + cls; s.textContent = text; return s;
        }

        function renderReview(data) {
          var candidate = data.candidate;
          var fields = candidate.fields || {};
          $('f-title').value = candidate.title ? candidate.title.value : '';
          $('f-dealerNotes').value = candidate.dealerNotes ? candidate.dealerNotes.value : '';

          // Make/model "create new?" prompt (resolve-never-invent).
          var ref = candidate.reference || {};
          $('ref-prompt').hidden = !ref.promptCreateNew;

          var wrap = $('fields'); wrap.innerHTML = '';
          Object.keys(fields).forEach(function (key) {
            var f = fields[key];
            var div = document.createElement('div');
            div.className = 'field' + (f.needsReview ? ' review' : '');
            var head = document.createElement('div'); head.className = 'field-head';
            var name = document.createElement('span'); name.className = 'field-name'; name.textContent = key;
            head.appendChild(name);
            head.appendChild(badge('src', f.source));
            head.appendChild(badge('conf-' + f.confidence, f.confidence));
            div.appendChild(head);
            var input = document.createElement('input');
            input.type = NUM_KEYS[key] ? 'number' : 'text';
            input.value = f.value;
            input.dataset.key = key;
            div.appendChild(input);
            wrap.appendChild(div);
          });

          renderValidation(data.validation);
        }

        function renderValidation(validation) {
          var sec = $('validation-section'); var ul = $('issues'); ul.innerHTML = '';
          if (!validation || !validation.issues || !validation.issues.length) { sec.hidden = true; return; }
          sec.hidden = false;
          validation.issues.forEach(function (iss) {
            var li = document.createElement('li');
            li.className = 'issue-' + iss.severity;
            li.textContent = '[' + iss.severity + '] ' + iss.field + ': ' + iss.message;
            ul.appendChild(li);
          });
        }

        $('ref-create-new').addEventListener('click', function () {
          $('ref-prompt').hidden = true; // dealer accepts creating a new make/model
        });

        function gatherDraft() {
          var draft = { vehicleSpecs: {} };
          draft.title = $('f-title').value.trim();
          draft.dealerNotes = $('f-dealerNotes').value.trim();
          var inputs = $('fields').querySelectorAll('input[data-key]');
          for (var i = 0; i < inputs.length; i++) {
            var key = inputs[i].dataset.key;
            var val = inputs[i].value;
            if (val === '') continue;
            if (NUM_KEYS[key]) val = Number(val);
            if (VS_KEYS.indexOf(key) >= 0) draft.vehicleSpecs[key] = val; else draft[key] = val;
          }
          return draft;
        }

        // --- Create draft (STUB — no real Sanity write) ---
        $('create-btn').addEventListener('click', function () {
          var btn = $('create-btn'); btn.disabled = true; btn.textContent = 'Creating…';
          fetch('/api/capture/create-draft', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ draft: gatherDraft() }),
          }).then(function (r) { return r.json(); }).then(function (data) {
            var box = $('create-result'); box.hidden = false;
            if (data.error) {
              box.className = 'issue-error'; box.style.padding = '12px'; box.style.borderRadius = '10px';
              box.textContent = data.error;
              renderValidation(data.validation);
            } else {
              box.className = 'ok';
              box.textContent = 'Draft assembled (' + data.result.draftId + '). ' + data.result.note;
            }
            btn.disabled = false; btn.textContent = 'Create draft';
          }).catch(function () {
            btn.disabled = false; btn.textContent = 'Create draft';
          });
        });

        $('back-btn').addEventListener('click', function () {
          $('review-step').hidden = true; $('capture-step').hidden = false;
          $('create-result').hidden = true; window.scrollTo(0, 0);
        });
      })();
    </script>
  </body>
</html>
