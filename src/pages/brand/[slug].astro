---
// SSR (not prerendered): a single brand's hub. The slug is resolved at request
// time against REAL inventory makes (never a hardcoded brand list); an unknown
// slug 404s because slugs only ever derive from real stock. Runs its OWN
// make-filtered Sanity query via LISTING_FIELDS — it does NOT add a `make` param
// to the core filter contract. Ported from concepts2/inline-contextual/brand.astro.
export const prerender = false;

import '../../styles/global.css';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import ChatWidget from '../../components/widgets/ChatWidget.astro';
import ListingCard from '../../components/ListingCard.astro';
import { fetchActiveMakes, fetchBrandStock } from '../../lib/brands';
import { dealerConfig } from '../../config/dealer';

const { slug } = Astro.params;

// Resolve the slug to a real make + its stock. null → not a real brand → 404.
const resolved = slug ? await fetchBrandStock(slug) : null;
// All makes, for the brand switcher chips at the top.
const allBrands = await fetchActiveMakes();

const icon = (name: string, size = 16): string => {
  const s = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"`;
  const p: Record<string, string> = {
    star: '<path d="M12 3l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.9 6.7 19l1-5.8L3.5 9.2l5.9-.9z"/>',
    filter: '<path d="M3 5h18l-7 8v6l-4-2v-4z"/>',
    car: '<path d="M5 11l1.5-4A2 2 0 018.4 6h7.2a2 2 0 011.9 1.3L19 11"/><path d="M4 11h16v5H4z"/><circle cx="7.5" cy="16" r="1.5"/><circle cx="16.5" cy="16" r="1.5"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  };
  return `<svg ${s}>${p[name] ?? ''}</svg>`;
};

if (!resolved) {
  Astro.response.status = 404;
}

const make = resolved?.make ?? '';
const stock = resolved?.listings ?? [];

const title = resolved ? `${make} at ${dealerConfig.identity.name}` : `Brand not found — ${dealerConfig.identity.name}`;
const description = resolved
  ? `${make} in stock at ${dealerConfig.identity.name}.`
  : 'That brand is not in our yard right now.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="page-surface min-h-screen antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <SiteNav active="browse" />

    <main id="main-content" tabindex="-1">
      {resolved ? (
        <>
          <section class="site-container hero-wrap">
            <div class="entry-origin">Reached from a brand chip (home / listings / vehicle / /brand)</div>
            {allBrands.length > 0 && (
              <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:14px">
                {allBrands.map((b) => (
                  <a class={`facet ${b.slug === slug ? 'is-on' : ''}`} href={`/brand/${b.slug}`}>{b.make}</a>
                ))}
              </div>
            )}
            <span class="eyebrow"><span set:html={icon('star', 13)} /> Brand hub</span>
            <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-5xl">{make}</h1>
            <p class="lead mt-3 max-w-2xl">Every {make} currently in our yard — real stock you can open.</p>
            <div class="entry-rail" style="margin-top:18px">
              <a href="/listings" class="entry">
                <span class="entry-ic" set:html={icon('filter', 18)} />
                <span class="entry-tx"><b>Browse all stock</b><span>the full inventory grid</span></span>
                <span class="entry-go" set:html={icon('arrow', 15)} />
              </a>
            </div>
          </section>

          <section class="site-container section-tight">
            <div style="display:flex; align-items:end; justify-content:space-between; gap:12px; margin-bottom:16px">
              <h2 class="text-2xl font-bold text-ink">{make} stock</h2>
              <a href="/listings" class="btn btn-ghost btn-sm">Browse all <span class="ml-1 inline-flex" set:html={icon('arrow', 15)} /></a>
            </div>
            {stock.length > 0 ? (
              <section class="inventory-grid" style={`--result-cols:${stock.length}`}>
                {stock.map((listing) => <ListingCard listing={listing} />)}
              </section>
            ) : (
              <div class="card" style="padding:26px; text-align:center">
                <p class="muted">No {make} in stock right now — <a href="/listings">browse all stock</a>.</p>
              </div>
            )}
          </section>
        </>
      ) : (
        <section class="site-container section-tight">
          <div class="card" style="padding:40px; text-align:center; max-width:36rem; margin:0 auto">
            <span class="entry-ic" style="width:44px; height:44px; border-radius:12px; display:inline-grid; place-items:center; background:var(--mint-glow); color:var(--teal-deep)" set:html={icon('car', 22)} />
            <h1 class="text-2xl font-bold text-ink" style="margin-top:14px">Brand not found</h1>
            <p class="muted" style="margin-top:8px">That brand isn't in our yard right now.</p>
            <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:18px">
              <a href="/brand" class="btn btn-ghost btn-sm">See all brands</a>
              <a href="/listings" class="btn btn-primary btn-sm">Browse all stock</a>
            </div>
          </div>
        </section>
      )}
    </main>

    <SiteFooter />
    <ChatWidget />
  </body>
</html>
