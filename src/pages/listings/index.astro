---
// `/listings` → `/` — permanent redirect, query string preserved.
//
// The browse experience (grid + filters + SearchDock + `#inventory-results`) is
// now the home page: `/` owns the grid and the filter-URL contract
// (`LISTINGS_PATH` in `src/lib/listings-query.ts`). This route stays alive
// purely as a compatibility shim, because filter URLs of the shape
// `/listings?<serialized filters>` are already out in the wild:
//   - saved searches persisted in D1 (`/account` re-run links),
//   - Rebi's grounding + action deep-links,
//   - anything a visitor bookmarked or shared.
// Forwarding `Astro.url.search` verbatim means every one of those keeps
// resolving to exactly the same filter state — `parseFilters` reads the same
// params, just at the new base path.
//
// SSR (not prerendered): the redirect target depends on the request's query
// string, so it cannot be baked at build time.
//
// NOTE: this is `/listings` only. Vehicle detail pages at `/listings/<slug>`
// are a separate route (`[slug].astro`) and are untouched.
export const prerender = false;

return Astro.redirect(`/${Astro.url.search}`, 301);
---
