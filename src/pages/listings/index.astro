---
// SSR (not prerendered): `/listings` is the full browse experience and owns the
// grid + filter contract (Wave 1 remodel). It reads filter/pagination params
// from the URL and filters server-side, so it can't be baked at build time.
// This page is the relocation target for what previously lived on the home page
// (`src/pages/index.astro`): the grid, the Filters drawer, the SearchDock island
// and the swappable `#inventory-results` region — all preserved verbatim so the
// grid-swap / SearchDock / query-planner contract survives the move. The
// inline-contextual reskin (facet sidebar + `.entry` jumps) is the ONLY change
// in behaviour terms; the filter mechanics are byte-for-byte the same code path.
export const prerender = false;

import '../../styles/global.css';
import { client } from '../../sanity/lib/client';
import CompareTray from '../../components/CompareTray.astro';
import ChatWidget from '../../components/widgets/ChatWidget.astro';
import SearchDock from '../../components/search/SearchDock.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import FilterDrawer from '../../components/filters/FilterDrawer.astro';
import InventoryResults from '../../components/filters/InventoryResults.astro';
import { dealerConfig } from '../../config/dealer';
import { iconSvg } from '../../lib/listing';
import {
  parseFilters,
  buildListingsQuery,
  activeChips,
  type InventoryResult,
} from '../../lib/listings-query';
import { priceDropsFor } from '../../lib/price-history-data';

// Edge caching (DECISION.md Decision 5): anonymous/unfiltered hits get served
// from Cloudflare's cache and feel static; each unique filter URL caches
// separately. Recovers most of the TTFB we'd otherwise lose by dropping
// prerender.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// URL is the single source of truth. Parse the filter state, then filter +
// paginate server-side via the shared query builder (reused by the partial).
const filterState = parseFilters(Astro.url.searchParams);
const { query, params } = buildListingsQuery(filterState);
const { items: listings, total } = await client.fetch<InventoryResult>(query, params);

// Resolve each card's honest price drop once (the STUB_PRICE_HISTORY demo flag is
// read inside priceDropsFor, at this data layer — never in the card). Request-time
// clock passed in (no module-level new Date()).
const priceDrops = priceDropsFor(listings, Date.now());

const activeCount = activeChips(filterState).length;

// Presentation-layer icon set (stroke, 24-grid) for the inline-contextual look —
// self-contained, no dealer data (mirrors the pattern in SiteNav.astro). The
// shared `iconSvg` (16-grid) is used only for the Filters-button glyph so it
// matches the drawer.
const icon = (name: string, size = 16): string => {
  const a = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"`;
  const p: Record<string, string> = {
    bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    spark: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" fill="currentColor" stroke="none"/>',
    filter: '<path d="M3 5h18l-7 8v6l-4-2v-4z"/>',
  };
  return `<svg ${a}>${p[name] ?? ''}</svg>`;
};

const title = 'Browse stock — Rebirth Auto';
const description =
  'Browse the full range at Rebirth Auto. New, Demo and Used are filter facets, not separate pages — one list, sliced how you like, with Rebi on hand to refine.';
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://rebirth-listings-auto.pages.dev',
).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="page-surface min-h-screen antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <!-- Reusable sticky glass nav (smart-hubs). "Ask Rebi" carries data-rebi-open. -->
    <SiteNav active="browse" />

    <main id="main-content" class="site-container" tabindex="-1">
      <!-- Intro + AI search (inline-contextual: New/Demo/Used are facets, not pages) -->
      <section class="mx-auto max-w-3xl pt-12 pb-6 text-center md:pt-16">
        <span class="eyebrow justify-center">
          <Fragment set:html={icon('spark', 15)} />
          Browse the yard
        </span>
        <h1 class="mt-5 text-3xl font-bold tracking-tight text-ink md:text-5xl">
          All stock, one list.
        </h1>
        <p class="lead mx-auto mt-4">
          New, Demo and Used are <b>filter facets</b> here — not separate pages. Slice the
          list how you like, or just tell Rebi what you're after.
        </p>

        {/* Rebi-fronted plain-English search — the SAME SearchDock island as before,
            relocated here. On submit it POSTs /api/search, drives the ONE filter
            URL via applyFilterUrl, and swaps #inventory-results below. */}
        <div class="mt-8">
          <SearchDock />
        </div>
      </section>

      <div class="grid grid-cols-1 gap-8 pb-16 lg:grid-cols-[230px_minmax(0,1fr)] lg:items-start">
        <!-- FACET SIDEBAR — quick wayfinding via real filter URLs (SSR-navigate;
             the drawer + AI search do the in-place swaps). Plus an inline .entry
             jump to the EV hub, in context of the Fuel facet. -->
        <aside class="lg:sticky lg:top-[92px]">
          <div class="card p-5">
            <div class="site-foot-h" style="color:var(--ink-faint); margin-bottom:10px">Condition</div>
            <div class="mb-5 flex flex-wrap gap-2">
              <a class:list={['facet', { 'is-on': filterState.condition.length === 0 }]} href="/listings">All</a>
              <a class:list={['facet', { 'is-on': filterState.condition.includes('new') }]} href="/listings?condition=new">New</a>
              <a class:list={['facet', { 'is-on': filterState.condition.includes('demo') }]} href="/listings?condition=demo">Demo</a>
              <a class:list={['facet', { 'is-on': filterState.condition.includes('used') }]} href="/listings?condition=used">Used</a>
            </div>

            <div class="site-foot-h" style="color:var(--ink-faint); margin-bottom:10px">Fuel</div>
            <div class="mb-3 flex flex-wrap gap-2">
              <a class:list={['facet', { 'is-on': filterState.fuelType.includes('petrol') }]} href="/listings?fuelType=petrol">Petrol</a>
              <a class:list={['facet', { 'is-on': filterState.fuelType.includes('diesel') }]} href="/listings?fuelType=diesel">Diesel</a>
              <a class:list={['facet', { 'is-on': filterState.fuelType.includes('hybrid') }]} href="/listings?fuelType=hybrid">Hybrid</a>
              <a class:list={['facet', { 'is-on': filterState.fuelType.includes('electric') }]} href="/listings?fuelType=electric">Electric</a>
            </div>
            <!-- fuel facet surfaces the EV hub, in context (hub ships in a later wave) -->
            <a href="/electric" class="entry mb-5 w-full" style="box-shadow:none">
              <span class="entry-ic" set:html={icon('bolt', 16)}></span>
              <span class="entry-tx"><b>New to EVs?</b><span>Open the electric hub</span></span>
              <span class="entry-go" set:html={icon('arrow', 15)}></span>
            </a>

            <hr class="divider" style="margin:4px 0 16px" />
            <div class="site-foot-h" style="color:var(--ink-faint); margin-bottom:10px">Body</div>
            <div class="flex flex-wrap gap-2">
              {[['suv', 'SUV'], ['ute', 'Ute'], ['wagon', 'Wagon'], ['hatchback', 'Hatch'], ['van', 'Van']].map(([code, label]) => (
                <a class:list={['facet', { 'is-on': filterState.bodyType.includes(code) }]} href={`/listings?bodyType=${code}`}>{label}</a>
              ))}
            </div>
            <p class="faint mt-3 text-[11px]">Quick jumps. For price, year, odometer &amp; more, open <b>Filters</b>.</p>
          </div>
        </aside>

        <!-- RESULTS COLUMN -->
        <div>
          {/* Inventory heading + Filters button (the drawer's trigger, id="filters-trigger"). */}
          <div id="inventory" class="flex items-end justify-between border-b border-line pb-4">
            <div>
              <span class="eyebrow">Live inventory</span>
              <h2 id="inventory-heading" class="mt-2 text-2xl font-bold tracking-tight text-ink">
                Current inventory
              </h2>
            </div>
            <button type="button" id="filters-trigger" class="btn btn-ghost btn-sm">
              <Fragment set:html={iconSvg('filter', 'h-4 w-4')} />
              Filters
              <span
                data-filter-count
                hidden={activeCount === 0}
                class="inline-flex min-w-5 items-center justify-center rounded-full bg-ink px-1.5 py-0.5 text-xs font-semibold text-white"
              >
                {activeCount}
              </span>
            </button>
          </div>

          <!-- Filter drawer (persistent; lives outside the swappable results) -->
          <FilterDrawer state={filterState} triggerId="filters-trigger" />

          <!-- Swappable inventory results (chips + grid + pagination) -->
          <InventoryResults listings={listings} total={total} state={filterState} priceDrops={priceDrops} />
        </div>
      </div>

      {dealerConfig.capture.enabled && (
        <p class="mt-8 mb-4 text-center text-xs text-ink-faint">
          <a href="/capture" class="underline underline-offset-2 hover:text-ink-soft">Dealer: add a vehicle</a>
        </p>
      )}
    </main>

    <!-- Reusable dark footer (full directory) -->
    <SiteFooter />

    <!-- Floating comparison tray (self-contained, appears when ≥1 selected) -->
    <CompareTray />

    <!-- Floating AI chat assistant (Rebi) — self-contained global overlay -->
    <ChatWidget />

    <!-- Home → /listings query handoff: if the front-door search routed a raw
         query here as ?q=…, feed it into the SAME SearchDock flow (the island's
         own onSubmit → /api/search → applyFilterUrl → grid swap). This is
         page-level wiring only; the island's internals are untouched. No-JS
         degrades gracefully to the full SSR grid. -->
    <script is:inline>
      (function () {
        var q = new URL(window.location.href).searchParams.get('q');
        if (!q) return;
        var fired = false;
        function tryRun() {
          if (fired) return true;
          var form = document.getElementById('search-dock-form');
          var input = document.getElementById('search-dock-input');
          var dock = document.getElementById('search-dock');
          if (form && input && dock && !dock.hasAttribute('hidden')) {
            fired = true;
            input.value = q;
            if (typeof form.requestSubmit === 'function') form.requestSubmit();
            else form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
            return true;
          }
          return false;
        }
        if (tryRun()) return;
        var obs = new MutationObserver(function () {
          if (tryRun()) obs.disconnect();
        });
        obs.observe(document.body, { subtree: true, childList: true, attributes: true });
        setTimeout(function () { obs.disconnect(); }, 8000);
      })();
    </script>
  </body>
</html>
