---
import '../../styles/global.css';
import { client } from '../../sanity/lib/client';
import { urlFor } from '../../sanity/lib/image';
import ListingCard from '../../components/ListingCard.astro';
import ContactModal from '../../components/ContactModal.astro';
import CompareTray from '../../components/CompareTray.astro';
import ChatWidget from '../../components/widgets/ChatWidget.astro';
import AskRebiButton from '../../components/AskRebiButton.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { PortableText } from 'astro-portabletext';
import {
  type Listing,
  LISTING_FIELDS,
  iconSvg,
  detailIconName,
  categoryIconName,
  detailDisplay,
  buildSpecRows,
  statusConfig,
  formatPrice,
  categoryLabel,
  formatDate,
} from '../../lib/listing';
import { dealerConfig } from '../../config/dealer';
import {
  usePriceHistoryDemo,
  resolveHistory,
  priceDropFor,
  priceDropsFor,
} from '../../lib/price-history-data';

export async function getStaticPaths() {
  // Car dealership: only generate detail pages for vehicle listings.
  const slugs = await client.fetch<{ slug: string }[]>(
    `*[_type == "listing" && category == "automotive" && defined(slug.current)]{ "slug": slug.current }`,
  );
  return slugs.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;

const listing = await client.fetch<Listing | null>(
  `*[_type == "listing" && slug.current == $slug][0]{ ${LISTING_FIELDS} }`,
  { slug },
);

if (!listing) {
  return Astro.redirect('/404');
}

const related = await client.fetch<Listing[]>(
  `*[_type == "listing" && category == $category && slug.current != $slug]
     | order(listingDate desc, _id asc)[0...3]{ ${LISTING_FIELDS} }`,
  { category: listing.category, slug },
);

const images = listing.images ?? [];
const mainImage = images[0]
  ? urlFor(images[0]).width(900).height(675).fit('crop').auto('format').url()
  : null;

const status = statusConfig[listing.status] ?? statusConfig.draft;
const categoryName = categoryLabel(listing.category);
const priceLabel = formatPrice(listing.price, listing.currency);
const details = buildSpecRows(listing);

// --- Price history (honest data; demo flag resolved at the data layer) --------
// STUB_PRICE_HISTORY is read inside these helpers, never here or in the card.
// Request-time clock passed in (no module-level new Date() for this feature).
const nowMs = Date.now();
const useDemo = usePriceHistoryDemo();
const historyEnabled = dealerConfig.priceHistory.enabled;
// resolveHistory returns [] when the feature is disabled; gated once here.
const resolvedHistory = resolveHistory(listing, nowMs, useDemo);
const priceDrop = priceDropFor(listing, nowMs, useDemo);
const showDrop = historyEnabled && priceDrop?.dropped === true;
const dropAmount = showDrop ? priceDrop!.previous - priceDrop!.current : 0;
// Newest-first for the timeline display.
const historyRows = historyEnabled ? [...resolvedHistory].reverse() : [];
// Related-card badges resolved the same way (demo flag read inside).
const relatedDrops = priceDropsFor(related, nowMs);

// Star glyph for the Edmunds expert-review slot (filled vs outline).
const starSvg = (filled: boolean, cls = ''): string =>
  `<svg class="${cls}" viewBox="0 0 16 16" fill="${filled ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6z"/></svg>`;

// --- NFY view-model (grounded ONLY in the public LISTING_FIELDS projection) ----
// Rebi's "take" and the at-a-glance rail read from the same typed specs the rest
// of the page uses. No dealerNotes, no private fields — everything here is data
// already rendered on the public page.
const vs = listing.vehicleSpecs ?? {};
const fuelLabel = vs.fuelType
  ? ({ petrol: 'Petrol', diesel: 'Diesel', hybrid: 'Hybrid', electric: 'Electric', lpg: 'LPG' } as Record<string, string>)[vs.fuelType] ?? null
  : null;
const driveLabel = vs.driveType
  ? ({ '2wd': '2WD', awd: 'AWD', '4wd': '4WD' } as Record<string, string>)[vs.driveType] ?? null
  : null;
const odoText =
  typeof vs.odometer === 'number'
    ? `${vs.odometer.toLocaleString(dealerConfig.locale.locale)} km`
    : null;
const conditionLabel = vs.condition
  ? vs.condition.charAt(0).toUpperCase() + vs.condition.slice(1)
  : null;

// Rebi's-take chips — each is a truthful fact drawn from the listing.
const rebiChips: { text: string; caveat?: boolean }[] = [];
if (conditionLabel === 'Demo' || conditionLabel === 'New')
  rebiChips.push({ text: `Near-new ${conditionLabel.toLowerCase()} car` });
if (typeof vs.odometer === 'number' && vs.odometer <= 30000 && odoText)
  rebiChips.push({ text: `Low kilometres — ${odoText}` });
if (driveLabel === 'AWD' || driveLabel === '4WD')
  rebiChips.push({ text: `${driveLabel} capability` });
if (fuelLabel === 'Hybrid' || fuelLabel === 'Electric')
  rebiChips.push({ text: `Efficient ${fuelLabel.toLowerCase()} drivetrain` });
if (showDrop) rebiChips.push({ text: `Price just reduced` });
rebiChips.push({ text: 'Ask about service history & rego', caveat: true });
const rebiTakeChips = rebiChips.slice(0, 4);

// A grounded one-liner assembled from real fields (never fabricated specs).
const titleHasYear = vs.year ? new RegExp(`\\b${vs.year}\\b`).test(listing.title) : false;
const rebiSummary = [
  `Quick read: this ${vs.year && !titleHasYear ? vs.year + ' ' : ''}${listing.title} is listed at ${priceLabel}`,
  odoText ? `, showing ${odoText}` : '',
  driveLabel ? ` with ${driveLabel}` : '',
  fuelLabel ? `${driveLabel ? ' and' : ' with'} a ${fuelLabel.toLowerCase()} drivetrain` : '',
  `. For running costs, what to check before you buy, and how it compares to similar cars, ask me — I ground every answer in this listing.`,
].join('');

// At-a-glance rail: a curated subset of the same spec rows shown in full below.
const GLANCE_ORDER = ['Odometer', 'Year', 'Model Year', 'Body', 'Transmission', 'Fuel', 'Drive', 'Seats'];
const glanceRows = GLANCE_ORDER.map((label) =>
  details.find((d) => d.label.toLowerCase() === label.toLowerCase()),
)
  .filter((d): d is (typeof details)[number] => Boolean(d))
  .slice(0, 6);

// Edmunds "Expert review" slot — DEMO placeholder content, clearly attributed.
const edmunds = {
  score: '8.1',
  stars: 4,
  quote:
    'A well-rounded pick that quietly does most things well. Comfortable to live with, sensible to run, and easy to recommend to a first-time buyer.',
  subs: [
    ['Comfort', '8.5'],
    ['Value', '8.0'],
    ['Reliability', '7.9'],
  ] as [string, string][],
};

// Derive the social description from the first Portable Text paragraph.
const firstBlockText = Array.isArray(listing.description)
  ? (() => {
      const block = listing.description.find((b: any) => b?._type === 'block') as any;
      return block ? (block.children ?? []).map((c: any) => c?.text ?? '').join('').trim() : '';
    })()
  : '';
const metaDescription = firstBlockText || `${listing.title} — ${categoryName} listing.`;
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://rebirth-listings-auto.pages.dev',
).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{listing.title} · Rebirth Auto</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={listing.title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <!-- TODO: add <meta property="og:image"> once the demo is deployed and an OG image is hosted.
         Required for social previews — summary_large_image cards render blank without it. -->

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={listing.title} />
    <meta name="twitter:description" content={metaDescription} />
  </head>
  <body class="vdp page-surface">
    <a href="#main-content" class="vdp-skip">Skip to content</a>

    <SiteNav active="inventory" />

    <div class="site-container">
      <main id="main-content" tabindex="-1">
      <!-- Breadcrumb -->
      <nav class="vdp-crumb" aria-label="Breadcrumb">
        <a href="/">Inventory</a>
        <span aria-hidden="true">/</span>
        <span>{categoryName}</span>
        <span aria-hidden="true">/</span>
        <span class="vdp-crumb-cur">{listing.title}</span>
      </nav>

      <!-- Hero -->
      <section class="vdp-hero">
        <!-- Gallery + narrative -->
        <div class="vdp-main">
          <div class="card vdp-gallery">
            {
              mainImage ? (
                <img id="main-image" src={mainImage} alt={listing.title} />
              ) : (
                <div class="vdp-gallery-empty">
                  <Fragment set:html={iconSvg(categoryIconName(listing.category), 'h-16 w-16')} />
                </div>
              )
            }

            <span class:list={['vdp-status', status.badge]}>{status.label}</span>

            {
              listing.status === 'sold' && (
                <div aria-hidden="true" class="vdp-sold">Sold</div>
              )
            }
          </div>

          {
            images.length > 1 && (
              <div class="vdp-thumbs">
                {images.slice(0, 4).map((img) => (
                  <button
                    type="button"
                    class="card vdp-thumb"
                    data-full={urlFor(img).width(900).height(675).fit('crop').auto('format').url()}
                  >
                    <img
                      src={urlFor(img).width(200).height(150).fit('crop').auto('format').url()}
                      alt={`${listing.title} thumbnail`}
                    />
                  </button>
                ))}
              </div>
            )
          }

          <!-- Rebi's take — the signature AI summary block -->
          <div class="ai-summary scan vdp-rebi">
            <div class="vdp-rebi-head">
              <span class="orb orb-halo vdp-orb" aria-hidden="true"></span>
              <div>
                <b>Rebi's take on this car</b>
                <div class="vdp-rebi-sub">Summarised from the listing specs &amp; price</div>
              </div>
            </div>
            <p class="vdp-rebi-body">{rebiSummary}</p>
            <div class="vdp-rebi-chips">
              {rebiTakeChips.map((c) => (
                <span class:list={['chip', c.caveat ? '' : 'chip-teal']}>
                  <Fragment set:html={iconSvg(c.caveat ? 'sparkle' : 'check', 'h-3.5 w-3.5')} />
                  {c.text}
                </span>
              ))}
            </div>
            <div class="vdp-rebi-actions">
              <AskRebiButton
                size="inline"
                label="Ask Rebi about this car"
                data-rebi-open
                data-rebi-kind="listing"
                data-rebi-ref={listing._id}
                data-rebi-title={listing.title}
              />
              <button
                type="button"
                class="vdp-rebi-link"
                data-rebi-open
                data-rebi-kind="listing"
                data-rebi-ref={listing._id}
                data-rebi-title={listing.title}
              >
                Is this good value? →
              </button>
            </div>
          </div>

          <!-- Expert review — Edmunds attribution (DEMO placeholder), kept visually
               distinct from Rebi's AI summary above. -->
          <div class="card vdp-expert">
            <div class="vdp-expert-head">
              <div class="vdp-expert-title">
                <Fragment set:html={starSvg(true, 'vdp-star')} />
                <h3>Expert review</h3>
              </div>
              <div class="vdp-attrib">
                Review by
                <span class="vdp-attrib-logo" aria-hidden="true">E</span>
                <b>Edmunds</b>
                <span class="vdp-attrib-sep" aria-hidden="true"></span>
                <a href="https://www.edmunds.com" target="_blank" rel="noopener nofollow">
                  edmunds.com ↗
                </a>
              </div>
            </div>
            <div class="vdp-expert-body">
              <div class="vdp-expert-score">
                <div class="vdp-expert-num">{edmunds.score}</div>
                <div class="vdp-expert-outof">out of 10</div>
              </div>
              <div class="vdp-expert-quote">
                <div class="vdp-stars" aria-label={`${edmunds.stars} out of 5 stars`}>
                  {[0, 1, 2, 3, 4].map((i) => (
                    <Fragment set:html={starSvg(i < edmunds.stars, 'vdp-star')} />
                  ))}
                </div>
                <p>“{edmunds.quote}”</p>
              </div>
            </div>
            <div class="vdp-expert-subs">
              {edmunds.subs.map(([k, val]) => (
                <div class="vdp-sub">
                  <div class="vdp-sub-k">{k}</div>
                  <div class="vdp-sub-v">{val}</div>
                </div>
              ))}
            </div>
            <p class="vdp-expert-note">
              Placeholder attribution slot — scores &amp; copy are demo content. A live build embeds
              the syndicated Edmunds expert rating and links to the full review.
            </p>
          </div>

          <!-- Details -->
          {
            details.length > 0 && (
              <section class="vdp-section">
                <h2 class="vdp-h2">Features &amp; specification</h2>
                <div class="vdp-details">
                  {details.map((d) => (
                    <div class="card vdp-detail">
                      <div class="vdp-detail-ic">
                        {d.valueType === 'boolean' ? (
                          <Fragment
                            set:html={iconSvg(
                              d.valueBoolean ? 'check' : 'cross',
                              'h-5 w-5 ' + (d.valueBoolean ? 'vdp-ic-yes' : 'vdp-ic-no'),
                            )}
                          />
                        ) : (
                          <Fragment set:html={iconSvg(detailIconName(d.label), 'h-5 w-5')} />
                        )}
                      </div>
                      <p class="vdp-detail-k">{d.label}</p>
                      <p class="vdp-detail-v">{detailDisplay(d)}</p>
                    </div>
                  ))}
                </div>
              </section>
            )
          }

          <!-- Price history -->
          {
            historyEnabled && historyRows.length > 1 && (
              <section class="vdp-section">
                <h2 class="vdp-h2">Price history</h2>
                <ol class="vdp-history">
                  {historyRows.map((h, i) => (
                    <li class="card vdp-history-row">
                      <span class="vdp-history-date">{formatDate(h.date)}</span>
                      <span class="vdp-history-price">
                        <span class:list={['vdp-history-amt', i !== 0 && 'was']}>
                          {formatPrice(h.price, listing.currency)}
                        </span>
                        {i === 0 && showDrop && (
                          <span class="chip chip-teal">−{formatPrice(dropAmount, listing.currency)}</span>
                        )}
                      </span>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          <!-- Description -->
          {
            Array.isArray(listing.description) && listing.description.length > 0 && (
              <section class="vdp-section">
                <h2 class="vdp-h2">Description</h2>
                <div class="vdp-prose">
                  <PortableText value={listing.description as any} />
                </div>
              </section>
            )
          }
        </div>

        <!-- Buy rail -->
        <aside class="vdp-rail">
          <div class="card vdp-buy">
            <span class="eyebrow">{categoryName}{conditionLabel ? ` · ${conditionLabel}` : ''}</span>
            <h1 class="vdp-title">{listing.title}</h1>

            <div class="vdp-price-row">
              <span class="vdp-price">{priceLabel}</span>
              {
                showDrop && (
                  <span
                    class="vdp-price-was"
                    aria-label={`Was ${formatPrice(priceDrop!.previous, listing.currency)}`}
                  >
                    {formatPrice(priceDrop!.previous, listing.currency)}
                  </span>
                )
              }
            </div>

            {
              showDrop && (
                <p class="chip chip-teal vdp-drop">
                  <Fragment set:html={iconSvg('tag', 'h-3.5 w-3.5')} />
                  Just reduced — save {formatPrice(dropAmount, listing.currency)}
                </p>
              )
            }

            {
              listing.listingDate && (
                <p class="vdp-listed">Listed on {formatDate(listing.listingDate)}</p>
              )
            }

            <div class="vdp-actions">
              <button id="contact-btn" type="button" class="btn btn-primary btn-lg vdp-cta">
                Contact seller
              </button>
              <button
                id="save-btn"
                type="button"
                data-id={listing._id}
                aria-pressed="false"
                class="btn btn-ghost vdp-cta"
              >
                <span id="save-icon" class="inline-flex"><Fragment set:html={iconSvg('heart', 'h-4 w-4')} /></span>
                <span id="save-label">Save listing</span>
              </button>
              <AskRebiButton
                size="block"
                label="Ask about this car"
                data-rebi-open
                data-rebi-kind="listing"
                data-rebi-ref={listing._id}
                data-rebi-title={listing.title}
              />
            </div>
          </div>

          {
            glanceRows.length > 0 && (
              <div class="card vdp-glance">
                <h4 class="vdp-glance-h">At a glance</h4>
                <div class="vdp-glance-grid">
                  {glanceRows.map((d) => (
                    <div class="vdp-glance-cell">
                      <span class="vdp-glance-ic">
                        <Fragment set:html={iconSvg(detailIconName(d.label), 'h-4 w-4')} />
                      </span>
                      <div>
                        <div class="vdp-glance-k">{d.label}</div>
                        <div class="vdp-glance-v">{detailDisplay(d)}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )
          }
        </aside>
      </section>

      <!-- Related -->
      {
        related.length > 0 && (
          <section class="vdp-section vdp-related">
            <div class="vdp-related-head">
              <div>
                <span class="eyebrow">You might also weigh up</span>
                <h2 class="vdp-h2">More from {categoryName}</h2>
              </div>
            </div>
            <div class="inventory-grid">
              {related.map((r) => (
                <ListingCard listing={r} priceDrop={relatedDrops[r._id] ?? null} />
              ))}
            </div>
          </section>
        )
      }

      </main>
    </div>

    <SiteFooter />

    <style is:global>
      /* =====================================================================
         Vehicle detail (VDP) — Near-Future Yard reskin. All rules namespaced
         under `.vdp` (mirrors the compare pages) so nothing leaks. Everything
         is driven by the NFY tokens in theme.css.
         ===================================================================== */
      .vdp { color: var(--ink); }
      .vdp .site-container { position: relative; z-index: 1; }

      .vdp-skip {
        position: absolute; left: -9999px; top: 0; z-index: 50;
        background: var(--ink); color: #fff; padding: 10px 16px;
        border-radius: var(--r-sm); font-weight: 600;
      }
      .vdp-skip:focus { left: 16px; top: 16px; }

      /* breadcrumb */
      .vdp-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
        padding: 22px 0 4px; font-size: 13px; color: var(--ink-faint); }
      .vdp-crumb a { color: var(--ink-faint); text-decoration: none; transition: color .16s; }
      .vdp-crumb a:hover { color: var(--teal-deep); }
      .vdp-crumb-cur { color: var(--ink-soft); }

      /* hero layout */
      .vdp-hero { display: grid; grid-template-columns: 1.6fr 1fr; gap: 34px;
        align-items: start; padding-block: 18px 34px; }
      .vdp-main { min-width: 0; display: flex; flex-direction: column; gap: 24px; }
      @media (max-width: 980px) { .vdp-hero { grid-template-columns: 1fr; gap: 24px; } }

      /* gallery */
      .vdp-gallery { position: relative; overflow: hidden; aspect-ratio: 16/10;
        background: var(--bg-2); }
      .vdp-gallery img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .vdp-gallery-empty { display: grid; place-items: center; width: 100%; height: 100%;
        color: var(--ink-faint); }
      .vdp-status { position: absolute; right: 14px; top: 14px; z-index: 2;
        padding: 5px 12px; border-radius: var(--r-pill); font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .06em; color: #fff; box-shadow: var(--sh-1); }
      .vdp-sold { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%) rotate(-12deg);
        background: rgba(220,38,38,.95); color: #fff; padding: 10px 72px; font-size: 22px;
        font-weight: 800; text-transform: uppercase; letter-spacing: .3em; box-shadow: var(--sh-2);
        pointer-events: none; }
      .vdp-thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 2px; }
      .vdp-thumb { padding: 0; overflow: hidden; cursor: pointer; aspect-ratio: 4/3; }
      .vdp-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

      /* Rebi's take */
      .vdp-rebi { padding: 24px; }
      .vdp-rebi-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
      .vdp-orb { width: 38px; height: 38px; }
      .vdp-rebi-head b { font-family: var(--font-display); font-size: 16px; color: var(--ink); }
      .vdp-rebi-sub { font-size: 12px; color: var(--teal-deep); margin-top: 1px; }
      .vdp-rebi-body { font-size: 15px; color: var(--ink-soft); line-height: 1.65; }
      .vdp-rebi-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
      .vdp-rebi-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 18px; }
      .vdp-rebi-link { border: 0; background: none; cursor: pointer; font: inherit;
        font-size: 13.5px; font-weight: 600; color: var(--indigo-deep); }
      .vdp-rebi-link:hover { text-decoration: underline; }

      /* Expert review (Edmunds) — neutral/amber, deliberately NOT the AI look */
      .vdp-expert { padding: 24px; }
      .vdp-expert-head { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between;
        align-items: center; margin-bottom: 16px; }
      .vdp-expert-title { display: flex; align-items: center; gap: 10px; }
      .vdp-expert-title h3 { font-family: var(--font-display); font-size: 20px; font-weight: 600;
        color: var(--ink); margin: 0; }
      .vdp-star { width: 20px; height: 20px; color: var(--amber); }
      .vdp-attrib { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px;
        background: var(--bg-2); border-radius: var(--r-pill); font-size: 12.5px; color: var(--ink-soft); }
      .vdp-attrib b { font-family: var(--font-display); color: var(--ink); letter-spacing: .01em; }
      .vdp-attrib-logo { display: grid; place-items: center; width: 18px; height: 18px;
        border-radius: 5px; background: var(--ink); color: #fff; font-family: var(--font-display);
        font-weight: 700; font-size: 12px; }
      .vdp-attrib-sep { width: 1px; height: 12px; background: var(--line); }
      .vdp-attrib a { color: var(--teal-deep); font-weight: 600; text-decoration: none; }
      .vdp-attrib a:hover { text-decoration: underline; }
      .vdp-expert-body { display: flex; align-items: center; gap: 20px; margin-bottom: 16px; }
      .vdp-expert-score { text-align: center; flex: none; }
      .vdp-expert-num { font-family: var(--font-display); font-size: 40px; font-weight: 700;
        line-height: 1; color: var(--ink); }
      .vdp-expert-outof { font-size: 11px; color: var(--ink-faint); margin-top: 2px; }
      .vdp-expert-quote { flex: 1; min-width: 0; }
      .vdp-stars { display: inline-flex; gap: 4px; color: var(--amber); }
      .vdp-stars .vdp-star { width: 16px; height: 16px; }
      .vdp-expert-quote p { font-size: 14px; color: var(--ink-soft); margin-top: 6px; line-height: 1.5; }
      .vdp-expert-subs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
      .vdp-sub { background: var(--bg-2); border-radius: var(--r-sm); padding: 12px 14px; }
      .vdp-sub-k { font-size: 12px; color: var(--ink-faint); }
      .vdp-sub-v { font-family: var(--font-display); font-size: 20px; font-weight: 600; color: var(--ink); }
      .vdp-expert-note { font-size: 11.5px; color: var(--ink-faint); margin-top: 14px; }

      /* sections */
      .vdp-section { margin-top: 4px; }
      .vdp-h2 { font-family: var(--font-display); font-size: 22px; font-weight: 600; color: var(--ink);
        letter-spacing: -0.01em; margin: 0 0 16px; }
      .vdp-details { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
      @media (min-width: 560px) { .vdp-details { grid-template-columns: repeat(3, 1fr); } }
      .vdp-detail { padding: 16px; }
      .vdp-detail-ic { color: var(--ink-faint); }
      .vdp-ic-yes { color: var(--teal); }
      .vdp-ic-no { color: #dc2626; }
      .vdp-detail-k { margin-top: 10px; font-size: 11px; font-weight: 600; text-transform: uppercase;
        letter-spacing: .06em; color: var(--ink-faint); }
      .vdp-detail-v { margin-top: 3px; font-size: 17px; font-weight: 600; color: var(--ink); }

      /* price history */
      .vdp-history { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column;
        gap: 10px; max-width: 460px; }
      .vdp-history-row { display: flex; align-items: center; justify-content: space-between;
        padding: 12px 16px; }
      .vdp-history-date { font-size: 13px; color: var(--ink-faint); }
      .vdp-history-price { display: inline-flex; align-items: center; gap: 8px; }
      .vdp-history-amt { font-size: 15px; font-weight: 600; color: var(--ink); }
      .vdp-history-amt.was { color: var(--ink-faint); text-decoration: line-through; font-weight: 500; }

      /* description */
      .vdp-prose { max-width: 68ch; color: var(--ink-soft); line-height: 1.7; }
      .vdp-prose :is(h1,h2,h3) { color: var(--ink); font-family: var(--font-display); }
      .vdp-prose p { margin: 0 0 1em; }
      .vdp-prose a { color: var(--teal-deep); }

      /* buy rail */
      .vdp-rail { position: sticky; top: 92px; display: flex; flex-direction: column; gap: 16px; }
      @media (max-width: 980px) { .vdp-rail { position: static; } }
      .vdp-buy { padding: 24px; }
      .vdp-title { font-family: var(--font-display); font-size: 26px; font-weight: 600;
        line-height: 1.15; margin: 12px 0 0; color: var(--ink); }
      .vdp-price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin-top: 14px; }
      .vdp-price { font-family: var(--font-display); font-size: 34px; font-weight: 700; color: var(--ink); }
      .vdp-price-was { font-size: 18px; font-weight: 500; color: var(--ink-faint); text-decoration: line-through; }
      .vdp-drop { margin-top: 12px; }
      .vdp-listed { margin-top: 12px; font-size: 13px; color: var(--ink-faint); }
      .vdp-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; }
      .vdp-cta { justify-content: center; width: 100%; }
      .vdp-buy #save-btn[aria-pressed="true"] { border-color: var(--teal); color: var(--teal-deep);
        background: var(--mint-glow); }
      .vdp-buy #save-btn[aria-pressed="true"] svg { fill: var(--teal-deep); }

      /* at a glance */
      .vdp-glance { padding: 22px; }
      .vdp-glance-h { font-family: var(--font-display); font-size: 15px; font-weight: 600;
        color: var(--ink); margin: 0 0 14px; }
      .vdp-glance-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 14px; }
      .vdp-glance-cell { display: flex; gap: 11px; }
      .vdp-glance-ic { color: var(--teal-deep); margin-top: 2px; flex: none; }
      .vdp-glance-k { font-size: 11.5px; color: var(--ink-faint); }
      .vdp-glance-v { font-size: 14px; font-weight: 600; color: var(--ink); }

      /* related */
      .vdp-related { margin-top: 40px; }
      .vdp-related-head { margin-bottom: 20px; }
    </style>

    <!-- Contact Seller demo modal (self-contained, wired to #contact-btn) -->
    <ContactModal />

    <!-- Floating comparison tray (self-contained, appears when ≥1 selected) -->
    <CompareTray />

    <!-- Floating AI chat assistant (Rebi) — self-contained global overlay -->
    <ChatWidget />

    <script>
      import { icons } from '../../lib/listing';

      // --- Gallery thumbnail switching -------------------------------------
      const main = document.getElementById('main-image') as HTMLImageElement | null;
      document.querySelectorAll<HTMLElement>('[data-full]').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          if (main && thumb.dataset.full) main.src = thumb.dataset.full;
        });
      });

      // --- Save Listing (persisted in localStorage) ------------------------
      const SAVED_KEY = 'astro-listings-saved';
      const saveBtn = document.getElementById('save-btn');
      const saveIcon = document.getElementById('save-icon');
      const saveLabel = document.getElementById('save-label');
      const listingId = saveBtn?.dataset.id;

      const filledHeart = `<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">${icons.heart}</svg>`;
      const outlineHeart = `<svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons.heart}</svg>`;

      function getSaved(): string[] {
        try {
          const raw = localStorage.getItem(SAVED_KEY);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }

      function renderSaved() {
        if (!saveBtn || !saveIcon || !saveLabel || !listingId) return;
        const saved = getSaved().includes(listingId);
        saveIcon.innerHTML = saved ? filledHeart : outlineHeart;
        saveLabel.textContent = saved ? 'Saved' : 'Save Listing';
        saveBtn.classList.toggle('bg-slate-100', saved);
        saveBtn.setAttribute('aria-pressed', String(saved));
      }

      saveBtn?.addEventListener('click', () => {
        if (!listingId) return;
        try {
          const list = getSaved();
          const idx = list.indexOf(listingId);
          if (idx >= 0) list.splice(idx, 1);
          else list.push(listingId);
          localStorage.setItem(SAVED_KEY, JSON.stringify(list));
        } catch {
          /* localStorage unavailable — no-op */
        }
        renderSaved();
      });
      renderSaved();
    </script>

    <!-- Continuity-journey beacon: record this listing view (fail-open, best-effort). -->
    <script is:inline define:vars={{ payload: { kind: 'listing', ref: listing._id, label: listing.title } }}>
      (function () {
        try {
          var data = JSON.stringify(payload);
          var url = '/api/journey';
          var sent = false;
          if (navigator.sendBeacon) {
            sent = navigator.sendBeacon(url, new Blob([data], { type: 'application/json' }));
          }
          if (!sent) {
            fetch(url, {
              method: 'POST',
              body: data,
              headers: { 'Content-Type': 'application/json' },
              keepalive: true,
              credentials: 'same-origin',
            }).catch(function () {});
          }
        } catch (e) {
          /* fail-open — the beacon never affects the page */
        }
      })();
    </script>
  </body>
</html>
