---
// SSR (not prerendered): the page posts to /api/fleet-enquiry and honours the
// dealer feature flag at request time. Ported from
// concepts2/inline-contextual/fleet.astro onto the real SiteNav/SiteFooter + real
// data/config. Mirrors sell.astro / parts.astro.
export const prerender = false;

import '../styles/global.css';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ChatWidget from '../components/widgets/ChatWidget.astro';
import { dealerConfig } from '../config/dealer';

const cfg = dealerConfig.fleet;

// Feature flag — a dealer can hide the fleet tool without a deploy.
if (!cfg.enabled) return Astro.redirect('/', 302);

const { copy } = cfg;
const capabilities = cfg.capabilities;

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_USER_TURNSTILE_KEY;

const icon = (name: string, size = 16): string => {
  const s = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"`;
  const p: Record<string, string> = {
    briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2M3 13h18"/>',
    tag: '<path d="M3 12l9-9 8 8-9 9-8-8z"/><circle cx="8" cy="8" r="1.3"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>',
    bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
    send: '<path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4z"/>',
    phone: '<path d="M4 5a2 2 0 012-2h2l2 5-2 1a11 11 0 005 5l1-2 5 2v2a2 2 0 01-2 2A15 15 0 014 5z"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  };
  return `<svg ${s}>${p[name] ?? ''}</svg>`;
};

const title = `${copy.heading} — ${dealerConfig.identity.name}`;
const description = copy.subheading;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="page-surface min-h-screen antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <SiteNav active="service-parts" />

    <main id="main-content" tabindex="-1">
      <section class="site-container hero-wrap">
        <div class="entry-origin">Reached from About / Contact (business) · footer · Rebi</div>
        <span class="eyebrow"><span set:html={icon('briefcase', 13)} /> {copy.eyebrow}</span>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-5xl">{copy.heading}</h1>
        <p class="lead mt-3 max-w-2xl">{copy.subheading}</p>
      </section>

      <section class="site-container section-tight">
        <div class="grid-auto" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,15rem),1fr))">
          {capabilities.map((c) => (
            <div class="card" style="padding:18px">
              <span style="color:var(--teal-deep)" set:html={icon(c.icon, 22)} />
              <b style="display:block; font-size:15px; margin:10px 0 4px">{c.title}</b>
              <p class="muted" style="font-size:13px">{c.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="site-container fleet-layout">
        <div
          id="fleet-root"
          data-loading-label={copy.loadingLabel}
          class="card"
          style="padding:26px"
        >
          <h2 class="text-lg font-semibold text-ink" style="margin-bottom:16px">Fleet enquiry</h2>
          <form id="fleet-form" novalidate class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="field sm:col-span-1">
              <label class="field-label" for="fl-business">Business name</label>
              <input class="field-input" id="fl-business" name="businessName" type="text" required
                autocomplete="organization" placeholder="Your company" />
            </div>
            <div class="field sm:col-span-1">
              <label class="field-label" for="fl-contact">Email or phone</label>
              <input class="field-input" id="fl-contact" name="contact" type="text" required
                autocomplete="email" placeholder="you@example.com or 0400 000 000" />
            </div>
            <div class="field sm:col-span-1">
              <label class="field-label" for="fl-abn">ABN <span class="faint">(optional)</span></label>
              <input class="field-input" id="fl-abn" name="abn" type="text"
                autocomplete="off" inputmode="numeric" placeholder="__ ___ ___ ___" />
            </div>
            <div class="field sm:col-span-1">
              <label class="field-label" for="fl-needs">Fleet size / needs</label>
              <input class="field-input" id="fl-needs" name="fleetNeeds" type="text" required
                autocomplete="off" placeholder="e.g. 6 utes, priority servicing" />
            </div>
            <div class="field sm:col-span-2">
              <label class="field-label" for="fl-notes">Anything else? <span class="faint">(optional)</span></label>
              <textarea class="field-textarea" id="fl-notes" name="notes" rows="3"
                placeholder="Tell us about your business and what you're planning."></textarea>
            </div>

            {TURNSTILE_SITE_KEY && (
              <div class="sm:col-span-2">
                <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>
              </div>
            )}

            <div class="sm:col-span-2">
              <button
                type="submit"
                id="fl-submit"
                class="btn btn-primary w-full justify-center disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
              >
                <span class="mr-1.5 inline-flex" set:html={icon('send', 15)} />
                <span id="fl-submit-label">{copy.submitLabel}</span>
              </button>
              <p class="faint mt-3 text-xs leading-relaxed">{copy.disclaimer}</p>
            </div>
          </form>

          <p id="fl-error" role="alert" hidden
            class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></p>

          <div id="fl-success" hidden aria-live="polite" class="ai-summary mt-8">
            <p id="fl-success-text" class="text-sm font-medium text-ink"></p>
          </div>
        </div>

        <aside class="stack" style="gap:14px; position:sticky; top:92px">
          <!-- fleet → contact (business). /contact 404s until Wave 4; linked anyway. -->
          <a href="/contact" class="entry">
            <span class="entry-ic" set:html={icon('phone', 18)} />
            <span class="entry-tx"><b>Prefer to talk?</b><span>reach the dealership</span></span>
            <span class="entry-go" set:html={icon('arrow', 15)} />
          </a>
          <a href="/listings" class="entry entry--amber">
            <span class="entry-ic" set:html={icon('tag', 18)} />
            <span class="entry-tx"><b>Browse the range</b><span>see current stock</span></span>
            <span class="entry-go" set:html={icon('arrow', 15)} />
          </a>
        </aside>
      </section>
    </main>

    <SiteFooter />
    <ChatWidget />

    {TURNSTILE_SITE_KEY && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}

    <script>
      const root = document.getElementById('fleet-root');
      const form = document.getElementById('fleet-form') as HTMLFormElement | null;
      if (root && form) {
        const loadingLabel = root.dataset.loadingLabel || 'Sending your enquiry…';

        const submit = document.getElementById('fl-submit') as HTMLButtonElement;
        const submitLabel = document.getElementById('fl-submit-label') as HTMLElement;
        const defaultLabel = submitLabel.textContent || 'Talk to the fleet team';
        const errorEl = document.getElementById('fl-error') as HTMLElement;
        const successEl = document.getElementById('fl-success') as HTMLElement;
        const successText = document.getElementById('fl-success-text') as HTMLElement;

        const showError = (msg: string) => {
          errorEl.textContent = msg;
          errorEl.hidden = false;
          successEl.hidden = true;
        };
        const setLoading = (on: boolean) => {
          submit.disabled = on;
          submitLabel.textContent = on ? loadingLabel : defaultLabel;
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorEl.hidden = true;

          const data = new FormData(form);
          const payload = {
            businessName: String(data.get('businessName') || '').trim(),
            contact: String(data.get('contact') || '').trim(),
            abn: String(data.get('abn') || '').trim(),
            fleetNeeds: String(data.get('fleetNeeds') || '').trim(),
            notes: String(data.get('notes') || '').trim(),
            turnstileToken: String(data.get('cf-turnstile-response') || ''),
          };

          if (!payload.businessName) return showError('Please enter your business name.');
          if (!payload.contact) return showError('Please enter an email or phone number.');
          if (!payload.fleetNeeds) return showError('Please tell us about your fleet needs.');

          setLoading(true);
          try {
            const res = await fetch('/api/fleet-enquiry', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const body = (await res.json()) as { ok?: boolean; message?: string; error?: string };
            if (!res.ok || !body.ok) {
              showError(body.error || 'We could not send that enquiry right now — please try again.');
              return;
            }
            successText.textContent =
              body.message || "Thanks — we've received your enquiry and will be in touch.";
            successEl.hidden = false;
            form.reset();
            if (typeof (window as any).turnstile !== 'undefined') (window as any).turnstile.reset();
            successEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } catch {
            showError('Something went wrong — please check your connection and try again.');
          } finally {
            setLoading(false);
          }
        });
      }
    </script>

    <style>
      .fleet-layout {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 26px;
        align-items: start;
        padding-bottom: 44px;
      }
      @media (max-width: 820px) {
        .fleet-layout { grid-template-columns: 1fr; }
        .fleet-layout aside { position: static !important; }
      }
      .field { display: flex; flex-direction: column; gap: 7px; }
      .field-label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
      .field-input,
      .field-textarea {
        width: 100%;
        font-family: var(--font-ui);
        font-size: 15px;
        color: var(--ink);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
        transition: border-color 0.16s, box-shadow 0.16s;
      }
      .field-input::placeholder,
      .field-textarea::placeholder { color: var(--ink-faint); }
      .field-input:focus,
      .field-textarea:focus {
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(15, 181, 166, 0.15);
        outline: none;
      }
      .field-textarea { resize: vertical; min-height: 96px; }
    </style>
  </body>
</html>
