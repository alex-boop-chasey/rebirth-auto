---
/**
 * /check-email — post-signup confirmation prompt (email verification pending).
 * Gated by the accounts.enabled feature flag.
 */
export const prerender = false;

import AuthLayout from '../layouts/AuthLayout.astro';
import { dealerConfig } from '../config/dealer';

if (!dealerConfig.accounts.enabled) return Astro.redirect('/', 302);

const email = Astro.url.searchParams.get('email') || '';
const emailMessage = email
  ? `We've sent a verification link to ${email}.`
  : "We've sent a verification link to your email address.";

const title = `Check your email — ${dealerConfig.identity.name}`;
---

<AuthLayout title={title} noindex>
  <section class="mx-auto flex max-w-md flex-col justify-center py-12 md:py-20">
    <div class="glass p-8 text-center">
      <div
        class="mx-auto flex h-16 w-16 items-center justify-center rounded-lg"
        style="background:var(--indigo-glow); box-shadow: inset 0 0 0 1px rgba(85,102,240,0.22)"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-7 w-7 text-indigo"
        >
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <path d="m22 6-10 7L2 6"></path>
        </svg>
      </div>
      <h1 class="mt-6 text-2xl font-bold tracking-tight text-ink">Check your email</h1>
      <p class="mx-auto mt-3 max-w-sm text-ink-soft">{emailMessage}</p>
      <p class="mx-auto mt-2 max-w-sm text-sm text-ink-faint">
        Open the email we just sent and click the verification link to finish setting up your
        account.
      </p>
      <a href="/login" class="btn btn-ghost btn-sm mt-6"> Back to sign in </a>
    </div>
  </section>
</AuthLayout>
