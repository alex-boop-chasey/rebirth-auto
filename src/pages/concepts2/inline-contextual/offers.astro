---
import Layout from './_shell/Layout.astro';
import { icon, offers, brands, BASE } from './_shell/data';
export const prerender = false;
---
<Layout title="Offers & specials — Rebirth Auto">
  <section class="site-container hero-wrap">
    <div class="entry-origin">Reached from the home offers strip · finance page · Rebi</div>
    <span class="eyebrow"><span set:html={icon('tag',13)}></span> Offers</span>
    <h1 style="font-family:var(--font-display); font-size:clamp(30px,4vw,44px); margin:12px 0 10px">Current drive-away deals</h1>
    <p class="lead">Every live special, folded together with finance — the same low-rate offers you'd see on the calculator surface.</p>
    <!-- filter by brand/type as facets, contextual to brand hubs -->
    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:18px">
      <a class="facet is-on" href={`${BASE}/offers`}>All</a>
      {['EV','Ute','Hybrid','Finance'].map((t) => (<a class="facet" href={`${BASE}/offers`}>{t}</a>))}
      <span style="width:1px; background:var(--line); margin:0 4px"></span>
      {brands.slice(0,4).map((b) => (<a class="facet" href={`${BASE}/brand?b=${b.slug}`}>{b.name}</a>))}
    </div>
  </section>

  <section class="site-container section-tight">
    <div class="grid-auto" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,18rem),1fr))">
      {offers.map((o) => (
        <div class="card card-lift" style="padding:20px">
          <div style="display:flex; justify-content:space-between; align-items:start">
            <span class="chip chip-amber">{o.tag}</span>
            <span class="faint" style="font-size:11px">{o.brand}</span>
          </div>
          <b style="display:block; font-family:var(--font-display); font-size:18px; margin:12px 0 4px">{o.title}</b>
          <p class="muted" style="font-size:14px">{o.sub}</p>
          <div style="display:flex; gap:8px; margin-top:14px">
            <a href={`${BASE}/listings`} class="btn btn-primary btn-sm">View stock</a>
            <a href={`${BASE}/finance`} class="btn btn-ghost btn-sm"><span set:html={icon('calc',14)}></span> Repayments</a>
          </div>
        </div>
      ))}
    </div>
    <p class="faint" style="font-size:11.5px; margin-top:18px">*Placeholder offers for demo. Comparison rates and drive-away pricing are illustrative only.</p>
  </section>

  <section class="site-container section">
    <div class="entry-rail">
      <a href={`${BASE}/finance`} class="entry entry--ai"><span class="entry-ic" set:html={icon('calc',18)}></span><span class="entry-tx"><b>Match an offer to repayments</b><span>finance ↔ offers, folded</span></span><span class="entry-go" set:html={icon('arrow',15)}></span></a>
      <button class="entry entry--ai" data-rebi-open style="cursor:pointer; text-align:left"><span class="entry-ic" set:html={icon('spark',18)}></span><span class="entry-tx"><b>Find me a deal that fits</b><span>ask Rebi</span></span><span class="entry-go" set:html={icon('arrow',15)}></span></button>
    </div>
  </section>
</Layout>
