---
/**
 * HubBar — the sibling drill-in strip. Rendered near the top of every page that
 * belongs to a hub, it exposes the hub's other destinations as jump buttons so a
 * shopper can move laterally within a hub without going back to the nav. This is
 * the on-page half of the progressive-disclosure model.
 * Props: hubKey, current (href of the active item, highlighted).
 */
import { hubs, icon } from './data';
interface Props { hubKey: string; current?: string; }
const { hubKey, current } = Astro.props as Props;
const hub = hubs.find((h) => h.key === hubKey)!;
---
<div class="sh-hubbar">
  <a href={hub.href} class="sh-hubbar-label">{hub.label} hub</a>
  <div class="sh-hubbar-items">
    {hub.items.map((it) => (
      <a href={it.href} class={'sh-hubbar-item' + (current === it.href ? ' is-here' : '')}>
        <span set:html={icon(it.icon, 15)}></span> {it.label}
      </a>
    ))}
  </div>
</div>

<style>
  .sh-hubbar {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 12px 16px; border-radius: var(--r-pill);
    background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.7));
    border: 1px solid var(--line); box-shadow: var(--sh-1);
  }
  .sh-hubbar-label { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal-deep); text-decoration: none; white-space: nowrap; }
  .sh-hubbar-items { display: flex; gap: 6px; flex-wrap: wrap; }
  .sh-hubbar-item {
    display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px;
    border-radius: var(--r-pill); font-size: 13px; font-weight: 500; text-decoration: none;
    color: var(--ink-soft); transition: background 0.14s, color 0.14s;
  }
  .sh-hubbar-item span { display: inline-flex; color: var(--ink-faint); }
  .sh-hubbar-item:hover { background: rgba(15,181,166,0.1); color: var(--ink); }
  .sh-hubbar-item.is-here { background: var(--ink); color: #fff; }
  .sh-hubbar-item.is-here span { color: rgba(255,255,255,0.8); }
</style>
