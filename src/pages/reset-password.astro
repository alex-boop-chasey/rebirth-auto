---
/**
 * /reset-password — dual-mode password reset. Gated by accounts.enabled.
 *
 *  1. REQUEST mode (default): an email + Turnstile form calls the
 *     requestPasswordReset action, which emails a reset link back to this page.
 *  2. SET-NEW-PASSWORD mode: the emailed link lands here with a `?code=…`; we
 *     exchange it server-side for a short-lived recovery session, then show a
 *     "set a new password" form calling the updatePassword action (session-gated,
 *     so no Turnstile needed there).
 *
 * Not covered by src/middleware.ts (scoped to /account,/login,/signup), so the
 * recovery session established here is never bounced.
 */
export const prerender = false;

import AuthLayout from '../layouts/AuthLayout.astro';
import { dealerConfig } from '../config/dealer';
import { getSupabase } from '../lib/supabase';

if (!dealerConfig.accounts.enabled) return Astro.redirect('/', 302);

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_USER_TURNSTILE_KEY;

// If the reset link handed us a PKCE code, exchange it for a recovery session so
// the user can set a new password. Fail-open: on any error we fall back to the
// request form with a short notice.
const code = Astro.url.searchParams.get('code');
const linkError = Astro.url.searchParams.get('error_description');
let mode: 'request' | 'update' = 'request';
let exchangeNotice = '';

if (code) {
  try {
    const supabase = getSupabase(Astro.request, Astro.cookies);
    const { error } = await supabase.auth.exchangeCodeForSession(code);
    if (error) {
      exchangeNotice = 'Your reset link is invalid or has expired. Request a new one below.';
    } else {
      mode = 'update';
    }
  } catch {
    exchangeNotice = 'Your reset link could not be verified. Request a new one below.';
  }
} else if (linkError) {
  exchangeNotice = 'Your reset link is invalid or has expired. Request a new one below.';
}

const title = `Reset password — ${dealerConfig.identity.name}`;
const inputClass =
  'w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10';
const labelClass = 'block text-sm font-medium text-slate-700';
const btnClass =
  'relative inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900/30 disabled:cursor-not-allowed disabled:opacity-60';
---

<AuthLayout title={title} noindex>
  <section class="mx-auto flex max-w-md flex-col justify-center py-12 md:py-20">
    <div id="reset-root" data-mode={mode} class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
      <div class="mb-6 text-center">
        <p class="text-base font-semibold tracking-tight text-slate-900">{dealerConfig.identity.name}</p>
        <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900">
          {mode === 'update' ? 'Set a new password' : 'Reset your password'}
        </h1>
        <p class="mt-2 text-sm text-slate-500">
          {
            mode === 'update'
              ? 'Choose a new password for your account.'
              : "Enter your email and we'll send you a reset link."
          }
        </p>
      </div>

      <!-- Shared alert -->
      <div
        id="reset-alert"
        role="alert"
        class="mb-5 hidden items-start gap-2 rounded-xl border px-4 py-3 text-sm"
      >
        <span id="reset-alert-message"></span>
      </div>

      {
        exchangeNotice && (
          <div class="mb-5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            {exchangeNotice}
          </div>
        )
      }

      {
        mode === 'update' ? (
          <form id="update-form" class="grid grid-cols-1 gap-4" novalidate>
            <div>
              <label class={labelClass} for="new-password">
                New password
              </label>
              <input
                type="password"
                id="new-password"
                name="password"
                class={`${inputClass} mt-1.5`}
                autocomplete="new-password"
                placeholder="••••••••"
                required
              />
              <span class="mt-1 block text-xs font-medium text-red-600" id="new-password-error" />
            </div>
            <button type="submit" id="update-btn" class={btnClass}>
              <span id="update-btn-text">Update password</span>
              <span
                id="update-spinner"
                class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"
              />
            </button>
          </form>
        ) : (
          <form id="request-form" class="grid grid-cols-1 gap-4" novalidate>
            <div>
              <label class={labelClass} for="reset-email">
                Email address
              </label>
              <input
                type="email"
                id="reset-email"
                name="email"
                class={`${inputClass} mt-1.5`}
                autocomplete="email"
                placeholder="you@example.com"
                required
              />
              <span class="mt-1 block text-xs font-medium text-red-600" id="reset-email-error" />
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <div class="cf-turnstile" id="turnstile-widget" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light" />
              <span class="text-xs font-medium text-red-600" id="turnstile-error" />
            </div>
            <button type="submit" id="request-btn" class={btnClass}>
              <span id="request-btn-text">Send reset link</span>
              <span
                id="request-spinner"
                class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"
              />
            </button>
          </form>
        )
      }

      <p class="mt-6 text-center text-sm text-slate-500">
        <a href="/login" class="font-semibold text-slate-700 transition hover:text-slate-900">Back to sign in</a>
      </p>
    </div>
  </section>

  {mode === 'request' && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <script>
    import { actions, isActionError } from 'astro:actions';

    const root = document.getElementById('reset-root');
    const mode = root?.getAttribute('data-mode');

    const alertBox = document.getElementById('reset-alert') as HTMLDivElement;
    const alertMessage = document.getElementById('reset-alert-message') as HTMLSpanElement;
    const ALERT_ERROR = ['border-red-200', 'bg-red-50', 'text-red-700'];
    const ALERT_SUCCESS = ['border-emerald-200', 'bg-emerald-50', 'text-emerald-700'];
    const INPUT_ERROR = ['border-red-400', 'ring-2', 'ring-red-200'];

    function showAlert(message: string, type: 'error' | 'success') {
      alertBox.classList.remove('hidden', ...ALERT_ERROR, ...ALERT_SUCCESS);
      alertBox.classList.add('flex', ...(type === 'error' ? ALERT_ERROR : ALERT_SUCCESS));
      alertMessage.textContent = message;
    }
    function clearAlert() {
      alertBox.classList.add('hidden');
      alertBox.classList.remove('flex', ...ALERT_ERROR, ...ALERT_SUCCESS);
      alertMessage.textContent = '';
    }
    function resetTurnstile() {
      if (typeof (window as any).turnstile !== 'undefined') (window as any).turnstile.reset();
    }

    if (mode === 'request') {
      const form = document.getElementById('request-form') as HTMLFormElement;
      const emailInput = document.getElementById('reset-email') as HTMLInputElement;
      const emailError = document.getElementById('reset-email-error') as HTMLSpanElement;
      const turnstileError = document.getElementById('turnstile-error') as HTMLSpanElement;
      const btn = document.getElementById('request-btn') as HTMLButtonElement;
      const btnText = document.getElementById('request-btn-text') as HTMLSpanElement;
      const spinner = document.getElementById('request-spinner') as HTMLSpanElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearAlert();
        emailError.textContent = '';
        turnstileError.textContent = '';
        emailInput.classList.remove(...INPUT_ERROR);

        let ok = true;
        if (!/\S+@\S+\.\S+/.test(emailInput.value)) {
          emailError.textContent = 'Please enter a valid email address.';
          emailInput.classList.add(...INPUT_ERROR);
          ok = false;
        }
        const turnstileToken = new FormData(form).get('cf-turnstile-response') as string;
        if (!turnstileToken) {
          turnstileError.textContent = 'Please complete the security challenge.';
          ok = false;
        }
        if (!ok) return;

        btn.disabled = true;
        btnText.classList.add('opacity-0');
        spinner.classList.remove('hidden');
        try {
          const { data, error } = await actions.requestPasswordReset({
            email: emailInput.value,
            turnstileToken,
          });
          if (error) {
            showAlert(
              isActionError(error) ? error.message : 'Something went wrong. Please try again.',
              'error',
            );
            resetTurnstile();
          } else if (data?.success) {
            showAlert(data.message, 'success');
            form.reset();
            resetTurnstile();
          }
        } catch {
          showAlert('Network error. Please try again.', 'error');
          resetTurnstile();
        } finally {
          btn.disabled = false;
          btnText.classList.remove('opacity-0');
          spinner.classList.add('hidden');
        }
      });
    } else {
      const form = document.getElementById('update-form') as HTMLFormElement;
      const pwInput = document.getElementById('new-password') as HTMLInputElement;
      const pwError = document.getElementById('new-password-error') as HTMLSpanElement;
      const btn = document.getElementById('update-btn') as HTMLButtonElement;
      const btnText = document.getElementById('update-btn-text') as HTMLSpanElement;
      const spinner = document.getElementById('update-spinner') as HTMLSpanElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearAlert();
        pwError.textContent = '';
        pwInput.classList.remove(...INPUT_ERROR);

        if (pwInput.value.length < 6) {
          pwError.textContent = 'Password must be at least 6 characters.';
          pwInput.classList.add(...INPUT_ERROR);
          return;
        }

        btn.disabled = true;
        btnText.classList.add('opacity-0');
        spinner.classList.remove('hidden');
        try {
          const { data, error } = await actions.updatePassword({ password: pwInput.value });
          if (error) {
            showAlert(
              isActionError(error) ? error.message : 'Something went wrong. Please try again.',
              'error',
            );
          } else if (data?.success) {
            showAlert('Password updated — redirecting to sign in…', 'success');
            setTimeout(() => (window.location.href = '/login'), 1200);
          }
        } catch {
          showAlert('Network error. Please try again.', 'error');
        } finally {
          btn.disabled = false;
          btnText.classList.remove('opacity-0');
          spinner.classList.add('hidden');
        }
      });
    }
  </script>
</AuthLayout>
