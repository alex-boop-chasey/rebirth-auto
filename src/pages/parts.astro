---
// SSR (not prerendered): the page posts to /api/parts-enquiry, honours the dealer
// feature flag, and reads `?vehicle=<slug>` to prefill the chosen car from REAL
// inventory. Ported from concepts2/inline-contextual/parts.astro onto the real
// SiteNav/SiteFooter + real data/config. Mirrors sell.astro / test-drive.astro.
export const prerender = false;

import '../styles/global.css';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ChatWidget from '../components/widgets/ChatWidget.astro';
import { client } from '../sanity/lib/client';
import { LISTING_FIELDS, formatPrice, type Listing } from '../lib/listing';
import { dealerConfig } from '../config/dealer';

const cfg = dealerConfig.parts;

// Feature flag — a dealer can hide the parts tool without a deploy.
if (!cfg.enabled) return Astro.redirect('/', 302);

const { copy } = cfg;

// Prefill from `?vehicle=<slug>` — resolve the REAL listing (never invented). A
// missing/unknown slug simply renders the empty "tell us your vehicle" state.
const vehicleSlug = Astro.url.searchParams.get('vehicle');
let vehicle: Listing | null = null;
if (vehicleSlug) {
  vehicle = await client.fetch<Listing | null>(
    `*[_type == "listing" && slug.current == $slug][0]{ ${LISTING_FIELDS} }`,
    { slug: vehicleSlug },
  );
}
const vehicleLabel = vehicle?.title ?? '';

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_USER_TURNSTILE_KEY;

const icon = (name: string, size = 16): string => {
  const s = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"`;
  const p: Record<string, string> = {
    gear: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    spark: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" fill="currentColor" stroke="none"/>',
    send: '<path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4z"/>',
    car: '<path d="M5 11l1.5-4A2 2 0 018.4 6h7.2a2 2 0 011.9 1.3L19 11"/><path d="M4 11h16v5H4z"/><circle cx="7.5" cy="16" r="1.5"/><circle cx="16.5" cy="16" r="1.5"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  };
  return `<svg ${s}>${p[name] ?? ''}</svg>`;
};

const title = `${copy.heading} — ${dealerConfig.identity.name}`;
const description = copy.subheading;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="page-surface min-h-screen antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <SiteNav active="service-parts" />

    <main id="main-content" tabindex="-1">
      <section class="site-container hero-wrap">
        <div class="entry-origin">Reached from a vehicle page ("parts for this model") · service page · footer</div>
        <span class="eyebrow"><span set:html={icon('gear', 13)} /> {copy.eyebrow}</span>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-5xl">{copy.heading}</h1>
        <p class="lead mt-3 max-w-2xl">
          {vehicle ? `Pre-filled for your ${vehicle.title}. ` : ''}{copy.subheading}
        </p>
      </section>

      <section class="site-container parts-layout">
        <div
          id="parts-root"
          data-loading-label={copy.loadingLabel}
          data-vehicle-slug={vehicle?.slug?.current ?? ''}
          data-vehicle-label={vehicleLabel}
          class="card"
          style="padding:26px"
        >
          <h2 class="text-lg font-semibold text-ink" style="margin-bottom:16px">Parts enquiry</h2>

          {vehicle && (
            <a
              href={`/listings/${vehicle.slug?.current}`}
              class="card"
              style="display:flex; gap:12px; padding:10px 12px; align-items:center; text-decoration:none; color:inherit; margin-bottom:20px"
            >
              <span class="entry-ic" style="width:34px; height:34px; border-radius:10px; display:grid; place-items:center; background:var(--mint-glow)" set:html={icon('car', 18)} />
              <span style="flex:1"><b style="font-size:14px">{vehicle.title}</b></span>
              {vehicle.price && (
                <b style="font-size:13.5px">{formatPrice(vehicle.price, vehicle.currency)}</b>
              )}
            </a>
          )}

          <form id="parts-form" novalidate class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="field sm:col-span-1">
              <label class="field-label" for="pt-name">Your name</label>
              <input class="field-input" id="pt-name" name="name" type="text" required
                autocomplete="name" placeholder="e.g. Jordan Smith" />
            </div>
            <div class="field sm:col-span-1">
              <label class="field-label" for="pt-contact">Email or phone</label>
              <input class="field-input" id="pt-contact" name="contact" type="text" required
                autocomplete="email" placeholder="you@example.com or 0400 000 000" />
            </div>
            <div class="field sm:col-span-2">
              <label class="field-label" for="pt-vehicle">Your vehicle</label>
              <input class="field-input" id="pt-vehicle" name="vehicle" type="text" required
                autocomplete="off" value={vehicleLabel}
                placeholder="Make / model / year — e.g. Isuzu D-MAX 2021" />
            </div>
            <div class="field sm:col-span-2">
              <label class="field-label" for="pt-part">Part needed</label>
              <input class="field-input" id="pt-part" name="part" type="text" required
                autocomplete="off" placeholder="e.g. front brake pads, tow bar, roof racks" />
            </div>
            <div class="field sm:col-span-2">
              <label class="field-label" for="pt-notes">Anything else? <span class="faint">(optional)</span></label>
              <textarea class="field-textarea" id="pt-notes" name="notes" rows="3"
                placeholder="VIN, rego, or any detail that helps us confirm fitment."></textarea>
            </div>

            {TURNSTILE_SITE_KEY && (
              <div class="sm:col-span-2">
                <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>
              </div>
            )}

            <div class="sm:col-span-2">
              <button
                type="submit"
                id="pt-submit"
                class="btn btn-primary w-full justify-center disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
              >
                <span class="mr-1.5 inline-flex" set:html={icon('send', 15)} />
                <span id="pt-submit-label">{copy.submitLabel}</span>
              </button>
              <p class="faint mt-3 text-xs leading-relaxed">{copy.disclaimer}</p>
            </div>
          </form>

          <p id="pt-error" role="alert" hidden
            class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></p>

          <div id="pt-success" hidden aria-live="polite" class="ai-summary mt-8">
            <p id="pt-success-text" class="text-sm font-medium text-ink"></p>
          </div>
        </div>

        <aside class="stack" style="gap:14px; position:sticky; top:92px">
          <div class="ai-summary" style="padding:20px">
            <div style="display:flex; gap:9px; align-items:center; margin-bottom:8px">
              <span class="orb" style="width:22px;height:22px"></span>
              <b style="color:var(--indigo-deep); font-size:13px">Ask Rebi</b>
            </div>
            <p style="font-size:13.5px">Not sure a part fits? Ask Rebi to check it against your vehicle before you enquire.</p>
            <button class="btn btn-ghost btn-sm" data-rebi-open data-rebi-kind="parts" style="margin-top:10px; cursor:pointer">
              <span class="mr-1.5 inline-flex" set:html={icon('spark', 14)} /> Check a part for my vehicle
            </button>
          </div>
          <!-- parts → service fold -->
          <a href="/service" class="entry">
            <span class="entry-ic" set:html={icon('clock', 18)} />
            <span class="entry-tx"><b>Want it fitted?</b><span>book a service</span></span>
            <span class="entry-go" set:html={icon('arrow', 15)} />
          </a>
        </aside>
      </section>
    </main>

    <SiteFooter />
    <ChatWidget />

    {TURNSTILE_SITE_KEY && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}

    <script>
      const root = document.getElementById('parts-root');
      const form = document.getElementById('parts-form') as HTMLFormElement | null;
      if (root && form) {
        const loadingLabel = root.dataset.loadingLabel || 'Sending your enquiry…';
        const vehicleSlug = root.dataset.vehicleSlug || '';

        const submit = document.getElementById('pt-submit') as HTMLButtonElement;
        const submitLabel = document.getElementById('pt-submit-label') as HTMLElement;
        const defaultLabel = submitLabel.textContent || 'Send enquiry';
        const errorEl = document.getElementById('pt-error') as HTMLElement;
        const successEl = document.getElementById('pt-success') as HTMLElement;
        const successText = document.getElementById('pt-success-text') as HTMLElement;

        const showError = (msg: string) => {
          errorEl.textContent = msg;
          errorEl.hidden = false;
          successEl.hidden = true;
        };
        const setLoading = (on: boolean) => {
          submit.disabled = on;
          submitLabel.textContent = on ? loadingLabel : defaultLabel;
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorEl.hidden = true;

          const data = new FormData(form);
          const payload = {
            name: String(data.get('name') || '').trim(),
            contact: String(data.get('contact') || '').trim(),
            vehicle: String(data.get('vehicle') || '').trim(),
            vehicleSlug: vehicleSlug || null,
            part: String(data.get('part') || '').trim(),
            notes: String(data.get('notes') || '').trim(),
            turnstileToken: String(data.get('cf-turnstile-response') || ''),
          };

          if (!payload.name) return showError('Please enter your name.');
          if (!payload.contact) return showError('Please enter an email or phone number.');
          if (!payload.vehicle) return showError('Please tell us about your vehicle.');
          if (!payload.part) return showError('Please tell us which part you need.');

          setLoading(true);
          try {
            const res = await fetch('/api/parts-enquiry', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const body = (await res.json()) as { ok?: boolean; message?: string; error?: string };
            if (!res.ok || !body.ok) {
              showError(body.error || 'We could not send that enquiry right now — please try again.');
              return;
            }
            successText.textContent =
              body.message || "Thanks — we've received your enquiry and will be in touch.";
            successEl.hidden = false;
            form.reset();
            if (typeof (window as any).turnstile !== 'undefined') (window as any).turnstile.reset();
            successEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } catch {
            showError('Something went wrong — please check your connection and try again.');
          } finally {
            setLoading(false);
          }
        });
      }
    </script>

    <style>
      .parts-layout {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 26px;
        align-items: start;
        padding-bottom: 44px;
      }
      @media (max-width: 820px) {
        .parts-layout { grid-template-columns: 1fr; }
        .parts-layout aside { position: static !important; }
      }
      .field { display: flex; flex-direction: column; gap: 7px; }
      .field-label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
      .field-input,
      .field-textarea {
        width: 100%;
        font-family: var(--font-ui);
        font-size: 15px;
        color: var(--ink);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
        transition: border-color 0.16s, box-shadow 0.16s;
      }
      .field-input::placeholder,
      .field-textarea::placeholder { color: var(--ink-faint); }
      .field-input:focus,
      .field-textarea:focus {
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(15, 181, 166, 0.15);
        outline: none;
      }
      .field-textarea { resize: vertical; min-height: 96px; }
    </style>
  </body>
</html>
