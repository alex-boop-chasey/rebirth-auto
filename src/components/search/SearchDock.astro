---
/**
 * SearchDock — the Rebi-fronted plain-English homepage search entry point.
 * ------------------------------------------------------------------
 * A JS-ONLY enhancement layered on the hero. With no JS it stays hidden and the
 * classic Filters drawer (#filters-trigger + <FilterDrawer>) is the fallback
 * (Lens 1). On submit it POSTs /api/search, drives the ONE filter URL via the
 * shared `applyFilterUrl` (URL = single source of truth, Decision 5), and speaks
 * back on a cinematic "Focus Stage": a 3D theatre where each turn (your message,
 * Rebi's reply) slides up and recedes behind a frosted glass shelf as the
 * conversation continues. Newest card is large + sharp at the front; older turns
 * scale down, blur and tuck away. Rebi's replies materialise word-by-word with a
 * warm dual-tone notification chime; your messages send with a bright blip.
 *
 * The stage is always visible and greets the shopper on load (config-gated). It
 * does NOT open or prime the corner Rebi widget. Grid-driving is homepage-fenced
 * by construction: the dock only exists on the homepage, and #inventory-results
 * is only there.
 */
import { dealerConfig } from '../../config/dealer';

const { placeholders, typewriter, messages, greeting, sounds, stage, maxQueryLength } =
  dealerConfig.chat.search;
// Config → client, so a tenant swap restyles copy/timings/sounds without code edits.
const dockConfig = JSON.stringify({
  placeholders,
  typewriter,
  messages,
  greeting,
  sounds,
  stage,
  maxQueryLength,
});
---

<div id="search-dock" class="search-dock" data-config={dockConfig} hidden>
  <section class="rebi-stage" aria-label={stage.askLabel}>
    <!-- Sound toggle sits on the glass shelf, top-right. Initial state assumes
         sounds ON (not muted); the script reconciles from localStorage on load. -->
    <button
      type="button"
      class="sound-toggle"
      id="search-dock-sound"
      aria-pressed="false"
      aria-label={stage.muteLabel}
      title={stage.muteLabel}
    >
      <svg class="ic-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z"></path>
        <path d="M16.5 8.5a5 5 0 0 1 0 7"></path>
        <path d="M19 6a8 8 0 0 1 0 12"></path>
      </svg>
      <svg class="ic-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z"></path>
        <path d="M17 9l4 6M21 9l-4 6"></path>
      </svg>
    </button>

    <!-- The 3D theatre. The card column is built entirely at runtime; it carries
         NO aria-live (that would spam every reveal frame) — a dedicated polite
         region below announces the complete reply once. -->
    <div class="stage-viewport">
      <div class="glass-shelf" aria-hidden="true"></div>
      <div class="shelf-label" aria-hidden="true"><span class="dotmark"></span>{stage.shelfLabel}</div>
      <div class="card-column" id="search-dock-column"></div>
    </div>

    <form id="search-dock-form" class="entry" role="search" autocomplete="off">
      <span class="mag" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path>
        </svg>
      </span>
      <input
        id="search-dock-input"
        class="search-dock-input"
        type="text"
        name="q"
        aria-label={stage.inputAriaLabel}
        maxlength={maxQueryLength}
      />
      <button id="search-dock-submit" class="search-dock-submit" type="submit">
        <span>{stage.askLabel}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h13"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </form>

    <p class="hint">
      {stage.hint}
      <button type="button" id="search-dock-manual" class="search-dock-manual">{stage.refineManualLabel}</button>
    </p>

    <!-- One polite region: the COMPLETE reply text, set once per landed card. -->
    <p id="search-dock-live" class="sd-sr-only" aria-live="polite"></p>
  </section>
</div>

<style>
  /* ================= Focus Stage — static structural styles =================
     Everything here is on nodes present in the .astro markup, so Astro's
     scope-hash confines it. Runtime-built card nodes (.turn/.card/.bubble/…)
     get their styles from the is:global block below, namespaced under
     #search-dock. */

  .search-dock { margin: 1.75rem auto 0; max-width: 40rem; }
  .search-dock[hidden] { display: none; }

  /* Brand tokens live LOCALLY on the stage (not :root) so nothing leaks and the
     runtime cards inherit them down the cascade. */
  .rebi-stage {
    --rebi-blue: rgb(1 97 239);
    --rebi-blue-hover: rgb(1 84 207);
    --rebi-grad: linear-gradient(135deg, rgb(1 97 239), rgb(109 40 217));
    --ink: rgb(15 23 42);
    --muted: rgb(100 116 139);

    position: relative;
    width: 100%;
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
    color: var(--ink);
  }

  /* the 3D theatre where cards recede */
  .stage-viewport {
    position: relative;
    height: 20rem;
    perspective: 1200px;
    perspective-origin: 50% 120%;
    overflow: hidden;
    /* fade the very top so receding cards dissolve into nothing above the shelf */
    -webkit-mask-image: linear-gradient(180deg, transparent 0, rgb(0 0 0 / 0.35) 8%, #000 26%);
    mask-image: linear-gradient(180deg, transparent 0, rgb(0 0 0 / 0.35) 8%, #000 26%);
  }

  /* the frosted "glass shelf" — cards physically tuck behind this strip */
  .glass-shelf {
    position: absolute; inset: 0 0 auto 0;
    height: 4.75rem;
    pointer-events: none;
    z-index: 5;
    background: linear-gradient(180deg,
      rgb(248 250 252 / 0.92) 0%,
      rgb(248 250 252 / 0.74) 42%,
      rgb(248 250 252 / 0) 100%);
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
    -webkit-mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
  }
  .glass-shelf::after {
    content: "";
    position: absolute; left: 8%; right: 8%; bottom: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgb(1 97 239 / 0.35), rgb(109 40 217 / 0.3), transparent);
  }
  .shelf-label {
    position: absolute; top: 0.55rem; left: 50%; transform: translateX(-50%);
    z-index: 6; pointer-events: none;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgb(100 116 139 / 0.8);
    display: flex; align-items: center; gap: 0.4rem;
  }
  .shelf-label .dotmark {
    width: 0.4rem; height: 0.4rem; border-radius: 9999px; background: var(--rebi-grad);
  }

  /* the moving column of cards, absolutely anchored to the bottom of the viewport */
  .card-column { position: absolute; inset: 0; }

  /* ---------- minimal underline entry (the bottom slot) ---------- */
  .entry {
    margin-top: 1rem;
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.4rem 0.55rem 0.9rem;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 0.7);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    border: 1px solid transparent;
    border-bottom: 2px solid rgb(1 97 239 / 0.3);
    transition: border-color 200ms ease, background 200ms ease;
  }
  .entry:focus-within {
    border-bottom-color: var(--rebi-blue);
    background: rgb(255 255 255 / 0.92);
  }
  .entry .mag { flex: none; color: var(--muted); display: grid; place-items: center; }
  .entry .mag svg { width: 1.15rem; height: 1.15rem; }
  .search-dock-input {
    flex: 1; border: 0; background: transparent; outline: none;
    font-family: inherit; font-size: 1.02rem; color: var(--ink);
    min-width: 0; padding: 0.35rem 0;
  }
  .search-dock-input::placeholder { color: var(--muted); }
  .search-dock-submit {
    flex: none;
    display: inline-flex; align-items: center; gap: 0.35rem;
    border: 0; cursor: pointer;
    font-family: inherit; font-weight: 700; font-size: 0.9rem; color: #fff;
    background: var(--rebi-blue);
    padding: 0.5rem 0.95rem; border-radius: 9999px;
    transition: background 160ms ease, transform 120ms ease;
  }
  .search-dock-submit:hover { background: var(--rebi-blue-hover); }
  .search-dock-submit:active { transform: scale(0.96); }
  .search-dock-submit:focus-visible { outline: 2px solid #0f172a; outline-offset: 2px; }
  .search-dock-submit svg { width: 0.95rem; height: 0.95rem; }

  /* ---------- sound toggle (sits on the glass shelf, top-right) ---------- */
  .sound-toggle {
    position: absolute; top: 0.5rem; right: 0.5rem; z-index: 7;
    width: 1.95rem; height: 1.95rem; border-radius: 9999px;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid rgb(1 97 239 / 0.18);
    background: rgb(255 255 255 / 0.7);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    color: var(--muted); cursor: pointer;
    box-shadow: 0 4px 12px -6px rgb(15 23 42 / 0.25);
    transition: color 160ms ease, background 160ms ease, transform 120ms ease;
  }
  .sound-toggle:hover { color: var(--rebi-blue); background: rgb(255 255 255 / 0.92); }
  .sound-toggle:active { transform: scale(0.92); }
  .sound-toggle:focus-visible { outline: 2px solid #0f172a; outline-offset: 2px; }
  .sound-toggle svg { width: 1.05rem; height: 1.05rem; }
  .sound-toggle .ic-off { display: none; }
  .sound-toggle.muted .ic-on { display: none; }
  .sound-toggle.muted .ic-off { display: inline; }

  .hint {
    margin: 0.65rem 0 0; text-align: center;
    font-size: 0.78rem; color: var(--muted);
  }
  .search-dock-manual {
    background: none; border: none; padding: 0;
    color: var(--rebi-blue); font: inherit; font-weight: 600; cursor: pointer;
    text-decoration: underline; text-underline-offset: 2px;
  }

  /* Visually-hidden live region (announces the complete reply once). */
  .sd-sr-only {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); border: 0;
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .stage-viewport { height: 17rem; }
    .search-dock-submit span { display: none; }
    .search-dock-submit { padding: 0.5rem 0.6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry, .search-dock-submit, .sound-toggle { transition: none; }
  }
</style>

<!--
  Runtime-built card nodes never receive Astro's scoped-style hash, so their
  rules must be global. Every selector below is namespaced under the unique
  #search-dock id — zero leakage, and no collision with the corner ChatWidget's
  own .reb-*/.card classes.
-->
<style is:global>
  /* each turn is a card, anchored to the bottom, transformed by its depth */
  #search-dock .card-column .turn {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    display: flex;
    transform-origin: 50% 100%;
    transition:
      transform 560ms cubic-bezier(0.22, 0.61, 0.30, 1),
      opacity 560ms cubic-bezier(0.22, 0.61, 0.30, 1),
      filter 560ms cubic-bezier(0.22, 0.61, 0.30, 1);
    will-change: transform, opacity, filter;
  }
  #search-dock .card-column .turn.rebi { justify-content: flex-start; }
  #search-dock .card-column .turn.user { justify-content: flex-end; }

  #search-dock .card-column .card {
    position: relative;
    max-width: 86%;
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }

  #search-dock .card-column .avatar {
    flex: none;
    width: 2.5rem; height: 2.5rem; border-radius: 9999px;
    background: var(--rebi-grad);
    display: grid; place-items: center;
    color: #fff;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.92), 0 8px 20px -8px rgb(1 97 239 / 0.55);
  }
  #search-dock .card-column .avatar svg { width: 1.35rem; height: 1.35rem; }

  #search-dock .card-column .bubble {
    position: relative;
    border-radius: 1.25rem;
    padding: 0.8rem 1.05rem;
    font-size: 1.02rem;
    line-height: 1.5;
    letter-spacing: -0.005em;
  }
  /* Rebi bubble — frosted light, blue-tinted ring, squared bottom-left tail */
  #search-dock .card-column .turn.rebi .bubble {
    background: rgb(255 255 255 / 0.94);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    border: 1px solid rgb(1 97 239 / 0.22);
    border-bottom-left-radius: 0.4rem;
    color: var(--ink);
    box-shadow: 0 18px 40px -20px rgb(1 97 239 / 0.35), 0 2px 6px -2px rgb(15 23 42 / 0.08);
  }
  #search-dock .card-column .turn.rebi .name {
    display: block;
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.09em;
    text-transform: uppercase; color: var(--rebi-blue);
    margin-bottom: 0.2rem;
  }
  /* User bubble — Rebi-blue, white text, squared bottom-right tail */
  #search-dock .card-column .turn.user .bubble {
    background: var(--rebi-blue);
    color: #fff;
    border-bottom-right-radius: 0.4rem;
    box-shadow: 0 16px 34px -18px rgb(1 97 239 / 0.6);
  }
  #search-dock .card-column .bubble .count { font-weight: 800; }

  /* word-by-word reveal */
  #search-dock .card-column .word {
    opacity: 0; display: inline-block; transform: translateY(0.25em);
    transition: opacity 260ms ease, transform 260ms ease;
  }
  #search-dock .card-column .word.lit { opacity: 1; transform: none; }

  /* typing dots card */
  #search-dock .card-column .dots { display: inline-flex; gap: 0.28rem; padding: 0.15rem 0.1rem; }
  #search-dock .card-column .dots i {
    width: 0.42rem; height: 0.42rem; border-radius: 9999px;
    background: var(--rebi-blue); display: inline-block;
    animation: sd-blink 1.1s infinite ease-in-out;
  }
  #search-dock .card-column .dots i:nth-child(2) { animation-delay: 0.2s; }
  #search-dock .card-column .dots i:nth-child(3) { animation-delay: 0.4s; }
  @keyframes sd-blink {
    0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-0.12rem); }
  }

  /* the "New search" action inside a results reply */
  #search-dock .card-column .actions { margin-top: 0.7rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  #search-dock .card-column .newsearch {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font: inherit; font-size: 0.85rem; font-weight: 600; cursor: pointer;
    background: var(--rebi-blue); color: #fff; border: none; border-radius: 9999px;
    padding: 0.5rem 1rem;
    box-shadow: 0 8px 18px -8px rgb(1 97 239 / 0.6);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  #search-dock .card-column .newsearch:hover { background: rgb(1 84 207); transform: translateY(-1px); }
  #search-dock .card-column .newsearch:focus-visible { outline: 2px solid rgb(109 40 217); outline-offset: 2px; }
  #search-dock .card-column .newsearch svg { width: 0.95rem; height: 0.95rem; }

  @media (max-width: 420px) {
    #search-dock .card-column .bubble { font-size: 0.96rem; padding: 0.7rem 0.9rem; }
    #search-dock .card-column .card { max-width: 92%; }
    #search-dock .card-column .avatar { width: 2.15rem; height: 2.15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* opacity-only under reduced motion: no translate/scale/blur transitions */
    #search-dock .card-column .turn { transition: opacity 200ms linear; }
    #search-dock .card-column .word { transition: none; opacity: 1; transform: none; }
    #search-dock .card-column .dots i { animation: none; opacity: 0.6; }
    #search-dock .card-column .newsearch { transition: none; }
  }
</style>

<script>
  import { applyFilterUrl } from '../../lib/client/filter-url';
  import {
    parseFilters,
    hrefFor,
    hasActiveFilters,
    type FilterState,
  } from '../../lib/listings-query';

  const dock = document.getElementById('search-dock');
  const form = document.getElementById('search-dock-form') as HTMLFormElement | null;
  const input = document.getElementById('search-dock-input') as HTMLInputElement | null;
  const submit = document.getElementById('search-dock-submit') as HTMLButtonElement | null;
  const column = document.getElementById('search-dock-column');
  const soundToggle = document.getElementById('search-dock-sound') as HTMLButtonElement | null;
  const live = document.getElementById('search-dock-live');
  const subhead = document.getElementById('hero-subhead');
  const manualBtn = document.getElementById('search-dock-manual');

  if (dock && form && input && submit && column && soundToggle && live) {
    // Reveal the dock — it's a JS-only enhancement (no-JS keeps the drawer).
    dock.hidden = false;

    type DockConfig = {
      placeholders: string[];
      typewriter: { typeMs: number; deleteMs: number; dwellMs: number };
      messages: {
        finding: string;
        resultsRefine: string;
        noMatch: string;
        unclear: string;
        newSearchLabel: string;
      };
      greeting: { showOnLoad: boolean; text: string };
      sounds: { enabled: boolean; defaultMuted: boolean };
      stage: {
        askLabel: string;
        shelfLabel: string;
        hint: string;
        refineManualLabel: string;
        inputAriaLabel: string;
        muteLabel: string;
        unmuteLabel: string;
      };
      maxQueryLength: number;
    };
    let cfg: DockConfig = {
      placeholders: [],
      typewriter: { typeMs: 45, deleteMs: 25, dwellMs: 1800 },
      messages: {
        finding: 'Finding your results…',
        resultsRefine: 'Here are your {count} matches — tell me more to narrow it down, or start a new search.',
        noMatch: 'Nothing matched that one — try describing it a different way.',
        unclear: "I couldn't quite pin that down — try adding a budget, body type, or fuel type.",
        newSearchLabel: 'New search',
      },
      greeting: { showOnLoad: true, text: "G'day — I'm Rebi. Tell me what you're after and I'll comb the lot for you." },
      sounds: { enabled: true, defaultMuted: false },
      stage: {
        askLabel: 'Ask Rebi',
        shelfLabel: 'earlier',
        hint: 'Ask in plain English — Rebi reads your search and lines up the matches.',
        refineManualLabel: 'Refine manually',
        inputAriaLabel: "Describe the car you're looking for",
        muteLabel: 'Mute notification sounds',
        unmuteLabel: 'Unmute notification sounds',
      },
      maxQueryLength: 300,
    };
    try {
      const raw = dock.getAttribute('data-config');
      if (raw) cfg = { ...cfg, ...JSON.parse(raw) };
    } catch { /* keep defaults */ }

    const REDUCED_MOTION = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

    // The hero subhead fades (kept in layout → nothing shifts) while a search is
    // active, giving the stage clean room. Motion-safe: opacity only.
    if (subhead && !REDUCED_MOTION) subhead.style.transition = 'opacity 0.3s ease';
    const setActive = (on: boolean) => {
      if (subhead) subhead.style.opacity = on ? '0' : '';
    };

    // ================= Cycling typewriter placeholder =================
    // Pauses while the field is focused or has text; resumes on blur of an empty
    // field. Purely a placeholder — never touches the input's real value.
    let twTimer: ReturnType<typeof setTimeout> | null = null;
    let phraseIdx = 0;
    let charIdx = 0;
    let deleting = false;
    const clearTw = () => { if (twTimer) { clearTimeout(twTimer); twTimer = null; } };

    const twTick = () => {
      const phrases = cfg.placeholders;
      if (!phrases.length || document.activeElement === input || input.value) return;
      const phrase = phrases[phraseIdx % phrases.length];
      if (!deleting) {
        charIdx++;
        input.placeholder = phrase.slice(0, charIdx);
        if (charIdx >= phrase.length) {
          deleting = true;
          twTimer = setTimeout(twTick, cfg.typewriter.dwellMs);
          return;
        }
        twTimer = setTimeout(twTick, cfg.typewriter.typeMs);
      } else {
        charIdx--;
        input.placeholder = phrase.slice(0, Math.max(0, charIdx));
        if (charIdx <= 0) {
          deleting = false;
          phraseIdx++;
        }
        twTimer = setTimeout(twTick, cfg.typewriter.deleteMs);
      }
    };
    const startTw = () => {
      clearTw();
      charIdx = 0;
      deleting = false;
      if (REDUCED_MOTION || !cfg.placeholders.length) {
        input.placeholder = cfg.placeholders[0] ?? 'Describe the car you’re looking for…';
        return;
      }
      twTimer = setTimeout(twTick, 400);
    };
    input.addEventListener('focus', () => { clearTw(); if (!input.value) input.placeholder = 'Describe the car you’re looking for…'; });
    input.addEventListener('blur', () => { if (!input.value) startTw(); });
    startTw();

    // ================= Notification sounds (Web Audio) =================
    // No audio files — every tone is synthesised from oscillators. Two distinct
    // dual-tone signatures: a bright rising blip when YOU send, a warm rounded
    // ping when Rebi replies. The AudioContext is created/resumed lazily on the
    // first gesture (submit or the toggle) — never on load.
    type Note = { f: number; type?: OscillatorType; t?: number; dur?: number; gain?: number; slideTo?: number };
    let audioCtx: AudioContext | null = null;

    const MUTE_KEY = 'rebi:search:muted';
    let muted: boolean = cfg.sounds.defaultMuted;
    try {
      const stored = localStorage.getItem(MUTE_KEY);
      if (stored !== null) muted = stored === '1';
    } catch { /* private mode / no storage — fall back to config default */ }

    const ac = (): AudioContext | null => {
      if (!audioCtx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        if (AC) { try { audioCtx = new AC(); } catch { audioCtx = null; } }
      }
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
      return audioCtx;
    };
    const blip = (notes: Note[]) => {
      if (!cfg.sounds.enabled || muted) return; // master switch + user mute
      let ctx: AudioContext | null = null;
      try { ctx = ac(); } catch { ctx = null; }
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        notes.forEach((n) => {
          const start = now + (n.t || 0);
          const dur = n.dur || 0.14;
          const peak = n.gain == null ? 0.12 : n.gain;
          const osc = ctx!.createOscillator();
          const g = ctx!.createGain();
          osc.type = n.type || 'sine';
          osc.frequency.setValueAtTime(n.f, start);
          if (n.slideTo) osc.frequency.exponentialRampToValueAtTime(n.slideTo, start + dur);
          g.gain.setValueAtTime(0.0001, start);
          g.gain.exponentialRampToValueAtTime(peak, start + 0.012);
          g.gain.exponentialRampToValueAtTime(0.0001, start + dur);
          osc.connect(g); g.connect(ctx!.destination);
          osc.start(start);
          osc.stop(start + dur + 0.04);
        });
      } catch { /* unsupported browser — degrade silently */ }
    };
    // YOU send: bright, snappy, rising fifth + shimmer — "sent!"
    const soundSend = () => blip([
      { f: 523.25, type: 'triangle', t: 0.0, dur: 0.11, gain: 0.13, slideTo: 783.99 }, // C5 → G5
      { f: 1046.5, type: 'sine', t: 0.03, dur: 0.09, gain: 0.05 },                       // C6 shimmer
    ]);
    // REBI replies: warm rounded two-note ping with a soft undertone — "incoming"
    const soundRebi = () => blip([
      { f: 174.61, type: 'sine', t: 0.0, dur: 0.34, gain: 0.05 }, // F3 warm body
      { f: 659.25, type: 'sine', t: 0.0, dur: 0.20, gain: 0.11 }, // E5
      { f: 987.77, type: 'sine', t: 0.12, dur: 0.24, gain: 0.10 }, // B5 (lifts a fifth)
    ]);

    const reflectMute = () => {
      soundToggle.classList.toggle('muted', muted);
      soundToggle.setAttribute('aria-pressed', String(muted));
      const label = muted ? cfg.stage.unmuteLabel : cfg.stage.muteLabel;
      soundToggle.setAttribute('aria-label', label);
      soundToggle.setAttribute('title', label);
    };
    reflectMute();
    soundToggle.addEventListener('click', () => {
      muted = !muted;
      try { localStorage.setItem(MUTE_KEY, muted ? '1' : '0'); } catch { /* ignore */ }
      reflectMute();
      if (!muted) { ac(); soundRebi(); } // this click is a gesture: unlock + preview
    });

    // ================= The Focus Stage depth engine =================
    // Newest card = depth 0 (front, sharp, at the bottom). Older cards recede
    // up + back, blurring and fading, tucking behind the shelf.
    const AVATAR =
      '<span class="avatar" aria-hidden="true">' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" ' +
      'stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M12 3.6v1.8"></path>' +
      '<circle cx="12" cy="2.7" r="1" fill="currentColor" stroke="none"></circle>' +
      '<rect x="4.5" y="6" width="15" height="12" rx="3.6"></rect>' +
      '<circle cx="9.2" cy="12" r="1.25" fill="currentColor" stroke="none"></circle>' +
      '<circle cx="14.8" cy="12" r="1.25" fill="currentColor" stroke="none"></circle>' +
      '<path d="M9.6 15.3h4.8"></path>' +
      '<path d="M2.6 10.6v2.8"></path>' +
      '<path d="M21.4 10.6v2.8"></path>' +
      '</svg></span>';
    const REFRESH_ICON =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ' +
      'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
      '<path d="M3 2v6h6"></path><path d="M3.5 8a9 9 0 1 1-1 5"></path></svg>';

    const turns: HTMLElement[] = []; // newest last

    // Remove a card from the DOM AND from turns[] atomically (guards double-splice
    // so turns[] never leaks detached nodes — the design-critic fix).
    const retire = (node: HTMLElement) => {
      const idx = turns.indexOf(node);
      if (idx !== -1) turns.splice(idx, 1);
      if (node.parentNode) node.parentNode.removeChild(node);
    };

    const layout = () => {
      const n = turns.length;
      for (let i = 0; i < n; i++) {
        const el = turns[i];
        const depth = n - 1 - i; // 0 = newest/front
        const lift = depth * 4.35; // rem up per step
        const push = depth * -78; // px back in Z
        const scale = Math.max(0.62, 1 - depth * 0.11);
        const blur = Math.min(6, depth * 2.1);
        const op = depth >= 4 ? 0 : Math.max(0, 1 - depth * 0.26);
        if (REDUCED_MOTION) {
          // opacity only — no translate/scale/blur
          el.style.transform = 'none';
          el.style.filter = 'none';
        } else {
          el.style.transform = 'translateY(-' + lift + 'rem) translateZ(' + push + 'px) scale(' + scale + ')';
          el.style.filter = blur ? 'blur(' + blur + 'px)' : 'none';
        }
        el.style.opacity = String(op);
        el.style.zIndex = String(100 + i);
        // once fully receded, retire it (DOM + turns[]) to stay light
        if (op === 0 && depth > 4) {
          const node = el;
          setTimeout(() => retire(node), REDUCED_MOTION ? 220 : 620);
        }
      }
    };

    // set a card's "just-born" state inline (inline styles beat CSS classes)
    const seatEnter = (turn: HTMLElement) => {
      turn.style.opacity = '0';
      if (REDUCED_MOTION) {
        turn.style.transform = 'none';
        turn.style.filter = 'none';
      } else {
        turn.style.transform = 'translateY(2.5rem) scale(.9)';
        turn.style.filter = 'blur(4px)';
      }
    };
    // force reflow, then settle everyone into their depth on the next frame
    const birth = (turn: HTMLElement) => {
      void turn.offsetWidth;
      requestAnimationFrame(() => requestAnimationFrame(layout));
    };

    // ---- reply descriptor → safe DOM (never raw innerHTML for dynamic text) ----
    type ReplyKind = 'greeting' | 'results' | 'nomatch' | 'unclear';
    type Descriptor = { kind: ReplyKind; text: string; count: number };

    const splitWords = (s: string): string[] => s.split(/(\s+)/).filter((t) => t.length > 0);

    // Tokenise a descriptor into ordered {text, count?} chunks + the plain string.
    const tokensFor = (d: Descriptor): { toks: { text: string; count?: boolean }[]; plain: string } => {
      if (d.kind === 'results') {
        const parts = d.text.split('{count}');
        const before = parts[0] ?? '';
        const after = parts[1] ?? '';
        const countStr = String(d.count);
        const toks: { text: string; count?: boolean }[] = [];
        splitWords(before).forEach((t) => toks.push({ text: t }));
        toks.push({ text: countStr, count: true });
        splitWords(after).forEach((t) => toks.push({ text: t }));
        return { toks, plain: before + countStr + after };
      }
      return { toks: splitWords(d.text).map((t) => ({ text: t })), plain: d.text };
    };

    // Fill a .body element with word spans (or plain, reduced-motion). Server text
    // and the count go in via textContent — NEVER innerHTML. Visual words are
    // aria-hidden; the live region carries the complete text for AT.
    const renderBody = (body: HTMLElement, d: Descriptor): { wordSpans: HTMLElement[]; plain: string } => {
      const { toks, plain } = tokensFor(d);
      const wordSpans: HTMLElement[] = [];
      toks.forEach((tok) => {
        if (/^\s+$/.test(tok.text)) {
          body.appendChild(document.createTextNode(tok.text));
          return;
        }
        const span = document.createElement('span');
        span.className = 'word' + (tok.count ? ' count' : '');
        span.textContent = tok.text;
        span.setAttribute('aria-hidden', 'true'); // visual only
        if (REDUCED_MOTION) span.classList.add('lit'); // fully visible at once
        body.appendChild(span);
        wordSpans.push(span);
      });
      return { wordSpans, plain };
    };

    const makeTurn = (kind: 'rebi' | 'user'): { turn: HTMLElement; card: HTMLElement } => {
      const turn = document.createElement('div');
      turn.className = 'turn ' + kind;
      const card = document.createElement('div');
      card.className = 'card';
      turn.appendChild(card);
      return { turn, card };
    };

    // Build (but do not seat) a Rebi reply card from a descriptor.
    const buildRebiCard = (d: Descriptor): { turn: HTMLElement; wordSpans: HTMLElement[]; plain: string } => {
      const { turn, card } = makeTurn('rebi');
      card.insertAdjacentHTML('afterbegin', AVATAR); // trusted static markup
      const bub = document.createElement('div');
      bub.className = 'bubble';
      const name = document.createElement('span');
      name.className = 'name';
      name.textContent = 'Rebi';
      const body = document.createElement('span');
      body.className = 'body';
      const { wordSpans, plain } = renderBody(body, d);
      bub.appendChild(name);
      bub.appendChild(body);
      card.appendChild(bub);
      if (d.kind === 'results') {
        const actions = document.createElement('div');
        actions.className = 'actions';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'newsearch';
        btn.innerHTML = REFRESH_ICON; // trusted static icon
        btn.appendChild(document.createTextNode(cfg.messages.newSearchLabel));
        btn.addEventListener('click', resetSearch);
        actions.appendChild(btn);
        bub.appendChild(actions);
      }
      return { turn, wordSpans, plain };
    };

    // Seat a Rebi reply card onto the stack (append → born → reveal → announce).
    const appendRebi = (d: Descriptor): HTMLElement => {
      const built = buildRebiCard(d);
      column.appendChild(built.turn);
      turns.push(built.turn);
      seatEnter(built.turn);
      birth(built.turn);
      if (!REDUCED_MOTION) revealWords(built.wordSpans);
      live.textContent = built.plain;
      return built.turn;
    };

    const addUserTurn = (text: string): HTMLElement => {
      const { turn, card } = makeTurn('user');
      const bub = document.createElement('div');
      bub.className = 'bubble';
      bub.textContent = text; // user text = plain, always textContent
      card.appendChild(bub);
      column.appendChild(turn);
      turns.push(turn);
      seatEnter(turn);
      birth(turn);
      return turn;
    };

    // word-by-word reveal (motion only; skipped under reduced motion)
    const revealWords = (spans: HTMLElement[]) => {
      spans.forEach((w, idx) => {
        setTimeout(() => w.classList.add('lit'), 40 + idx * 55);
      });
    };

    const showTyping = (): HTMLElement => {
      const { turn, card } = makeTurn('rebi');
      turn.setAttribute('data-typing', '1');
      turn.setAttribute('aria-hidden', 'true'); // dots are decorative; live carries "finding"
      card.insertAdjacentHTML('afterbegin', AVATAR);
      const bub = document.createElement('div');
      bub.className = 'bubble';
      const dots = document.createElement('span');
      dots.className = 'dots';
      dots.innerHTML = '<i></i><i></i><i></i>';
      bub.appendChild(dots);
      card.appendChild(bub);
      column.appendChild(turn);
      turns.push(turn);
      seatEnter(turn);
      birth(turn);
      return turn;
    };

    // The scroll continues: the dots card rolls UP and FADES away (releasing its
    // front slot), while the real reply is born from below and rolls into place.
    const landReply = (typing: HTMLElement, d: Descriptor) => {
      // release the dots card from the depth model so real cards hold position
      const idx = turns.indexOf(typing);
      if (idx !== -1) turns.splice(idx, 1);
      if (REDUCED_MOTION) {
        typing.style.transition = 'opacity 200ms linear';
        typing.style.opacity = '0';
      } else {
        typing.style.transform = 'translateY(-4.6rem) translateZ(-78px) scale(0.88)';
        typing.style.filter = 'blur(3px)';
        typing.style.opacity = '0';
      }
      setTimeout(() => retire(typing), REDUCED_MOTION ? 220 : 640); // atomic DOM + turns[] cleanup

      // the reply rolls up into the front slot, word-by-word, with its chime
      soundRebi();
      appendRebi(d);
    };

    // Clear every card from the stack (turns[] + DOM) and reset the live region.
    const clearStack = () => {
      turns.splice(0, turns.length);
      while (column.firstChild) column.removeChild(column.firstChild);
      live.textContent = '';
    };

    const seatGreeting = () => {
      if (cfg.greeting.showOnLoad && cfg.greeting.text) {
        appendRebi({ kind: 'greeting', text: cfg.greeting.text, count: 0 });
      }
    };

    // ================= Submit → /api/search → drive grid + speak =================
    // Homepage-fenced by construction. `seq` is the correctness gate (a slow
    // response can't overwrite a newer one / a reset); `busy` only guards against
    // overlapping animations.
    let seq = 0;
    let busy = false;

    const currentUrlState = (): FilterState =>
      parseFilters(new URLSearchParams(window.location.search));
    const emptyState = (): FilterState => parseFilters(new URLSearchParams());

    // Read the TRUE match total from the freshly-swapped grid (single source of
    // truth). "No vehicles match" or a missing node → 0.
    const readGridTotal = (): number => {
      const node = document.querySelector('#inventory-results [data-results-count]');
      if (!node) return 0;
      const txt = node.textContent ?? '';
      if (/No vehicles match/i.test(txt)) return 0;
      const m = txt.match(/of ([\d,]+)/);
      return m ? parseInt(m[1].replace(/,/g, ''), 10) : 0;
    };

    // ================= Grid fade choreography =================
    // The 4-step "watch the AI work" sequence pivots on the inventory grid:
    //   submit → old grid fades out + dots  → reply message  → new grid fades in.
    // Motion-safe: under reduced motion these are all no-ops (instant swap), so
    // the message still shows but nothing translates or dissolves.
    const GRID_FADE_MS = 260; // fade out / fade in duration
    const MIN_BEAT_MS = 650; // guaranteed "thinking" beat so the dots always read
    const delay = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    const grid = (): HTMLElement | null => document.getElementById('inventory-results');

    // Step 2a — the current list recedes (opacity + a small lift), clearing the
    // stage while Rebi "thinks". Layout is preserved (opacity/transform only).
    const fadeGridOut = () => {
      if (REDUCED_MOTION) return;
      const g = grid();
      if (!g) return;
      g.style.transition = `opacity ${GRID_FADE_MS}ms ease, transform ${GRID_FADE_MS}ms ease`;
      g.style.willChange = 'opacity, transform';
      void g.offsetWidth; // commit the current (visible) state before transitioning
      g.style.opacity = '0';
      g.style.transform = 'translateY(0.75rem)';
    };

    // applyFilterUrl replaces #inventory-results with a fresh (opacity:1) node.
    // Called synchronously right after the swap — before the browser paints — so
    // the new results start hidden and their fade-in reads as a distinct step.
    const primeGridHidden = () => {
      if (REDUCED_MOTION) return;
      const g = grid();
      if (!g) return;
      g.style.transition = 'none';
      g.style.opacity = '0';
      g.style.transform = 'translateY(0.75rem)';
    };

    // Step 4 — the new (or, on a no-op search, restored) grid fades into view,
    // then its inline styles are stripped so nothing lingers on the node.
    const fadeGridIn = () => {
      const g = grid();
      if (!g) return;
      if (REDUCED_MOTION) {
        g.style.opacity = '';
        g.style.transform = '';
        return;
      }
      void g.offsetWidth;
      g.style.transition = `opacity ${GRID_FADE_MS}ms ease, transform ${GRID_FADE_MS}ms ease`;
      g.style.opacity = '1';
      g.style.transform = 'translateY(0)';
      setTimeout(() => {
        const gg = grid();
        if (gg) {
          gg.style.transition = '';
          gg.style.willChange = '';
          gg.style.transform = '';
          gg.style.opacity = '';
        }
      }, GRID_FADE_MS + 40);
    };

    // Runs the search, builds a reply descriptor from cfg.messages.* + the server
    // interpretation/clarifyingQuestion (exactly as before), then lands the reply.
    const runSearch = async (query: string, typing: HTMLElement) => {
      const my = ++seq;
      const started = performance.now();
      let data: any = null;
      try {
        // First search is fresh (deterministic pre-pass eligible); once filters
        // are active a follow-up REFINES (carries the current filters forward).
        const refine = hasActiveFilters(currentUrlState());
        const res = await fetch('/api/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query, filters: currentUrlState(), refine }),
        });
        data = await res.json().catch(() => null);
      } catch { /* network error — fall through to the unclear message below */ }
      if (my !== seq) { retire(typing); return; } // superseded by a newer submit / reset

      // Guarantee a minimum "thinking" beat so the fade-out + dots always read,
      // even when the response is effectively instant (cached / deterministic).
      const elapsed = performance.now() - started;
      if (elapsed < MIN_BEAT_MS) await delay(MIN_BEAT_MS - elapsed);
      if (my !== seq) { retire(typing); return; } // superseded during the beat

      const gridPresent = !!document.getElementById('inventory-results');
      const filters: FilterState | null =
        data && data.filters ? (data.filters as FilterState) : null;
      const confidence: string = data?.confidence ?? 'low';
      const interpretation: string =
        typeof data?.interpretation === 'string' ? data.interpretation : '';
      const clarifying: string | null =
        typeof data?.clarifyingQuestion === 'string' ? data.clarifyingQuestion : null;

      // Apply only a confident, NON-EMPTY extraction — an empty extraction at high
      // confidence must NOT clear the visitor's existing filters (salvaged guard).
      const applied = !!filters && confidence !== 'low' && hasActiveFilters(filters);

      if (applied && gridPresent && filters) {
        await applyFilterUrl(hrefFor({ ...filters, page: 1 }));
        if (my !== seq) { retire(typing); return; } // superseded during the grid swap
        // Keep the freshly-swapped results hidden (synchronously, pre-paint) so
        // their fade-in lands AFTER the message — not the instant the grid swaps.
        primeGridHidden();
        flipHeading(true);
      }

      let descriptor: Descriptor;
      if (applied) {
        const total = readGridTotal();
        descriptor = total > 0
          ? { kind: 'results', text: cfg.messages.resultsRefine, count: total }
          : { kind: 'nomatch', text: cfg.messages.noMatch, count: 0 };
      } else {
        const unclear = [interpretation, clarifying].filter(Boolean).join(' ') || cfg.messages.unclear;
        descriptor = { kind: 'unclear', text: unclear, count: 0 };
      }

      // Step 3 — the reply message lands in the chat (replacing the dots).
      landReply(typing, descriptor);

      // Step 4 — a beat later, the new (or restored, on a no-op search) grid
      // fades back in, so the message registers before the results appear.
      if (REDUCED_MOTION) {
        fadeGridIn();
      } else {
        setTimeout(() => { if (my === seq) fadeGridIn(); }, 180);
      }
    };

    // "New search": full reset to idle → base inventory, heading + stack + input.
    // Since greeting-on-load is on, re-seat the greeting card after clearing.
    async function resetSearch() {
      seq++; // invalidate any in-flight search so it can't re-message
      await applyFilterUrl(hrefFor(emptyState())); // base "/" → full inventory
      flipHeading(false);
      setActive(false);
      clearStack();
      seatGreeting();
      input!.value = '';
      startTw();
      input!.focus();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const query = input.value.trim();
      if (!query) { input.focus(); return; }
      if (busy) return; // guard overlapping animations only
      busy = true;

      // 1) your message rises into focus + the "sent" blip
      addUserTurn(query);
      soundSend();

      // wipe the input (ready for the next prompt) and restart the placeholder
      input.value = '';
      startTw();
      setActive(true);

      // 2) the current list recedes AND Rebi's typing beat begins together — the
      //    live region announces "finding" now
      fadeGridOut();
      const typing = showTyping();
      live.textContent = cfg.messages.finding;

      // 3) the real search resolves → the reply lands
      runSearch(query, typing).finally(() => {
        busy = false;
        input.focus();
      });
    });

    // "Refine manually" opens the classic drawer (its trigger stays the fallback).
    manualBtn?.addEventListener('click', () => {
      document.getElementById('filters-trigger')?.click();
    });

    // Greet the shopper on load (config-gated); the stage is always visible.
    seatGreeting();
  }

  // Flip the inventory heading between "Current inventory" and "Results" (JS-only;
  // the no-JS heading stays "Current inventory").
  function flipHeading(toResults: boolean) {
    const h = document.getElementById('inventory-heading');
    if (h) h.textContent = toResults ? 'Results' : 'Current inventory';
  }
</script>
