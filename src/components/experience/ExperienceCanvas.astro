---
/**
 * ExperienceCanvas — Candidate A for "Experience Mode".
 * ------------------------------------------------------------------
 * POV: the classic filter+grid makes the SHOPPER do the translation work —
 * turning a fuzzy human wish ("something safe and easy for my daughter") into a
 * matrix of checkboxes. Experience Mode inverts that: Rebi becomes a concierge
 * who asks a few of the RIGHT questions, one at a time, full-screen, then "boom"
 * — assembles a curated shortlist and narrates why each car fits YOU.
 *
 * Three beats:
 *   onboarding → a calm full-screen invitation to hand Rebi the wheel.
 *   standby    → Rebi present but unobtrusive: an ambient breathing orb, waiting.
 *   boom       → Rebi takes the whole screen: 3 guided questions, then a
 *                cinematic curated reveal of real vehicles with real reasons.
 *
 * Framework-free (matches the SearchDock precedent). The matcher is a pure,
 * deterministic module; nothing here calls an LLM — Rebi's copy is scripted and
 * the per-car reasons are derived only from each vehicle's real specs.
 *
 * Isolated + additive: unlinked /labs/experience route, no shared component or
 * config touched. All styles are namespaced under `.xp-root`.
 */
import type { ExperienceVehicle } from './matcher';

interface Props {
  vehicles: ExperienceVehicle[];
  dealerName: string;
}
const { vehicles, dealerName } = Astro.props;
const payload = JSON.stringify({ vehicles, dealerName });
---

<div class="xp-root" data-xp={payload}>
  <!-- Rebi's ambient presence: one orb that follows the shopper across every
       beat, changing state (idle / listening / thinking / reveal). -->
  <div class="xp-orb" id="xp-orb" aria-hidden="true">
    <span class="xp-orb-core"></span>
    <span class="xp-orb-ring"></span>
    <span class="xp-orb-ring xp-orb-ring--2"></span>
  </div>

  <!-- Top chrome: brand + progress + restart (hidden until the flow begins). -->
  <header class="xp-chrome">
    <span class="xp-brand" id="xp-brand"></span>
    <div class="xp-chrome-right">
      <div class="xp-progress" id="xp-progress" hidden></div>
      <button type="button" class="xp-restart" id="xp-restart" hidden>Start over</button>
    </div>
  </header>

  <!-- The canvas Rebi drives. Content is swapped per beat by the engine. -->
  <main class="xp-canvas" id="xp-canvas" aria-live="polite"></main>

  <!-- No-JS / accessibility fallback: the classic site is always one tap away. -->
  <noscript>
    <div class="xp-noscript">
      Experience Mode is an interactive preview that needs JavaScript.
      <a href="/listings">Browse the classic inventory instead →</a>
    </div>
  </noscript>
</div>

<style is:global>
  /* Everything namespaced under .xp-root — runtime-built nodes never receive
     Astro's scope hash, so scoping globally under one root avoids any mismatch
     while still fully containing the styles to this experimental surface. */
  .xp-root {
    --xp-blue: rgb(1 97 239);
    --xp-purple: rgb(109 40 217);
    --xp-grad: linear-gradient(135deg, rgb(1 97 239), rgb(109 40 217));
    --xp-ink: rgb(15 23 42);
    --xp-muted: rgb(100 116 139);
    --xp-line: rgb(226 232 240);
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--xp-ink);
    background:
      radial-gradient(70rem 40rem at 50% -10%, rgb(1 97 239 / 0.08), transparent 60%),
      radial-gradient(60rem 40rem at 90% 110%, rgb(109 40 217 / 0.07), transparent 55%),
      rgb(248 250 252);
  }

  /* ---------------- Rebi's ambient orb ---------------- */
  .xp-orb {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 9rem;
    height: 9rem;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1), width 900ms ease, height 900ms ease, opacity 600ms ease;
  }
  .xp-orb-core {
    position: absolute;
    inset: 22%;
    border-radius: 9999px;
    background: var(--xp-grad);
    box-shadow: 0 20px 60px -18px rgb(1 97 239 / 0.55);
    animation: xp-breathe 4.2s ease-in-out infinite;
  }
  .xp-orb-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 1px solid rgb(1 97 239 / 0.22);
    animation: xp-pulse 4.2s ease-in-out infinite;
  }
  .xp-orb-ring--2 { animation-delay: 1.4s; border-color: rgb(109 40 217 / 0.18); }

  /* Orb states set by the engine. */
  /* Onboarding: the orb sits ABOVE the headline (not over it) so the hero reads
     as a vertical stack — orb, then eyebrow/headline/CTA — optically centred. */
  .xp-orb.is-idle { top: 8.5rem; width: 7.5rem; height: 7.5rem; }
  .xp-orb.is-standby { width: 13rem; height: 13rem; }
  .xp-orb.is-question {
    /* Recedes to the top so it presides over, but doesn't block, the questions. */
    top: 5.5rem; width: 5rem; height: 5rem;
  }
  .xp-orb.is-question .xp-orb-core { animation-duration: 2.6s; }
  .xp-orb.is-thinking .xp-orb-core { animation: xp-spin 1.1s linear infinite, xp-breathe 2s ease-in-out infinite; }
  .xp-orb.is-reveal { top: 4.5rem; width: 4rem; height: 4rem; opacity: 0.85; }

  @keyframes xp-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
  @keyframes xp-pulse { 0% { transform: scale(0.85); opacity: 0.9; } 70% { transform: scale(1.35); opacity: 0; } 100% { opacity: 0; } }
  @keyframes xp-spin { to { transform: rotate(360deg); } }

  /* ---------------- Chrome ---------------- */
  .xp-chrome {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.4rem clamp(1rem, 4vw, 2.5rem);
  }
  .xp-brand { font-weight: 700; letter-spacing: -0.01em; font-size: 0.95rem; }
  .xp-brand b { background: var(--xp-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .xp-chrome-right { display: flex; align-items: center; gap: 1rem; }
  .xp-progress { display: flex; gap: 0.4rem; }
  .xp-dot { width: 1.6rem; height: 0.32rem; border-radius: 9999px; background: var(--xp-line); transition: background 400ms ease; }
  .xp-dot.is-done { background: var(--xp-blue); }
  .xp-dot.is-active { background: var(--xp-purple); }
  .xp-restart {
    border: 1px solid var(--xp-line); background: rgb(255 255 255 / 0.7);
    color: var(--xp-muted); font: inherit; font-size: 0.8rem; font-weight: 600;
    padding: 0.4rem 0.85rem; border-radius: 9999px; cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .xp-restart:hover { color: var(--xp-ink); border-color: rgb(148 163 184); }

  /* ---------------- Canvas + shared beat scaffolding ---------------- */
  .xp-canvas {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem clamp(1rem, 4vw, 2.5rem) 3rem;
  }
  .xp-beat { width: 100%; max-width: 62rem; }
  .xp-beat.is-entering { animation: xp-rise 620ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  @keyframes xp-rise { from { opacity: 0; transform: translateY(1.4rem); } to { opacity: 1; transform: translateY(0); } }

  .xp-eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--xp-muted);
  }
  .xp-eyebrow .xp-dotmark { width: 0.45rem; height: 0.45rem; border-radius: 9999px; background: var(--xp-grad); }

  /* ---------------- Onboarding ---------------- */
  /* Small top offset only — clears the orb above without dropping the block far
     below the optical centre (the orb + this content read as one centred stack). */
  .xp-onboard { margin-top: 4rem; }
  .xp-headline {
    margin: 1.4rem 0 0; font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1.05; font-weight: 800; letter-spacing: -0.03em;
  }
  .xp-headline b { background: var(--xp-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .xp-lead { margin: 1.1rem auto 0; max-width: 34rem; font-size: 1.08rem; color: var(--xp-muted); line-height: 1.55; }
  .xp-cta {
    display: inline-flex; align-items: center; gap: 0.6rem;
    margin-top: 2rem; border: 0; cursor: pointer;
    font: inherit; font-weight: 700; font-size: 1.02rem; color: #fff;
    background: var(--xp-blue); padding: 0.95rem 1.8rem; border-radius: 9999px;
    box-shadow: 0 18px 40px -16px rgb(1 97 239 / 0.7);
    transition: transform 140ms ease, background 160ms ease, box-shadow 200ms ease;
  }
  .xp-cta:hover { background: var(--xp-blue-hover, rgb(1 84 207)); transform: translateY(-1px); box-shadow: 0 24px 50px -18px rgb(1 97 239 / 0.75); }
  .xp-cta:active { transform: scale(0.98); }
  .xp-cta svg { width: 1.1rem; height: 1.1rem; }
  .xp-secondary { display: block; margin-top: 1.4rem; font-size: 0.86rem; color: var(--xp-muted); }
  .xp-secondary a { color: var(--xp-blue); text-decoration: underline; text-underline-offset: 3px; }
  .xp-affordances { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-top: 2.4rem; }
  .xp-chip {
    font-size: 0.82rem; color: var(--xp-muted);
    background: rgb(255 255 255 / 0.75); border: 1px solid var(--xp-line);
    padding: 0.4rem 0.9rem; border-radius: 9999px;
  }

  /* ---------------- Standby ---------------- */
  .xp-standby { margin-top: 12rem; }
  .xp-standby .xp-rebi-line { font-size: clamp(1.4rem, 3.6vw, 2rem); font-weight: 600; letter-spacing: -0.02em; min-height: 1.4em; }
  .xp-standby .xp-lead { margin-top: 0.7rem; }
  .xp-begin {
    margin-top: 1.8rem; border: 0; cursor: pointer; font: inherit; font-weight: 700;
    color: var(--xp-blue); background: none; font-size: 1rem;
    display: inline-flex; align-items: center; gap: 0.5rem;
  }
  .xp-begin .xp-begin-dot { width: 0.6rem; height: 0.6rem; border-radius: 9999px; background: var(--xp-grad); animation: xp-breathe 2s ease-in-out infinite; }

  /* ---------------- Questions ("boom" build-up) ---------------- */
  .xp-question { margin-top: 8rem; }
  .xp-rebi-line { font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 700; letter-spacing: -0.02em; min-height: 1.3em; }
  .xp-caret { display: inline-block; width: 2px; height: 1em; margin-left: 2px; background: var(--xp-purple); vertical-align: -0.12em; animation: xp-blink 1s steps(2) infinite; }
  @keyframes xp-blink { 50% { opacity: 0; } }
  .xp-options {
    display: grid; gap: 0.9rem; margin-top: 2.2rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .xp-opt {
    position: relative; text-align: left; cursor: pointer;
    background: rgb(255 255 255 / 0.85); border: 1px solid var(--xp-line);
    border-radius: 1rem; padding: 1.1rem 1.2rem;
    display: flex; align-items: flex-start; gap: 0.85rem;
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 200ms ease;
    opacity: 0; animation: xp-rise 480ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .xp-opt:hover { transform: translateY(-3px); border-color: rgb(1 97 239 / 0.5); box-shadow: 0 18px 36px -22px rgb(1 97 239 / 0.6); }
  .xp-opt:focus-visible { outline: 2px solid var(--xp-blue); outline-offset: 2px; }
  .xp-opt.is-chosen { border-color: var(--xp-blue); box-shadow: 0 0 0 2px rgb(1 97 239 / 0.35); }
  .xp-opt-glyph {
    flex: none; width: 2.5rem; height: 2.5rem; border-radius: 0.7rem;
    display: grid; place-items: center; color: #fff; background: var(--xp-grad);
  }
  .xp-opt-glyph svg { width: 1.3rem; height: 1.3rem; }
  .xp-opt-label { font-weight: 700; font-size: 1rem; }
  .xp-opt-sub { font-size: 0.82rem; color: var(--xp-muted); margin-top: 0.15rem; }
  .xp-back {
    margin-top: 1.8rem; border: 0; background: none; cursor: pointer;
    color: var(--xp-muted); font: inherit; font-size: 0.85rem; font-weight: 600;
    display: inline-flex; align-items: center; gap: 0.35rem;
  }
  .xp-back:hover { color: var(--xp-ink); }
  .xp-back svg { width: 0.9rem; height: 0.9rem; }

  /* ---------------- Reveal ("boom" payoff) ---------------- */
  .xp-reveal { margin-top: 7rem; }
  .xp-reveal .xp-rebi-line { margin-bottom: 0.4rem; }
  .xp-reveal-sub { color: var(--xp-muted); font-size: 0.95rem; margin-top: 0.3rem; }
  .xp-cards {
    display: grid; gap: 1.2rem; margin-top: 2.4rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .xp-card {
    text-align: left; background: #fff; border: 1px solid var(--xp-line);
    border-radius: 1.1rem; overflow: hidden;
    box-shadow: 0 24px 60px -34px rgb(15 23 42 / 0.4);
    opacity: 0; transform: translateY(1.6rem) scale(0.97);
  }
  .xp-card.is-in { animation: xp-card-in 720ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  @keyframes xp-card-in { to { opacity: 1; transform: translateY(0) scale(1); } }
  .xp-card-rank {
    position: absolute; margin: 0.75rem; z-index: 2;
    font-size: 0.66rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
    color: #fff; background: rgb(15 23 42 / 0.72); padding: 0.28rem 0.6rem; border-radius: 9999px;
    -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
  }
  .xp-card-media { position: relative; aspect-ratio: 16 / 10; background: var(--xp-grad); overflow: hidden; }
  .xp-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .xp-card-media .xp-noimg {
    position: absolute; inset: 0; display: grid; place-items: center;
    color: rgb(255 255 255 / 0.85); font-size: 2.4rem; font-weight: 800;
  }
  .xp-card-body { padding: 1rem 1.1rem 1.2rem; }
  .xp-card-title { font-weight: 700; font-size: 1.02rem; letter-spacing: -0.01em; }
  .xp-card-price { margin-top: 0.2rem; font-size: 0.95rem; color: var(--xp-blue); font-weight: 700; }
  .xp-reasons { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.8rem; }
  .xp-reason {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.76rem; font-weight: 600; color: rgb(30 64 175);
    background: rgb(1 97 239 / 0.08); border: 1px solid rgb(1 97 239 / 0.16);
    padding: 0.28rem 0.6rem; border-radius: 9999px;
  }
  .xp-reason svg { width: 0.85rem; height: 0.85rem; color: var(--xp-blue); }
  .xp-reveal-actions { margin-top: 2.4rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; }
  .xp-reveal-actions .xp-cta { margin-top: 0; font-size: 0.95rem; padding: 0.75rem 1.4rem; }
  .xp-ghost {
    border: 1px solid var(--xp-line); background: rgb(255 255 255 / 0.8); color: var(--xp-ink);
    font: inherit; font-weight: 700; font-size: 0.95rem; padding: 0.75rem 1.4rem;
    border-radius: 9999px; cursor: pointer; transition: border-color 160ms ease;
  }
  .xp-ghost:hover { border-color: rgb(148 163 184); }

  @media (max-width: 640px) {
    .xp-orb.is-question, .xp-orb.is-reveal { display: none; }
    .xp-onboard, .xp-standby, .xp-question, .xp-reveal { margin-top: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .xp-orb, .xp-orb-core, .xp-orb-ring, .xp-beat, .xp-opt, .xp-card, .xp-begin-dot { animation: none !important; transition: opacity 200ms ease !important; }
    .xp-card { opacity: 1; transform: none; }
    .xp-opt { opacity: 1; }
  }
</style>

<script>
  import { QUESTIONS, curate, type Answers, type AnswerOption, type ExperienceVehicle } from './matcher';

  // These nodes are all static in this component's markup, so we assert them
  // non-null here (rather than nesting under a guard) — that keeps the type
  // non-null inside the hoisted render functions below, which is where TS's
  // control-flow narrowing of a captured nullable const would otherwise be lost.
  const root = document.querySelector<HTMLElement>('.xp-root');
  const canvas = document.getElementById('xp-canvas')!;
  const orb = document.getElementById('xp-orb')!;
  const brand = document.getElementById('xp-brand')!;
  const progress = document.getElementById('xp-progress')!;
  const restart = document.getElementById('xp-restart') as HTMLButtonElement;

  if (root && canvas && orb && brand && progress && restart) {
    const REDUCED = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
    let data: { vehicles: ExperienceVehicle[]; dealerName: string } = { vehicles: [], dealerName: 'this dealership' };
    try {
      const raw = root.getAttribute('data-xp');
      if (raw) data = JSON.parse(raw);
    } catch { /* keep defaults */ }

    brand.innerHTML = `<b>${escapeHtml(data.dealerName)}</b> · Experience Mode`;

    // ---------- tiny SVG glyph set (no external icons) ----------
    const GLYPHS: Record<string, string> = {
      spark: '<path d="M12 2v6M12 16v6M2 12h6M16 12h6" /><path d="M12 8l1.6 2.4L16 12l-2.4 1.6L12 16l-1.6-2.4L8 12l2.4-1.6z" />',
      people: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 11a3 3 0 0 0 0-6"/><path d="M18 20a6 6 0 0 0-3-5.2"/>',
      person: '<circle cx="12" cy="8" r="3.2"/><path d="M6 20a6 6 0 0 1 12 0"/>',
      tools: '<path d="M14.7 6.3a3.5 3.5 0 0 0-4.6 4.6L3 18l3 3 7.1-7.1a3.5 3.5 0 0 0 4.6-4.6l-2.2 2.2-2-2z"/>',
      mountain: '<path d="M3 19h18L14 6l-3.5 6-2-3z"/>',
      leaf: '<path d="M4 20c0-8 6-14 16-15-1 10-7 15-15 15z"/><path d="M9 15c2-3 5-5 8-6"/>',
      gauge: '<path d="M4 18a8 8 0 1 1 16 0"/><path d="M12 18l4-4"/>',
      coin: '<circle cx="12" cy="12" r="8"/><path d="M12 8v8M9.5 9.5c0-1 1-1.5 2.5-1.5s2.5.5 2.5 1.5-1 1.5-2.5 1.5-2.5.5-2.5 1.5 1 1.5 2.5 1.5 2.5-.5 2.5-1.5"/>',
      sparkles: '<path d="M12 3l1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8z"/><path d="M18 14l.9 2.1L21 17l-2.1.9L18 20l-.9-2.1L15 17l2.1-.9z"/>',
      arrow: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
      back: '<path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/>',
      check: '<path d="M4 12l5 5L20 6"/>',
    };
    const svg = (key: string, w = 24) =>
      `<svg viewBox="0 0 24 24" width="${w}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${GLYPHS[key] ?? ''}</svg>`;

    // ---------- state ----------
    const answers: Answers = {};
    let qIndex = 0;

    const setOrb = (state: string) => {
      orb.className = 'xp-orb ' + state;
    };

    // A typewriter for Rebi's spoken line. Returns a cancel fn.
    function typeLine(el: HTMLElement, text: string, done?: () => void): () => void {
      if (REDUCED) { el.textContent = text; done?.(); return () => {}; }
      let i = 0;
      const caret = document.createElement('span');
      caret.className = 'xp-caret';
      el.textContent = '';
      el.appendChild(caret);
      const tick = () => {
        i++;
        el.textContent = text.slice(0, i);
        el.appendChild(caret);
        if (i < text.length) { timer = window.setTimeout(tick, 26); }
        else { caret.remove(); done?.(); }
      };
      let timer = window.setTimeout(tick, 260);
      return () => window.clearTimeout(timer);
    }

    // Swap the canvas to a fresh beat node with the entrance animation.
    function mount(node: HTMLElement) {
      canvas.replaceChildren(node);
      requestAnimationFrame(() => node.classList.add('is-entering'));
    }

    function renderProgress() {
      progress.hidden = false;
      progress.replaceChildren();
      QUESTIONS.forEach((_, idx) => {
        const dot = document.createElement('span');
        dot.className = 'xp-dot' + (idx < qIndex ? ' is-done' : idx === qIndex ? ' is-active' : '');
        progress.appendChild(dot);
      });
    }

    // ---------- Beat 1: onboarding ----------
    function renderOnboarding() {
      setOrb('is-idle');
      progress.hidden = true;
      restart.hidden = true;
      const el = document.createElement('div');
      el.className = 'xp-beat';
      el.innerHTML = `
        <div class="xp-onboard">
          <span class="xp-eyebrow"><span class="xp-dotmark"></span>An invitation from Rebi</span>
          <h1 class="xp-headline">Don't shop the lot.<br><b>Let it come to you.</b></h1>
          <p class="xp-lead">Answer three quick questions and I'll pull the cars that actually fit
            your life off the ${escapeHtml(data.vehicles.length + '')}-strong lot — no filters, no forms.</p>
          <button type="button" class="xp-cta" id="xp-opt-in">
            Hand me the wheel ${svg('arrow', 18)}
          </button>
          <span class="xp-secondary">Prefer to browse yourself? <a href="/listings">Open the classic inventory →</a></span>
          <div class="xp-affordances">
            <span class="xp-chip">I read your whole search</span>
            <span class="xp-chip">I know every car in stock</span>
            <span class="xp-chip">I explain the "why"</span>
          </div>
        </div>`;
      mount(el);
      el.querySelector<HTMLButtonElement>('#xp-opt-in')?.addEventListener('click', renderStandby);
    }

    // ---------- Beat 2: standby ----------
    function renderStandby() {
      setOrb('is-standby');
      progress.hidden = true;
      restart.hidden = false;
      const el = document.createElement('div');
      el.className = 'xp-beat';
      el.innerHTML = `
        <div class="xp-standby">
          <p class="xp-rebi-line" id="xp-standby-line"></p>
          <p class="xp-lead">Take your time. When you're ready, I'll start with a couple of easy questions.</p>
          <button type="button" class="xp-begin" id="xp-begin">
            <span class="xp-begin-dot"></span> I'm ready — let's go
          </button>
        </div>`;
      mount(el);
      const line = el.querySelector<HTMLElement>('#xp-standby-line')!;
      typeLine(line, `G'day, I'm Rebi. I'm right here whenever you want me.`);
      el.querySelector<HTMLButtonElement>('#xp-begin')?.addEventListener('click', () => {
        qIndex = 0;
        renderQuestion();
      });
    }

    // ---------- Beat 3a: guided questions ----------
    function renderQuestion() {
      setOrb('is-question');
      restart.hidden = false;
      renderProgress();
      const q = QUESTIONS[qIndex];
      const el = document.createElement('div');
      el.className = 'xp-beat';
      el.innerHTML = `
        <div class="xp-question">
          <span class="xp-eyebrow"><span class="xp-dotmark"></span>Question ${qIndex + 1} of ${QUESTIONS.length}</span>
          <p class="xp-rebi-line" id="xp-q-line"></p>
          <div class="xp-options" id="xp-options" hidden></div>
          ${qIndex > 0 ? `<button type="button" class="xp-back" id="xp-back">${svg('back', 16)} Back</button>` : ''}
        </div>`;
      mount(el);

      const optionsWrap = el.querySelector<HTMLElement>('#xp-options')!;
      optionsWrap.innerHTML = q.options
        .map(
          (o, i) => `
          <button type="button" class="xp-opt" data-opt="${o.id}" style="animation-delay:${REDUCED ? 0 : 90 * i}ms">
            <span class="xp-opt-glyph">${svg(o.glyph)}</span>
            <span>
              <span class="xp-opt-label">${escapeHtml(o.label)}</span>
              <span class="xp-opt-sub">${escapeHtml(o.sub)}</span>
            </span>
          </button>`,
        )
        .join('');

      const line = el.querySelector<HTMLElement>('#xp-q-line')!;
      typeLine(line, q.rebi, () => { optionsWrap.hidden = false; });

      optionsWrap.querySelectorAll<HTMLButtonElement>('.xp-opt').forEach((btn) => {
        btn.addEventListener('click', () => {
          const chosen = q.options.find((o) => o.id === btn.dataset.opt) as AnswerOption | undefined;
          if (!chosen) return;
          answers[q.id] = chosen;
          btn.classList.add('is-chosen');
          // Brief acknowledgement beat, then advance.
          window.setTimeout(() => {
            if (qIndex < QUESTIONS.length - 1) { qIndex++; renderQuestion(); }
            else { renderReveal(); }
          }, REDUCED ? 120 : 340);
        });
      });

      el.querySelector<HTMLButtonElement>('#xp-back')?.addEventListener('click', () => {
        if (qIndex > 0) { qIndex--; renderQuestion(); }
      });
    }

    // ---------- Beat 3b: the "boom" reveal ----------
    function renderReveal() {
      setOrb('is-question is-thinking');
      progress.hidden = true;
      restart.hidden = false;

      // A short "thinking" beat so the curation reads as deliberate work.
      const thinking = document.createElement('div');
      thinking.className = 'xp-beat';
      thinking.innerHTML = `<div class="xp-reveal"><p class="xp-rebi-line" id="xp-think-line"></p></div>`;
      mount(thinking);
      typeLine(thinking.querySelector<HTMLElement>('#xp-think-line')!, 'Reading your search and combing the lot…');

      const picks = curate(data.vehicles, answers, 3);

      window.setTimeout(() => {
        setOrb('is-reveal');
        const el = document.createElement('div');
        el.className = 'xp-beat';
        el.innerHTML = `
          <div class="xp-reveal">
            <span class="xp-eyebrow"><span class="xp-dotmark"></span>Curated for you</span>
            <p class="xp-rebi-line" id="xp-reveal-line"></p>
            <p class="xp-reveal-sub">${escapeHtml(summarise(answers))}</p>
            <div class="xp-cards" id="xp-cards"></div>
            <div class="xp-reveal-actions">
              <a class="xp-cta" href="/listings">See the full lot ${svg('arrow', 18)}</a>
              <button type="button" class="xp-ghost" id="xp-again">Start again</button>
            </div>
          </div>`;
        mount(el);
        typeLine(el.querySelector<HTMLElement>('#xp-reveal-line')!, "Here's what I'd pull off the lot for you.");

        const cardsWrap = el.querySelector<HTMLElement>('#xp-cards')!;
        if (!picks.length) {
          cardsWrap.innerHTML = `<p class="xp-lead">I couldn't find a strong match in stock right now — but the team can hunt one down. <a href="/listings">Browse everything →</a></p>`;
        } else {
          cardsWrap.innerHTML = picks.map((p, i) => cardHtml(p, i)).join('');
          const cards = cardsWrap.querySelectorAll<HTMLElement>('.xp-card');
          cards.forEach((c, i) => {
            window.setTimeout(() => c.classList.add('is-in'), REDUCED ? 0 : 260 * i + 200);
          });
        }
        el.querySelector<HTMLButtonElement>('#xp-again')?.addEventListener('click', reset);
      }, REDUCED ? 400 : 1500);
    }

    function cardHtml(p: ReturnType<typeof curate>[number], i: number) {
      const v = p.vehicle;
      const rank = ['Top pick', 'Also great', 'Worth a look'][i] ?? `Pick ${i + 1}`;
      const initial = escapeHtml((v.make || v.title || '?').trim().charAt(0).toUpperCase());
      const media = v.image
        ? `<img src="${escapeAttr(v.image)}?w=640&h=400&fit=crop&auto=format" alt="${escapeAttr(v.title)}" loading="lazy" />`
        : `<span class="xp-noimg">${initial}</span>`;
      const reasons = p.reasons.length
        ? p.reasons.map((r) => `<span class="xp-reason">${svg('check', 14)}${escapeHtml(r)}</span>`).join('')
        : `<span class="xp-reason">${svg('check', 14)}A solid all-rounder</span>`;
      return `
        <article class="xp-card">
          <span class="xp-card-rank">${rank}</span>
          <div class="xp-card-media">${media}</div>
          <div class="xp-card-body">
            <div class="xp-card-title">${escapeHtml(v.title || `${v.make ?? ''} ${v.model ?? ''}`.trim() || 'Vehicle')}</div>
            <div class="xp-card-price">${escapeHtml(v.priceLabel)}</div>
            <div class="xp-reasons">${reasons}</div>
          </div>
        </article>`;
    }

    // A plain-English recap of the shopper's answers (honest, from their choices).
    function summarise(a: Answers): string {
      const bits = [a.who?.label, a.priority?.label?.toLowerCase(), a.budget?.label]
        .filter(Boolean)
        .map((b) => String(b));
      if (!bits.length) return 'Based on what you told me.';
      return `For ${bits[0]}${bits[1] ? `, prioritising ${bits[1]}` : ''}${bits[2] ? ` · ${bits[2]}` : ''}.`;
    }

    function reset() {
      (Object.keys(answers) as (keyof Answers)[]).forEach((k) => delete answers[k]);
      qIndex = 0;
      renderOnboarding();
    }

    restart.addEventListener('click', reset);

    // ---------- helpers ----------
    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    }
    function escapeAttr(s: string): string { return escapeHtml(s); }

    // Kick off.
    renderOnboarding();
  }
</script>
