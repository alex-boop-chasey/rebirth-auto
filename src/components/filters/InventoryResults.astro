---
/**
 * The swappable inventory region (`#inventory-results`): active-filter chips,
 * result count, the listings grid (or empty state), and pagination.
 *
 * Rendered IDENTICALLY by the homepage (`src/pages/index.astro`) and the
 * fetch-swap partial (`src/pages/partials/inventory.astro`), so a client-side
 * filter change can replace this whole node with the partial's output and the
 * result is byte-for-byte what a hard SSR load would produce.
 */
import ListingCard from '../ListingCard.astro';
import ActiveFilterChips from './ActiveFilterChips.astro';
import { iconSvg } from '../../lib/listing';
import type { Listing, PriceDrop } from '../../lib/listing';
import { activeChips, totalPages, pageHref, LISTINGS_PATH, type FilterState } from '../../lib/listings-query';
import { dealerConfig } from '../../config/dealer';

interface Props {
  listings: Listing[];
  total: number;
  state: FilterState;
  /** `_id → PriceDrop|null` map, resolved once at the data layer (demo flag read
   *  there, never here). Absent → no drops. Threaded straight to each card. */
  priceDrops?: Record<string, PriceDrop | null>;
}

const { listings, total, state, priceDrops = {} } = Astro.props;

const chips = activeChips(state);
// Saved searches: an auto-generated human label from the active chips (e.g.
// "Body: SUV, Price: Up to $40,000"). The canonical query string itself is read
// client-side from the current URL via the existing filter helpers — never
// hand-rolled here.
const savedSearchCfg = dealerConfig.savedSearch;
const savedSearchLabel = chips.map((c) => `${c.label}: ${c.value}`).join(', ');
const pages = totalPages(total);
const currentPage = Math.min(Math.max(state.page, 1), pages);
const { pageSize } = dealerConfig.inventory;
const firstShown = total === 0 ? 0 : (currentPage - 1) * pageSize + 1;
const lastShown = Math.min(currentPage * pageSize, total);

// Compact page window: 1, last, current±1, with ellipsis gaps. Keeps the control
// sane when a dealer's inventory spans many pages.
function pageWindow(current: number, last: number): (number | 'gap')[] {
  const wanted = new Set<number>([1, last, current - 1, current, current + 1]);
  const nums = [...wanted].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
  const out: (number | 'gap')[] = [];
  let prev = 0;
  for (const n of nums) {
    if (prev && n - prev > 1) out.push('gap');
    out.push(n);
    prev = n;
  }
  return out;
}

const windowPages = pages > 1 ? pageWindow(currentPage, pages) : [];

const pageLink =
  'inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line bg-surface px-3 text-sm font-medium text-ink-soft transition hover:border-teal hover:text-ink';
const pageLinkActive =
  'inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-ink bg-ink px-3 text-sm font-semibold text-white';
const pageLinkDisabled =
  'inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line bg-surface px-3 text-sm font-medium text-ink-faint/50 cursor-not-allowed';
---

<div id="inventory-results">
  {
    chips.length > 0 && (
      <div class="mt-6" data-save-search-region>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <ActiveFilterChips chips={chips} />
          <a
            href={LISTINGS_PATH}
            data-filter-clear
            class="text-xs font-medium text-ink-soft underline-offset-2 transition hover:text-ink hover:underline"
          >
            Clear all
          </a>
          {savedSearchCfg.enabled && (
            <button
              type="button"
              data-save-search-toggle
              aria-expanded="false"
              class="inline-flex items-center gap-1.5 text-xs font-medium text-indigo-deep underline-offset-2 transition hover:text-indigo hover:underline"
            >
              <Fragment set:html={iconSvg('heart', 'h-3.5 w-3.5')} />
              {savedSearchCfg.copy.toggleLabel}
            </button>
          )}
        </div>

        {savedSearchCfg.enabled && (
          <div
            data-save-search-panel
            data-label={savedSearchLabel}
            data-error={savedSearchCfg.copy.errorMessage}
            hidden
            class="mt-3 max-w-md rounded-lg border border-indigo/20 bg-surface p-4 shadow-[var(--sh-2)]"
          >
            <p class="text-sm font-semibold text-ink">{savedSearchCfg.copy.heading}</p>
            <p class="mt-1 text-xs text-ink-soft">{savedSearchCfg.copy.description}</p>
            <form data-save-search-form class="mt-3 flex flex-wrap gap-2">
              <input
                type="email"
                required
                data-save-search-email
                placeholder={savedSearchCfg.copy.emailPlaceholder}
                aria-label={savedSearchCfg.copy.emailPlaceholder}
                class="min-w-0 flex-1 rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink shadow-[var(--sh-1)] focus:border-teal focus:outline-none focus-visible:ring-2 focus-visible:ring-teal/30"
              />
              <button
                type="submit"
                data-save-search-submit
                class="rounded-pill bg-ink px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-deep disabled:opacity-60"
              >
                {savedSearchCfg.copy.submitLabel}
              </button>
            </form>
            <p
              data-save-search-status
              role="status"
              aria-live="polite"
              hidden
              class="mt-2 text-xs"
            />
          </div>
        )}
      </div>
    )
  }

  <p class="mt-6 text-sm text-ink-soft" data-results-count>
    {
      total === 0
        ? 'No vehicles match your filters'
        : `Showing ${firstShown}–${lastShown} of ${total} ${total === 1 ? 'vehicle' : 'vehicles'}`
    }
  </p>

  {
    total > 0 ? (
      <section class="mt-6 inventory-grid" style={`--result-cols:${listings.length}`}>
        {listings.map((listing) => (
          <ListingCard listing={listing} priceDrop={priceDrops[listing._id] ?? null} />
        ))}
      </section>
    ) : (
      <div class="card mt-6 px-6 py-16 text-center">
        <div class="mx-auto mb-4 flex w-fit justify-center text-ink-faint">
          <Fragment set:html={iconSvg('car', 'h-10 w-10')} />
        </div>
        <h2 class="text-lg font-semibold text-ink">
          {chips.length > 0 ? 'No vehicles match your filters' : 'No vehicles in stock right now'}
        </h2>
        <p class="mt-1 text-sm text-ink-soft">
          {chips.length > 0
            ? 'Try widening or clearing a filter to see more.'
            : 'New arrivals land regularly — check back soon or get in touch.'}
        </p>
        {chips.length > 0 && (
          <a href={LISTINGS_PATH} data-filter-clear class="btn btn-primary mt-6">
            Clear all filters
          </a>
        )}
      </div>
    )
  }

  {
    pages > 1 && (
      <nav class="mt-10 flex items-center justify-center gap-1" aria-label="Pagination">
        {currentPage > 1 ? (
          <a href={pageHref(state, currentPage - 1)} data-page-link rel="prev" class={pageLink} aria-label="Previous page">
            <Fragment set:html={iconSvg('arrowLeft', 'h-3.5 w-3.5')} />
          </a>
        ) : (
          <span class={pageLinkDisabled} aria-hidden="true">
            <Fragment set:html={iconSvg('arrowLeft', 'h-3.5 w-3.5')} />
          </span>
        )}

        {windowPages.map((p) =>
          p === 'gap' ? (
            <span class="px-1 text-slate-400">…</span>
          ) : p === currentPage ? (
            <span class={pageLinkActive} aria-current="page">
              {p}
            </span>
          ) : (
            <a href={pageHref(state, p)} data-page-link class={pageLink}>
              {p}
            </a>
          ),
        )}

        {currentPage < pages ? (
          <a href={pageHref(state, currentPage + 1)} data-page-link rel="next" class={pageLink} aria-label="Next page">
            <Fragment set:html={iconSvg('arrow', 'h-3.5 w-3.5')} />
          </a>
        ) : (
          <span class={pageLinkDisabled} aria-hidden="true">
            <Fragment set:html={iconSvg('arrow', 'h-3.5 w-3.5')} />
          </span>
        )}
      </nav>
    )
  }
</div>

<script>
  // ── "Save this search" progressive enhancement ────────────────────────────
  // The affordance markup lives inside #inventory-results, which is swapped out
  // on every client-side filter change — so ALL listeners are delegated on
  // document (bound once, survive swaps), exactly like FilterDrawer's chip
  // handling. The canonical query string is read from the current URL via the
  // shared filter helpers (parseFilters → serializeFilters), never hand-rolled.
  import { parseFilters, serializeFilters } from '../../lib/listings-query';

  const w = window as unknown as { __saveSearchBound?: boolean };
  if (!w.__saveSearchBound) {
    w.__saveSearchBound = true;

    // Toggle the email-capture panel open/closed.
    document.addEventListener('click', (e) => {
      const toggle = (e.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-save-search-toggle]',
      );
      if (!toggle) return;
      const region = toggle.closest('[data-save-search-region]');
      const panel = region?.querySelector<HTMLElement>('[data-save-search-panel]');
      if (!panel) return;
      const open = panel.hidden;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) region?.querySelector<HTMLInputElement>('[data-save-search-email]')?.focus();
    });

    // Submit → POST the canonical query + auto label to /api/saved-search.
    document.addEventListener('submit', async (e) => {
      const form = (e.target as HTMLElement).closest<HTMLFormElement>('[data-save-search-form]');
      if (!form) return;
      e.preventDefault();

      const region = form.closest('[data-save-search-region]');
      const panel = region?.querySelector<HTMLElement>('[data-save-search-panel]');
      const emailEl = form.querySelector<HTMLInputElement>('[data-save-search-email]');
      const submitEl = form.querySelector<HTMLButtonElement>('[data-save-search-submit]');
      const statusEl = region?.querySelector<HTMLElement>('[data-save-search-status]');
      if (!panel || !emailEl || !statusEl) return;

      const email = emailEl.value.trim();
      // Canonical filter query, read from the URL via the shared helpers.
      const sp = new URLSearchParams(window.location.search);
      const query = serializeFilters(parseFilters(sp));
      const label = panel.dataset.label ?? '';
      const fallbackError = panel.dataset.error ?? 'Something went wrong. Please try again.';

      const show = (msg: string, ok: boolean) => {
        statusEl.textContent = msg;
        statusEl.hidden = false;
        statusEl.classList.toggle('text-emerald-600', ok);
        statusEl.classList.toggle('text-red-600', !ok);
      };

      if (submitEl) submitEl.disabled = true;
      try {
        const res = await fetch('/api/saved-search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, query, label }),
        });
        const data = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          message?: string;
          error?: string;
        };
        if (data.ok) {
          show(data.message ?? 'Saved.', true);
          emailEl.value = '';
        } else {
          show(data.error ?? fallbackError, false);
        }
      } catch {
        show(fallbackError, false);
      } finally {
        if (submitEl) submitEl.disabled = false;
      }
    });
  }
</script>
