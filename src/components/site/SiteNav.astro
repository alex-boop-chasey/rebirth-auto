---
/**
 * SiteNav — the Smart-Hubs mega-menu top nav (NFY / inline-contextual design).
 *
 * The one thing lifted from the smart-hubs concept: a lean set of three HUB
 * triggers, each opening a mega-menu of its drill-in pages. Productionised from
 * the demo mock:
 *   - a REAL mobile menu (hamburger → accordion) the mock never had;
 *   - click / tap to open a panel (not hover-only), with `aria-expanded`,
 *     Escape-to-close, outside-click-to-close and focus rings;
 *   - desktop hover kept purely as an enhancement.
 *
 * Config-as-data: the hub + CTA model comes from `~/config/nav`; the dealer name
 * comes from `~/config/dealer`. No dealer literals live here. The "Ask Rebi" pill
 * carries the shared `data-rebi-open` seam (kind `nav`) so it opens the real
 * ChatWidget wherever that widget is mounted.
 *
 * Props:
 *   active   — key of the current hub (highlights its trigger)
 *   tagline  — optional small text under the brand name
 */
import { dealerConfig } from '../../config/dealer';
import { navHubs, primaryCta } from '../../config/nav';

interface Props {
  active?: string;
  tagline?: string;
}
const { active = '', tagline } = Astro.props as Props;

const dealerName = dealerConfig.identity.name;

// Presentation layer for the config's icon KEYS → inline SVG. Self-contained
// (no dependency on any concept's data.ts). Stroke icons at 1.7 weight.
const icon = (name: string, size = 18): string => {
  const a = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"`;
  const p: Record<string, string> = {
    grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
    car: '<path d="M5 11l1.5-4A2 2 0 018.4 6h7.2a2 2 0 011.9 1.3L19 11"/><path d="M4 11h16v5H4z"/><circle cx="7.5" cy="16" r="1.5"/><circle cx="16.5" cy="16" r="1.5"/>',
    gauge: '<path d="M12 14l3-3"/><circle cx="12" cy="13" r="8"/><path d="M4 13a8 8 0 0116 0"/>',
    plug: '<path d="M9 2v6M15 2v6M7 8h10v3a5 5 0 01-10 0z"/><path d="M12 16v6"/>',
    tag: '<path d="M3 12l9-9 8 8-9 9-8-8z"/><circle cx="8" cy="8" r="1.3"/>',
    calc: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2M12 11h2M16 11h.01M8 15h2M12 15h2M16 15h.01M8 19h6"/>',
    swap: '<path d="M7 4v13M7 4L4 7M7 4l3 3M17 20V7M17 20l3-3M17 20l-3-3"/>',
    dollar: '<path d="M12 2v20M17 6.5a4 4 0 00-4-2.5H10.5a3.5 3.5 0 000 7h3a3.5 3.5 0 010 7H10a4 4 0 01-4-2.5"/>',
    key: '<circle cx="8" cy="15" r="4"/><path d="M10.8 12.2L20 3M17 6l2 2M14 9l2 2"/>',
    wrench: '<path d="M14 7a4 4 0 01-5 5l-6 6 2 2 6-6a4 4 0 005-5l-2 2-2-2 2-2z"/>',
    gear: '<path d="M6 4v16M18 4v16M6 8h12"/><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="12" r="2"/>',
    briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  };
  return `<svg ${a}>${p[name] ?? ''}</svg>`;
};

const sparkSvg =
  '<svg class="spark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg>';
const caretSvg =
  '<svg class="sh-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';
const burgerSvg =
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>';
const closeSvg =
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>';
---

<header class="site-nav sh-nav" data-sitenav>
  <div class="site-container site-nav-inner">
    <a class="site-brand" href="/" aria-label={`${dealerName} home`}>
      <span class="brand-mark" set:html={sparkSvg}></span>
      <span>{dealerName}{tagline && <small>{tagline}</small>}</span>
    </a>

    <nav class="site-navlinks sh-navlinks" aria-label="Primary">
      {navHubs.map((hub) => (
        <div class="sh-hub" data-hub>
          <button
            type="button"
            class={`sh-hub-trigger${active === hub.key ? ' is-active' : ''}`}
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls={`sh-mega-${hub.key}`}
            data-hub-trigger
          >
            {hub.label}
            <span set:html={caretSvg} />
          </button>
          <div class="sh-mega" id={`sh-mega-${hub.key}`} role="region" aria-label={`${hub.label} menu`}>
            <div class="sh-mega-lead">
              <div class="eyebrow">{hub.label}</div>
              <p>{hub.tagline}</p>
              {hub.href && (
                <a href={hub.href} class="sh-mega-all">
                  Open the {hub.label} hub <span set:html={icon('arrow', 14)} />
                </a>
              )}
            </div>
            <div class="sh-mega-grid">
              {hub.items.map((it) => (
                <a href={it.href} class="sh-mega-item">
                  <span class="sh-mega-ic" set:html={icon(it.icon, 18)} />
                  <span class="sh-mega-tx">
                    <b>{it.label}</b>
                    <small>{it.blurb}</small>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </nav>

    <div class="site-nav-right">
      <div class="sh-desktop-actions">
        <button type="button" class="ai-badge" data-rebi-open data-rebi-kind="nav" aria-label="Ask Rebi">
          <span set:html={sparkSvg} /> Ask Rebi
        </button>
        <a href={primaryCta.href} class="btn btn-primary btn-sm">{primaryCta.label}</a>
      </div>
      <button
        type="button"
        class="sh-burger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="sh-mobile"
        data-burger
      >
        <span class="sh-burger-open" set:html={burgerSvg} />
        <span class="sh-burger-close" set:html={closeSvg} />
      </button>
    </div>
  </div>

  <!-- Real mobile menu: hamburger → accordion of the 3 hubs + actions. -->
  <div class="sh-mobile" id="sh-mobile" hidden>
    <nav class="site-container sh-mobile-inner" aria-label="Mobile">
      {navHubs.map((hub) => (
        <div class="sh-macc">
          <button
            type="button"
            class="sh-macc-trigger"
            aria-expanded="false"
            aria-controls={`sh-macc-${hub.key}`}
            data-macc-trigger
          >
            {hub.label}
            <span set:html={caretSvg} />
          </button>
          <div class="sh-macc-panel" id={`sh-macc-${hub.key}`} hidden>
            {hub.href && (
              <a href={hub.href} class="sh-macc-all">Open the {hub.label} hub</a>
            )}
            {hub.items.map((it) => (
              <a href={it.href} class="sh-macc-item">
                <span class="sh-macc-ic" set:html={icon(it.icon, 18)} />
                <span class="sh-mega-tx">
                  <b>{it.label}</b>
                  <small>{it.blurb}</small>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
      <div class="sh-mobile-actions">
        <button type="button" class="ai-badge" data-rebi-open data-rebi-kind="nav" aria-label="Ask Rebi">
          <span set:html={sparkSvg} /> Ask Rebi
        </button>
        <a href={primaryCta.href} class="btn btn-primary btn-sm">{primaryCta.label}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* ---- hub trigger + mega-menu (desktop) --------------------------------- */
  .sh-navlinks { gap: 2px; margin-left: 8px; }
  .sh-hub { position: relative; }
  .sh-hub-trigger {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--font-ui); font-size: 14.5px; font-weight: 600;
    color: var(--ink-soft); background: transparent; border: 0;
    padding: 9px 13px; border-radius: 10px; cursor: pointer;
    transition: background 0.16s, color 0.16s;
  }
  .sh-hub-trigger:hover { background: rgba(15, 181, 166, 0.09); color: var(--ink); }
  .sh-hub-trigger.is-active,
  .sh-hub[data-open] > .sh-hub-trigger { color: var(--ink); background: rgba(13, 22, 38, 0.05); }
  .sh-caret { opacity: 0.55; transition: transform 0.18s ease; }
  .sh-hub[data-open] .sh-caret { transform: rotate(180deg); }

  .sh-mega {
    position: absolute; top: calc(100% + 10px); left: 0;
    width: 620px; max-width: min(620px, calc(100vw - 32px)); padding: 20px; z-index: 60;
    display: grid; grid-template-columns: 220px 1fr; gap: 20px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.9));
    backdrop-filter: blur(16px) saturate(1.2);
    border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--sh-3);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }
  /* hover bridge so the panel doesn't vanish crossing the gap */
  .sh-mega::before { content: ""; position: absolute; top: -12px; left: 0; right: 0; height: 12px; }
  .sh-hub[data-open] > .sh-mega { opacity: 1; visibility: visible; transform: translateY(0); }
  /* Desktop hover is a pure enhancement — only where a real pointer exists. */
  @media (hover: hover) and (pointer: fine) {
    .sh-hub:hover > .sh-mega,
    .sh-hub:focus-within > .sh-mega { opacity: 1; visibility: visible; transform: translateY(0); }
    .sh-hub:hover .sh-caret { transform: rotate(180deg); }
  }

  .sh-mega-lead p { font-size: 13px; color: var(--ink-soft); line-height: 1.5; margin: 10px 0 14px; }
  .sh-mega-all {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 13px; font-weight: 600; color: var(--teal-deep); text-decoration: none;
  }
  .sh-mega-all:hover { color: var(--teal); }
  .sh-mega-grid { display: flex; flex-direction: column; gap: 4px; }
  .sh-mega-item {
    display: flex; gap: 12px; align-items: flex-start; padding: 10px 12px;
    border-radius: 12px; text-decoration: none; color: inherit; transition: background 0.14s;
  }
  .sh-mega-item:hover { background: var(--bg-2); }
  .sh-mega-ic {
    flex: none; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center;
    background: var(--mint-glow); color: var(--teal-deep);
  }
  .sh-mega-tx { display: flex; flex-direction: column; }
  .sh-mega-item b, .sh-macc-item b { display: block; font-size: 13.5px; color: var(--ink); }
  .sh-mega-item small, .sh-macc-item small { display: block; font-size: 12px; color: var(--ink-faint); margin-top: 2px; }

  /* ---- right-side actions + burger --------------------------------------- */
  .sh-desktop-actions { display: flex; align-items: center; gap: 12px; }
  .sh-burger {
    display: none; align-items: center; justify-content: center;
    width: 42px; height: 42px; border-radius: 12px;
    background: rgba(255, 255, 255, 0.7); border: 1px solid var(--line);
    color: var(--ink); cursor: pointer; backdrop-filter: blur(8px);
    transition: border-color 0.16s, color 0.16s;
  }
  .sh-burger:hover { border-color: var(--teal); color: var(--teal-deep); }
  .sh-burger-close { display: none; }
  .sh-burger[aria-expanded="true"] .sh-burger-open { display: none; }
  .sh-burger[aria-expanded="true"] .sh-burger-close { display: inline-flex; }

  /* ---- mobile drawer ----------------------------------------------------- */
  .sh-mobile {
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(245, 248, 252, 0.98), rgba(245, 248, 252, 0.96));
    backdrop-filter: blur(14px) saturate(1.15);
    max-height: calc(100vh - 74px); overflow-y: auto;
  }
  .sh-mobile-inner { display: flex; flex-direction: column; gap: 6px; padding-block: 14px 22px; }
  .sh-macc { border-bottom: 1px solid var(--line-2); }
  .sh-macc-trigger {
    display: flex; align-items: center; justify-content: space-between; width: 100%;
    font-family: var(--font-ui); font-size: 16px; font-weight: 600; color: var(--ink);
    background: transparent; border: 0; padding: 14px 4px; cursor: pointer;
  }
  .sh-macc-trigger[aria-expanded="true"] .sh-caret { transform: rotate(180deg); }
  .sh-macc-panel { display: flex; flex-direction: column; gap: 2px; padding: 2px 4px 12px; }
  .sh-macc-all {
    font-size: 13px; font-weight: 600; color: var(--teal-deep);
    text-decoration: none; padding: 8px 10px;
  }
  .sh-macc-item {
    display: flex; gap: 12px; align-items: flex-start; padding: 10px;
    border-radius: 12px; text-decoration: none; color: inherit;
  }
  .sh-macc-item:hover { background: var(--bg-2); }
  .sh-macc-ic {
    flex: none; width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center;
    background: var(--mint-glow); color: var(--teal-deep);
  }
  .sh-mobile-actions {
    display: flex; flex-direction: column; gap: 12px; align-items: stretch;
    margin-top: 14px; padding-top: 18px; border-top: 1px solid var(--line);
  }
  .sh-mobile-actions .ai-badge { justify-content: center; padding-block: 10px; font-size: 14px; }
  .sh-mobile-actions .btn { justify-content: center; }

  /* Desktop hides the burger + mobile drawer; theme.css already hides
     .site-navlinks below 900px, so the hub triggers collapse there. */
  @media (max-width: 900px) {
    .sh-desktop-actions { display: none; }
    .sh-burger { display: inline-flex; }
  }
  @media (min-width: 901px) {
    .sh-mobile { display: none !important; }
  }
</style>

<script>
  // Nav interactions — scoped to this component's <header data-sitenav>. Adds
  // click-to-open panels (aria-expanded), Escape + outside-click close, a mobile
  // hamburger accordion, and a fail-safe that opens the real ChatWidget from the
  // "Ask Rebi" seam. The ChatWidget itself is untouched.
  (() => {
    const nav = document.querySelector('[data-sitenav]');
    if (!nav) return;

    const hubs = Array.from(nav.querySelectorAll<HTMLElement>('.sh-hub'));

    const closeHub = (hub: HTMLElement) => {
      hub.removeAttribute('data-open');
      hub.querySelector<HTMLButtonElement>('[data-hub-trigger]')?.setAttribute('aria-expanded', 'false');
    };
    const closeAllHubs = (except?: HTMLElement) => {
      for (const h of hubs) if (h !== except) closeHub(h);
    };
    const openHub = (hub: HTMLElement) => {
      closeAllHubs(hub);
      hub.setAttribute('data-open', '');
      hub.querySelector<HTMLButtonElement>('[data-hub-trigger]')?.setAttribute('aria-expanded', 'true');
    };

    for (const hub of hubs) {
      const trigger = hub.querySelector<HTMLButtonElement>('[data-hub-trigger]');
      trigger?.addEventListener('click', () => {
        if (hub.hasAttribute('data-open')) closeHub(hub);
        else openHub(hub);
      });
    }

    // Mobile drawer.
    const burger = nav.querySelector<HTMLButtonElement>('[data-burger]');
    const drawer = nav.querySelector<HTMLElement>('#sh-mobile');
    const setDrawer = (open: boolean) => {
      if (!drawer || !burger) return;
      drawer.hidden = !open;
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    burger?.addEventListener('click', () => setDrawer(Boolean(drawer?.hidden)));

    // Mobile accordion.
    for (const t of Array.from(nav.querySelectorAll<HTMLButtonElement>('[data-macc-trigger]'))) {
      t.addEventListener('click', () => {
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (!panel) return;
        const open = panel.hidden;
        panel.hidden = !open;
        t.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    // Escape closes any open desktop panel + the drawer, restoring focus.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openHubEl = hubs.find((h) => h.hasAttribute('data-open'));
      if (openHubEl) {
        closeHub(openHubEl);
        openHubEl.querySelector<HTMLButtonElement>('[data-hub-trigger]')?.focus();
      }
      if (drawer && !drawer.hidden) {
        setDrawer(false);
        burger?.focus();
      }
    });

    // Outside-click closes any open desktop panel.
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      const openHubEl = hubs.find((h) => h.hasAttribute('data-open'));
      if (openHubEl && !openHubEl.contains(target)) closeHub(openHubEl);
    });

    // "Ask Rebi" seam: the global ChatWidget listener now owns opening the
    // drawer for any trigger. We keep only the nav-local side-effect — closing
    // the mobile drawer so the chat isn't hidden behind it.
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement | null)?.closest?.('[data-rebi-open]');
      if (!t) return;
      if (drawer && !drawer.hidden) setDrawer(false);
    });
  })();
</script>
