---
// SSR (not prerendered): the page posts to /api/book-service and honours the
// dealer feature flag at request time. Mirrors trade-in.astro / index.astro.
export const prerender = false;

import '../styles/global.css';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ChatWidget from '../components/widgets/ChatWidget.astro';
import { dealerConfig } from '../config/dealer';

const cfg = dealerConfig.service;

// Feature flag — a dealer can hide the booking tool without a deploy. When off,
// the tool simply isn't reachable (the API returns 404 too).
if (!cfg.enabled) return Astro.redirect('/', 302);

const { copy } = cfg;
// Service types come from config (config as data) — never hardcoded in the page.
const serviceTypes = cfg.serviceTypes;

const title = `${copy.heading} — ${dealerConfig.identity.name}`;
const description = copy.subheading;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="page-surface min-h-screen antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <SiteNav active="service" />

    <main id="main-content" tabindex="-1" class="site-container">
      <section class="mx-auto max-w-2xl section-tight">
        <!-- Intro -->
        <div class="text-center">
          <span class="eyebrow">{copy.eyebrow}</span>
          <h1 class="mt-5 text-3xl font-bold tracking-tight text-ink md:text-5xl">
            {copy.heading}
          </h1>
          <p class="lead mx-auto mt-4">{copy.subheading}</p>
          <p class="faint mx-auto mt-3 max-w-xl text-sm">{copy.hours}</p>
        </div>

        <!-- Form card (glass) -->
        <div
          id="service-root"
          data-loading-label={copy.loadingLabel}
          class="glass mt-10 p-6 md:p-8"
        >
          <form id="service-form" novalidate class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="field sm:col-span-1">
              <label class="field-label" for="sv-name">Your name</label>
              <input class="field-input" id="sv-name" name="name" type="text" required
                autocomplete="name" placeholder="e.g. Jordan Smith" />
            </div>
            <div class="field sm:col-span-1">
              <label class="field-label" for="sv-email">Email</label>
              <input class="field-input" id="sv-email" name="email" type="email" required
                autocomplete="email" placeholder="you@example.com" />
            </div>
            <div class="field sm:col-span-1">
              <label class="field-label" for="sv-phone">Phone <span class="faint">(optional)</span></label>
              <input class="field-input" id="sv-phone" name="phone" type="tel"
                autocomplete="tel" placeholder="e.g. 0400 000 000" />
            </div>
            <div class="field sm:col-span-1">
              <label class="field-label" for="sv-service">Service type</label>
              <select class="field-select" id="sv-service" name="serviceType" required>
                <option value="" disabled selected>Choose a service…</option>
                {serviceTypes.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <div class="field sm:col-span-2">
              <label class="field-label" for="sv-vehicle">Your vehicle</label>
              <input class="field-input" id="sv-vehicle" name="vehicle" type="text" required
                autocomplete="off" placeholder="Rego, or make / model / year — e.g. Toyota Corolla 2019" />
            </div>
            <div class="field sm:col-span-2">
              <label class="field-label" for="sv-date">Preferred date <span class="faint">(optional)</span></label>
              <input class="field-input" id="sv-date" name="preferredDate" type="text"
                autocomplete="off" placeholder="e.g. next Tuesday, or week of the 12th" />
            </div>
            <div class="field sm:col-span-2">
              <label class="field-label" for="sv-notes">Anything else? <span class="faint">(optional)</span></label>
              <textarea class="field-textarea" id="sv-notes" name="notes" rows="3"
                placeholder="Tell us about any symptoms, noises, or specific requests."></textarea>
            </div>

            <div class="sm:col-span-2">
              <button
                type="submit"
                id="sv-submit"
                class="btn btn-primary w-full justify-center disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
              >
                <span id="sv-submit-label">{copy.submitLabel}</span>
              </button>
              <p class="faint mt-3 text-xs">
                This sends a request — no appointment is booked until our team confirms a time.
              </p>
            </div>
          </form>

          <!-- Error banner -->
          <p
            id="sv-error"
            role="alert"
            hidden
            class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
          >
          </p>

          <!-- Success -->
          <div
            id="sv-success"
            hidden
            aria-live="polite"
            class="ai-summary mt-8"
          >
            <p id="sv-success-text" class="text-sm font-medium text-ink"></p>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

    <!-- Floating AI chat assistant (Rebi) — self-contained global overlay -->
    <ChatWidget />

    <script>
      const root = document.getElementById('service-root');
      const form = document.getElementById('service-form') as HTMLFormElement | null;
      if (root && form) {
        const loadingLabel = root.dataset.loadingLabel || 'Sending your request…';

        const submit = document.getElementById('sv-submit') as HTMLButtonElement;
        const submitLabel = document.getElementById('sv-submit-label') as HTMLElement;
        const defaultLabel = submitLabel.textContent || 'Request a booking';
        const errorEl = document.getElementById('sv-error') as HTMLElement;
        const successEl = document.getElementById('sv-success') as HTMLElement;
        const successText = document.getElementById('sv-success-text') as HTMLElement;

        const showError = (msg: string) => {
          errorEl.textContent = msg;
          errorEl.hidden = false;
          successEl.hidden = true;
        };

        const setLoading = (on: boolean) => {
          submit.disabled = on;
          submitLabel.textContent = on ? loadingLabel : defaultLabel;
        };

        const isEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorEl.hidden = true;

          const data = new FormData(form);
          const payload = {
            name: String(data.get('name') || '').trim(),
            email: String(data.get('email') || '').trim(),
            phone: String(data.get('phone') || '').trim(),
            vehicle: String(data.get('vehicle') || '').trim(),
            serviceType: String(data.get('serviceType') || ''),
            preferredDate: String(data.get('preferredDate') || '').trim(),
            notes: String(data.get('notes') || '').trim(),
          };

          if (!payload.name) return showError('Please enter your name.');
          if (!isEmail(payload.email)) return showError('Please enter a valid email address.');
          if (!payload.vehicle) return showError('Please tell us about your vehicle.');
          if (!payload.serviceType) return showError('Please choose a service type.');

          setLoading(true);
          try {
            const res = await fetch('/api/book-service', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const body = (await res.json()) as { ok?: boolean; message?: string; error?: string };
            if (!res.ok || !body.ok) {
              showError(body.error || 'We could not send that request right now — please try again.');
              return;
            }
            successText.textContent =
              body.message || "Thanks — we've received your request and will confirm a time.";
            successEl.hidden = false;
            form.reset();
            successEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } catch {
            showError('Something went wrong — please check your connection and try again.');
          } finally {
            setLoading(false);
          }
        });
      }
    </script>

    <style>
      /* NFY form-control primitives (ported from the concept shell, token-driven). */
      .field { display: flex; flex-direction: column; gap: 7px; }
      .field-label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
      .field-input,
      .field-select,
      .field-textarea {
        width: 100%;
        font-family: var(--font-ui);
        font-size: 15px;
        color: var(--ink);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
        transition: border-color 0.16s, box-shadow 0.16s;
      }
      .field-input::placeholder,
      .field-textarea::placeholder { color: var(--ink-faint); }
      .field-input:focus,
      .field-select:focus,
      .field-textarea:focus {
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(15, 181, 166, 0.15);
        outline: none;
      }
      .field-textarea { resize: vertical; min-height: 96px; }
    </style>
  </body>
</html>
