---
import Layout from './_shell/Layout.astro';
import Crumbs from './_shell/Crumbs.astro';
import { icon, base } from './_shell/data';
export const prerender = false;
---
<Layout title="About — Smart Hubs" active="" dockPrompt="Curious about us? Ask me anything.">
  <section class="sh-wrap" style="padding-block:22px 0"><Crumbs items={[['About']]} /></section>

  <section class="sh-wrap sh-hero" style="padding-block:14px 20px">
    <div class="eyebrow">Our story</div>
    <h1 class="sh-h1" style="font-size:clamp(28px,3.4vw,40px)">A local car yard, rebuilt around you.</h1>
    <p class="sh-sub">Since 1998 (demo), we’ve sold cars the way we’d want to buy one — no pressure, honest
      advice, and now an AI that actually helps rather than upsells.</p>
  </section>

  <section class="sh-wrap section-tight" style="padding-top:0">
    <div class="sh-grid sh-cols-4">
      {[['26','years serving the region'],['12','brands under one roof'],['305','cars in stock today'],['4.8★','average review (demo)']].map(([n,l]) => (
        <div class="card sh-panel" style="text-align:center"><div style="font-family:var(--font-display); font-weight:700; font-size:32px; color:var(--teal-deep)">{n}</div><div style="font-size:13px; color:var(--ink-soft)">{l}</div></div>
      ))}
    </div>
  </section>

  <section class="sh-wrap section-tight" style="padding-top:0">
    <div class="sh-grid sh-cols-3">
      {[['heart','Why us','Straight answers, fair prices, and a team that lives locally.'],['shield','How we work','Rebi is grounded on public facts — it never sees your private details.'],['users','Community','We back local clubs, schools and the show each year (demo).']].map(([ic,t,d]) => (
        <div class="card sh-panel"><span set:html={icon(ic,20)} style="color:var(--teal-deep)"></span><b style="display:block; margin:10px 0 4px; font-size:16px">{t}</b><p style="font-size:14px; color:var(--ink-soft)">{d}</p></div>
      ))}
    </div>
  </section>

  <section class="sh-wrap section-tight" style="padding-top:0">
    <div class="eyebrow" style="margin-bottom:12px">The team</div>
    <div class="sh-grid sh-cols-4">
      {[['BT','Brooke T.','Dealer principal'],['JM','Jordan M.','Sales lead'],['SP','Sam P.','Service manager'],['RB','Rebi','AI assistant']].map(([in_,n,r]) => (
        <div class="card sh-panel" style="display:flex; align-items:center; gap:12px">
          {n === 'Rebi' ? <span class="orb orb-halo" style="width:44px; height:44px"></span> : <span class="avatar" style="width:44px; height:44px">{in_}</span>}
          <div><b style="font-size:14.5px">{n}</b><div style="font-size:12.5px; color:var(--ink-faint)">{r}</div></div>
        </div>
      ))}
    </div>
  </section>

  <section class="sh-wrap section-tight" style="padding-top:0">
    <div class="glass sh-panel" style="display:flex; gap:16px; align-items:center; flex-wrap:wrap">
      <span set:html={icon('pin',22)} style="color:var(--teal-deep)"></span>
      <p style="flex:1; min-width:240px; font-size:14px; color:var(--ink-soft)">Multiple locations across the region. Hours, map and departments live on the contact page.</p>
      <a href={base + '/contact'} class="btn btn-primary btn-sm"><span set:html={icon('map',15)}></span> Find us &amp; hours</a>
      <a href={base + '/careers'} class="sh-jump"><span class="sh-jic" set:html={icon('briefcase',15)}></span> Work with us</a>
    </div>
  </section>
</Layout>
