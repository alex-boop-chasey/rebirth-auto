---
import Layout from './_shell/Layout.astro';
import { vehicles, icon, fmt, base } from './_shell/data';
export const prerender = false;
const picks = [vehicles[0], vehicles[4]];
// Action buttons that DO / GO — the Rebi-as-navigator seam.
const actions = [
  ['calc', 'Work out repayments', base + '/finance'],
  ['key', 'Book a test drive', base + '/test-drive'],
  ['swap', 'Add my trade-in', base + '/trade-in'],
  ['grid', 'See all 7-seaters', base + '/browse'],
];
---
<Layout title="Rebi — your AI navigator" active="" hideDock={true}>
  <section class="sh-wrap" style="display:grid; grid-template-columns:260px 1fr 280px; gap:20px; align-items:start; padding-block:22px 48px; min-height:80vh">

    <!-- LEFT: what Rebi can navigate to -->
    <aside style="position:sticky; top:92px; display:flex; flex-direction:column; gap:16px">
      <div class="card sh-panel" style="padding:18px">
        <div style="display:flex; align-items:center; gap:11px; margin-bottom:14px"><span class="orb orb-halo" style="width:40px; height:40px"></span><div><b style="font-family:var(--font-display); font-size:17px">Rebi</b><div style="font-size:12px; color:var(--teal-deep); display:flex; gap:5px; align-items:center"><span style="width:6px; height:6px; border-radius:50%; background:var(--teal)"></span> Online · grounded on 305 cars</div></div></div>
        <a href="#" class="btn btn-primary btn-sm" style="width:100%; justify-content:center"><span set:html={icon('spark',15)}></span> New chat</a>
      </div>
      <div class="glass sh-panel" style="padding:16px 18px">
        <div class="sh-facet-h" style="margin-bottom:10px; font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-faint)">Rebi can take you to…</div>
        {[['grid','Browse','/browse'],['calc','Finance calculator','/finance'],['tag','Offers','/offers'],['swap','Trade-in','/trade-in'],['key','Test drive','/test-drive'],['wrench','Service','/service'],['plug','EV hub','/electric']].map(([ic,t,href]) => (
          <a href={base + href} style="display:flex; align-items:center; gap:10px; font-size:13px; color:var(--ink-soft); padding:7px 0; text-decoration:none"><span set:html={icon(ic,15)} style="color:var(--teal-deep)"></span> {t}</a>
        ))}
      </div>
    </aside>

    <!-- CENTRE: the conversation -->
    <div class="card" style="display:flex; flex-direction:column; overflow:hidden; min-height:76vh">
      <div style="display:flex; align-items:center; gap:11px; padding:16px 22px; border-bottom:1px solid var(--line); background:linear-gradient(120deg, rgba(15,181,166,.06), rgba(85,102,240,.06))">
        <span class="orb orb-halo" style="width:30px; height:30px"></span>
        <div style="flex:1"><b style="font-family:var(--font-display); font-size:15px">Chat with Rebi</b><div style="font-size:11.5px; color:var(--ink-faint)">Grounded only on public listing data — never your private details</div></div>
        <span class="chip chip-teal"><span set:html={icon('shield',13)}></span> Private &amp; honest</span>
      </div>

      <div style="flex:1; padding:24px 22px; display:flex; flex-direction:column; gap:20px">

        <!-- user -->
        <div style="align-self:flex-end; max-width:76%">
          <div style="background:var(--ink); color:#fff; padding:13px 17px; border-radius:16px 16px 4px 16px; font-size:14.5px">Family of five, lots of highway plus gravel to the farm. Around $55k. And where do I even work out repayments?</div>
        </div>

        <!-- rebi answer with a NAVIGATION nudge -->
        <div style="max-width:86%">
          <div style="display:flex; align-items:center; gap:9px; margin-bottom:8px"><span class="orb orb-halo" style="width:26px; height:26px"></span><b style="font-size:13px; color:var(--indigo-deep)">Rebi</b></div>
          <div class="ai-summary scan sh-panel" style="padding:16px 18px">
            <p style="font-size:14.5px; color:var(--ink); line-height:1.6">That mix wants full-time AWD with real clearance. Two five-seaters-plus under $55k stand out — tap either to open it. And repayments live in the calculator; I’ve put a button below so you don’t have to hunt for it.</p>
          </div>
        </div>

        <!-- IN-CHAT CLICKABLE LISTING CARDS -->
        <div style="max-width:90%; display:flex; flex-direction:column; gap:12px">
          {picks.map((p, i) => (
            <a href={base + '/vehicle'} class="card card-lift" style="display:flex; gap:14px; padding:12px; text-decoration:none; color:inherit; align-items:center">
              <div style={`width:110px; height:72px; border-radius:12px; flex:none; background:${p.hue}`}></div>
              <div style="flex:1">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:3px"><span class="chip chip-ai" style="padding:3px 9px">{i === 0 ? 'Top match' : 'Value pick'}</span><span style="font-size:11.5px; color:var(--ink-faint)">{p.condition} · {p.seats} seats</span></div>
                <div style="font-family:var(--font-display); font-weight:600; font-size:15px">{p.year} {p.make} {p.model}</div>
                <div style="font-size:12.5px; color:var(--ink-soft)">{p.aiLine}</div>
              </div>
              <div style="text-align:right"><div style="font-family:var(--font-display); font-weight:700; font-size:17px">{fmt(p.price)}</div><div style="font-size:11px; color:var(--ink-faint)">drive away →</div></div>
            </a>
          ))}
        </div>

        <!-- IN-RESPONSE ACTION BUTTONS (do / go) -->
        <div style="max-width:90%">
          <div style="font-size:12px; color:var(--ink-faint); margin-bottom:8px; font-family:var(--font-mono); letter-spacing:0.08em; text-transform:uppercase">Quick actions</div>
          <div class="sh-jumprow">
            {actions.map(([ic,label,href]) => (
              <a href={href} class="sh-jump sh-jump-ai"><span class="sh-jic" set:html={icon(ic,15)}></span> {label}</a>
            ))}
            <a href={base + '/vehicle'} class="sh-jump"><span class="sh-jic" set:html={icon('heart',15)}></span> Compare these two</a>
          </div>
        </div>

        <!-- follow-up quick replies (chips, not free text) -->
        <div style="max-width:90%; display:flex; flex-wrap:wrap; gap:8px">
          {['Which is better on gravel?', 'Cheaper to service?', 'Show EVs instead', 'Talk to Service'].map((c) => (
            <span class="chip" style="cursor:pointer; background:var(--surface); border-color:var(--line)"><span class="spark" set:html={icon('spark',12)} style="color:var(--indigo); width:12px; height:12px"></span> {c}</span>
          ))}
        </div>

        <!-- a "take me to" navigation example -->
        <div style="align-self:flex-end; max-width:76%">
          <div style="background:var(--ink); color:#fff; padding:13px 17px; border-radius:16px 16px 4px 16px; font-size:14.5px">Actually, take me to the EV hub.</div>
        </div>
        <div style="max-width:80%">
          <div style="display:flex; align-items:center; gap:9px; margin-bottom:8px"><span class="orb orb-halo" style="width:26px; height:26px"></span><b style="font-size:13px; color:var(--indigo-deep)">Rebi</b></div>
          <div class="card sh-panel" style="padding:14px 16px; display:flex; align-items:center; gap:12px; flex-wrap:wrap">
            <span set:html={icon('plug',18)} style="color:var(--teal-deep)"></span>
            <span style="flex:1; min-width:180px; font-size:14px; color:var(--ink-soft)">On it — opening the Electric &amp; hybrid hub with range, charging and running-cost help.</span>
            <a href={base + '/electric'} class="btn btn-primary btn-sm"><span set:html={icon('arrow',15)}></span> Go to EV hub</a>
          </div>
        </div>

        <!-- live typing -->
        <div style="display:flex; align-items:center; gap:9px; color:var(--ink-faint)"><span class="orb" style="width:22px; height:22px"></span><span class="dots"><i></i><i></i><i></i></span></div>
      </div>

      <!-- composer -->
      <div style="padding:14px 18px; border-top:1px solid var(--line)">
        <div class="aisearch" style="box-shadow:none">
          <span set:html={icon('chat',18)} style="color:var(--ink-faint)"></span>
          <input type="text" placeholder="Message Rebi — “book me a test drive in the Outback”" readonly />
          <button class="btn btn-primary btn-sm" style="pointer-events:none"><span set:html={icon('send',15)}></span></button>
        </div>
        <p class="faint" style="font-size:11px; text-align:center; margin-top:9px">Rebi can make mistakes — confirm details with our team. Demo interface, static conversation.</p>
      </div>
    </div>

    <!-- RIGHT: working notes / grounding -->
    <aside style="position:sticky; top:92px; display:flex; flex-direction:column; gap:16px">
      <div class="glass sh-panel" style="padding:18px">
        <div class="sh-facet-h" style="margin-bottom:12px; font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-faint)">Rebi’s working notes</div>
        {[['users','Household','5 people'],['map','Use','Highway + gravel'],['tag','Budget','~$55,000'],['drive','Needs','AWD + clearance']].map(([ic,k,val]) => (
          <div style="display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--line); font-size:13.5px">
            <span style="display:flex; align-items:center; gap:9px; color:var(--ink-soft)"><span set:html={icon(ic,15)} style="color:var(--teal-deep)"></span> {k}</span><b>{val}</b>
          </div>
        ))}
      </div>
      <div class="card sh-panel" style="padding:18px">
        <div style="display:flex; align-items:center; gap:9px; margin-bottom:10px"><span set:html={icon('shield',17)} style="color:var(--teal-deep)"></span><b style="font-family:var(--font-display); font-size:15px">Grounded, not guessing</b></div>
        <p style="font-size:13px; color:var(--ink-soft); line-height:1.5">Rebi speaks only from public listing data and expert reviews — never private dealer notes or your finances — and always hands you to a human to close.</p>
      </div>
      <a href={base + '/contact'} class="card card-lift sh-panel" style="padding:16px; display:flex; gap:12px; align-items:center; text-decoration:none; color:inherit">
        <span class="avatar" style="width:42px; height:42px">BT</span>
        <div><div style="font-size:13.5px; font-weight:600">Prefer a human?</div><div style="font-size:12px; color:var(--ink-faint)">Talk to the team →</div></div>
      </a>
    </aside>
  </section>
</Layout>
