---
import Layout from './_shell/Layout.astro';
import Crumbs from './_shell/Crumbs.astro';
import HubBar from './_shell/HubBar.astro';
import { icon, base } from './_shell/data';
export const prerender = false;
---
<Layout title="Book a service — Smart Hubs" active="service-parts" dockPrompt="When’s your car due? I’ll find a slot.">
  <section class="sh-wrap" style="padding-block:22px 0"><Crumbs items={[['Service & Parts', base + '/service-parts'], ['Book a service']]} /></section>
  <section class="sh-wrap" style="padding-block:14px 8px"><HubBar hubKey="service-parts" current={base + '/service'} /></section>

  <section class="sh-wrap sh-hero" style="padding-block:14px 20px">
    <div class="eyebrow"><span set:html={icon('wrench',13)}></span> Book a service</div>
    <h1 class="sh-h1" style="font-size:clamp(28px,3.4vw,40px)">Servicing without the phone tag.</h1>
    <p class="sh-sub">Log-book and fixed-price servicing for every make. Pick a slot online, or let Rebi find the
      next opening.</p>
  </section>

  <section class="sh-wrap section-tight" style="padding-top:0">
    <div class="sh-grid" style="grid-template-columns:1.1fr 1fr; gap:22px">
      <div class="card sh-panel">
        <div style="display:flex; align-items:center; gap:9px; margin-bottom:16px"><span class="sh-tile-ic" style="margin:0; width:38px; height:38px" set:html={icon('wrench',18)}></span><b style="font-size:16px">Booking details</b></div>
        <div class="sh-grid sh-cols-2" style="gap:0 14px">
          <div class="sh-field"><label>Rego</label><input placeholder="123ABC" /></div>
          <div class="sh-field"><label>Service type</label><select><option>Log-book</option><option>Minor</option><option>Major</option><option>Not sure</option></select></div>
          <div class="sh-field"><label>Preferred date</label><input type="date" /></div>
          <div class="sh-field"><label>Drop-off</label><select><option>Morning</option><option>Afternoon</option></select></div>
        </div>
        <div class="sh-field"><label>Anything to flag?</label><textarea rows="2" placeholder="e.g. noise on braking"></textarea></div>
        <div class="sh-jumprow"><button class="btn btn-primary btn-sm"><span set:html={icon('clock',15)}></span> Request booking</button><a href={base + '/rebi'} class="sh-jump sh-jump-ai"><span class="sh-jic" set:html={icon('spark',15)}></span> Find a slot with Rebi</a></div>
      </div>
      <div style="display:flex; flex-direction:column; gap:18px">
        <div class="card sh-panel">
          <div class="eyebrow" style="margin-bottom:10px">Why book here</div>
          {[['shield','Factory-trained techs','Keeps your warranty intact'],['tag','Fixed-price options','No surprise invoices'],['car','Loan cars','Stay mobile while we work']].map(([ic,t,d]) => (
            <div style="display:flex; gap:10px; padding:8px 0; font-size:13.5px"><span set:html={icon(ic,17)} style="color:var(--teal-deep)"></span><span><b>{t}</b> — <span style="color:var(--ink-soft)">{d}</span></span></div>
          ))}
        </div>
        <div class="glass sh-panel">
          <p style="font-size:14px; color:var(--ink-soft)">Need a part while it’s in? <a href={base + '/parts'} style="color:var(--teal-deep); font-weight:600">Add a parts enquiry →</a></p>
        </div>
      </div>
    </div>
  </section>
</Layout>
