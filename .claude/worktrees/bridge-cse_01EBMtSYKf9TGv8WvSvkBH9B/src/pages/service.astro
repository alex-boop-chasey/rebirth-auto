---
// SSR (not prerendered): the page posts to /api/book-service and honours the
// dealer feature flag at request time. Mirrors trade-in.astro / index.astro.
export const prerender = false;

import '../styles/global.css';
import ChatWidget from '../components/widgets/ChatWidget.astro';
import { dealerConfig } from '../config/dealer';

const cfg = dealerConfig.service;

// Feature flag — a dealer can hide the booking tool without a deploy. When off,
// the tool simply isn't reachable (the API returns 404 too).
if (!cfg.enabled) return Astro.redirect('/', 302);

const { copy } = cfg;
// Service types come from config (config as data) — never hardcoded in the page.
const serviceTypes = cfg.serviceTypes;

const title = `${copy.heading} — ${dealerConfig.identity.name}`;
const description = copy.subheading;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

const inputClass =
  'mt-1.5 block w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10';
const labelClass = 'block text-sm font-medium text-slate-700';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <div class="site-container">
      <!-- Header -->
      <header class="flex items-center justify-between py-6">
        <a href="/" class="text-base font-semibold tracking-tight text-slate-900">
          Rebirth<span class="text-slate-400"> Auto</span>
        </a>
        <nav class="flex items-center gap-6 text-sm">
          <a href="/" class="text-slate-500 transition hover:text-slate-900">Inventory</a>
          <a href="/service" class="font-medium text-slate-900">{copy.navLabel}</a>
        </nav>
      </header>

      <main id="main-content" tabindex="-1">
        <section class="mx-auto max-w-2xl pt-12 pb-16 md:pt-16">
          <!-- Intro -->
          <div class="text-center">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-slate-900/5 px-3 py-1 text-xs font-medium text-slate-600 ring-1 ring-slate-900/10"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              {copy.eyebrow}
            </span>
            <h1 class="mt-6 text-3xl font-bold tracking-tight text-slate-900 md:text-5xl">
              {copy.heading}
            </h1>
            <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">{copy.subheading}</p>
            <p class="mx-auto mt-3 max-w-xl text-sm text-slate-500">{copy.hours}</p>
          </div>

          <!-- Form card -->
          <div
            id="service-root"
            data-loading-label={copy.loadingLabel}
            class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-8"
          >
            <form id="service-form" novalidate class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div class="sm:col-span-1">
                <label class={labelClass} for="sv-name">Your name</label>
                <input class={inputClass} id="sv-name" name="name" type="text" required
                  autocomplete="name" placeholder="e.g. Jordan Smith" />
              </div>
              <div class="sm:col-span-1">
                <label class={labelClass} for="sv-email">Email</label>
                <input class={inputClass} id="sv-email" name="email" type="email" required
                  autocomplete="email" placeholder="you@example.com" />
              </div>
              <div class="sm:col-span-1">
                <label class={labelClass} for="sv-phone">Phone <span class="text-slate-400">(optional)</span></label>
                <input class={inputClass} id="sv-phone" name="phone" type="tel"
                  autocomplete="tel" placeholder="e.g. 0400 000 000" />
              </div>
              <div class="sm:col-span-1">
                <label class={labelClass} for="sv-service">Service type</label>
                <select class={inputClass} id="sv-service" name="serviceType" required>
                  <option value="" disabled selected>Choose a service…</option>
                  {serviceTypes.map((t) => <option value={t}>{t}</option>)}
                </select>
              </div>
              <div class="sm:col-span-2">
                <label class={labelClass} for="sv-vehicle">Your vehicle</label>
                <input class={inputClass} id="sv-vehicle" name="vehicle" type="text" required
                  autocomplete="off" placeholder="Rego, or make / model / year — e.g. Toyota Corolla 2019" />
              </div>
              <div class="sm:col-span-2">
                <label class={labelClass} for="sv-date">Preferred date <span class="text-slate-400">(optional)</span></label>
                <input class={inputClass} id="sv-date" name="preferredDate" type="text"
                  autocomplete="off" placeholder="e.g. next Tuesday, or week of the 12th" />
              </div>
              <div class="sm:col-span-2">
                <label class={labelClass} for="sv-notes">Anything else? <span class="text-slate-400">(optional)</span></label>
                <textarea class={inputClass} id="sv-notes" name="notes" rows="3"
                  placeholder="Tell us about any symptoms, noises, or specific requests."></textarea>
              </div>

              <div class="sm:col-span-2">
                <button
                  type="submit"
                  id="sv-submit"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900/30 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
                >
                  <span id="sv-submit-label">{copy.submitLabel}</span>
                </button>
                <p class="mt-3 text-xs text-slate-500">
                  This sends a request — no appointment is booked until our team confirms a time.
                </p>
              </div>
            </form>

            <!-- Error banner -->
            <p
              id="sv-error"
              role="alert"
              hidden
              class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
            >
            </p>

            <!-- Success -->
            <div
              id="sv-success"
              hidden
              aria-live="polite"
              class="mt-8 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-sm text-emerald-800"
            >
              <p id="sv-success-text" class="font-medium"></p>
            </div>
          </div>
        </section>
      </main>

      <!-- Footer -->
      <footer class="mt-8 border-t border-slate-200 py-8 text-center text-sm text-slate-500">
        © {new Date().getFullYear()} {dealerConfig.identity.name} · Requests are confirmed by our team, not booked automatically.
      </footer>
    </div>

    <!-- Floating AI chat assistant (Rebi) — self-contained global overlay -->
    <ChatWidget />

    <script>
      const root = document.getElementById('service-root');
      const form = document.getElementById('service-form') as HTMLFormElement | null;
      if (root && form) {
        const loadingLabel = root.dataset.loadingLabel || 'Sending your request…';

        const submit = document.getElementById('sv-submit') as HTMLButtonElement;
        const submitLabel = document.getElementById('sv-submit-label') as HTMLElement;
        const defaultLabel = submitLabel.textContent || 'Request a booking';
        const errorEl = document.getElementById('sv-error') as HTMLElement;
        const successEl = document.getElementById('sv-success') as HTMLElement;
        const successText = document.getElementById('sv-success-text') as HTMLElement;

        const showError = (msg: string) => {
          errorEl.textContent = msg;
          errorEl.hidden = false;
          successEl.hidden = true;
        };

        const setLoading = (on: boolean) => {
          submit.disabled = on;
          submitLabel.textContent = on ? loadingLabel : defaultLabel;
        };

        const isEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorEl.hidden = true;

          const data = new FormData(form);
          const payload = {
            name: String(data.get('name') || '').trim(),
            email: String(data.get('email') || '').trim(),
            phone: String(data.get('phone') || '').trim(),
            vehicle: String(data.get('vehicle') || '').trim(),
            serviceType: String(data.get('serviceType') || ''),
            preferredDate: String(data.get('preferredDate') || '').trim(),
            notes: String(data.get('notes') || '').trim(),
          };

          if (!payload.name) return showError('Please enter your name.');
          if (!isEmail(payload.email)) return showError('Please enter a valid email address.');
          if (!payload.vehicle) return showError('Please tell us about your vehicle.');
          if (!payload.serviceType) return showError('Please choose a service type.');

          setLoading(true);
          try {
            const res = await fetch('/api/book-service', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const body = (await res.json()) as { ok?: boolean; message?: string; error?: string };
            if (!res.ok || !body.ok) {
              showError(body.error || 'We could not send that request right now — please try again.');
              return;
            }
            successText.textContent =
              body.message || "Thanks — we've received your request and will confirm a time.";
            successEl.hidden = false;
            form.reset();
            successEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } catch {
            showError('Something went wrong — please check your connection and try again.');
          } finally {
            setLoading(false);
          }
        });
      }
    </script>
  </body>
</html>
