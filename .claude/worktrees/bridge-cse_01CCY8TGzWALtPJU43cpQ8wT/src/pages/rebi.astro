---
// SSR (not prerendered): the full-page Rebi navigator. Ported from
// concepts2/inline-contextual/rebi.astro onto the REAL shell.
//
// CRITICAL — this page reuses the REAL chat mechanics. It does NOT reimplement the
// chat, does NOT duplicate any chat logic, and does NOT bypass grounding. It hosts
// the shipped <ChatWidget/> (which talks to /api/chat with grounding intact) and,
// on load, opens it by clicking the widget's own launcher — the exact mechanism
// the nav "Ask Rebi" seam uses (SiteNav.astro). The page chrome adds a navigator
// "Rebi can take you to…" jump list + example action chips that are all REAL site
// links. No mock conversation lives here.
export const prerender = false;

import '../styles/global.css';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ChatWidget from '../components/widgets/ChatWidget.astro';
import { dealerConfig } from '../config/dealer';

// Jump list — REAL destinations Rebi can take you to (real routes / filter URLs).
const jumps: { icon: string; label: string; href: string }[] = [
  { icon: 'car', label: 'Any car in stock', href: '/listings' },
  { icon: 'calc', label: 'Work out repayments', href: '/finance' },
  { icon: 'tag', label: 'Trade in or sell', href: '/trade-in' },
  { icon: 'play', label: 'Book a test drive', href: '/test-drive' },
  { icon: 'bolt', label: 'The EV & hybrid hub', href: '/electric' },
  { icon: 'phone', label: 'The right person', href: '/contact' },
];

// Example action chips — every one is a REAL link into the site.
const chips: { icon: string; label: string; href: string }[] = [
  { icon: 'filter', label: 'See all 7-seaters', href: '/listings?seats=7' },
  { icon: 'bolt', label: 'Electric & hybrid stock', href: '/listings?fuelType=electric,hybrid' },
  { icon: 'calc', label: 'Repayment calculator', href: '/finance' },
  { icon: 'tag', label: 'Value my trade-in', href: '/trade-in' },
  { icon: 'wrench', label: 'Book a service', href: '/service' },
  { icon: 'phone', label: 'Talk to Sales', href: '/contact' },
];

const icon = (name: string, size = 16): string => {
  const s = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"`;
  const p: Record<string, string> = {
    car: '<path d="M5 11l1.5-4A2 2 0 018.4 6h7.2a2 2 0 011.9 1.3L19 11"/><path d="M4 11h16v5H4z"/><circle cx="7.5" cy="16" r="1.5"/><circle cx="16.5" cy="16" r="1.5"/>',
    calc: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2M12 11h2M16 11h.01M8 15h2M12 15h2M16 15h.01M8 19h6"/>',
    tag: '<path d="M3 12l9-9 8 8-9 9-8-8z"/><circle cx="8" cy="8" r="1.3"/>',
    play: '<circle cx="12" cy="12" r="9"/><path d="M10 8l6 4-6 4z"/>',
    bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
    phone: '<path d="M4 5a2 2 0 012-2h2l2 5-2 1a11 11 0 005 5l1-2 5 2v2a2 2 0 01-2 2A15 15 0 014 5z"/>',
    filter: '<path d="M3 5h18l-7 8v6l-4-2v-4z"/>',
    wrench: '<path d="M14 7a4 4 0 01-5 5l-6 6 2 2 6-6a4 4 0 005-5l-2 2-2-2 2-2z"/>',
    shield: '<path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6z"/>',
    spark: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" fill="currentColor" stroke="none"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    chat: '<path d="M4 5h16v11H9l-4 3v-3H4z"/>',
  };
  return `<svg ${s}>${p[name] ?? ''}</svg>`;
};

const title = `Rebi — your AI navigator · ${dealerConfig.identity.name}`;
const description =
  "Rebi doesn't just answer — it takes you there. Ask where to work out repayments, find an EV, or book a test drive, and Rebi navigates you to the right page.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="page-surface min-h-screen antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <SiteNav />

    <main id="main-content" tabindex="-1">
      <section class="site-container rebi-layout">
        <!-- LEFT: what Rebi can navigate to -->
        <aside class="stack" style="gap:14px">
          <div class="card" style="padding:18px">
            <div style="display:flex; gap:10px; align-items:center; margin-bottom:12px">
              <span class="orb orb-halo" style="width:36px;height:36px"></span>
              <div><b style="font-size:16px">Rebi</b><div style="font-size:11.5px; color:var(--teal-deep)">Your AI navigator</div></div>
            </div>
            <p class="muted" style="font-size:12.5px">Rebi doesn't just answer — it takes you there. Ask "where do I…" and it navigates.</p>
          </div>
          <div class="glass" style="padding:16px 18px">
            <div class="site-foot-h" style="color:var(--ink-faint); margin-bottom:10px">Rebi can take you to</div>
            {jumps.map((j) => (
              <a href={j.href} style="display:flex; gap:10px; align-items:center; font-size:13px; color:var(--ink-soft); padding:7px 0; text-decoration:none">
                <span style="color:var(--teal-deep)" set:html={icon(j.icon, 15)} /> {j.label}
              </a>
            ))}
          </div>
        </aside>

        <!-- CENTRE: the navigator landing. The REAL conversation happens in the
             shipped ChatWidget, which auto-opens on load (see the script below). -->
        <div class="card" style="padding:26px; display:flex; flex-direction:column; gap:18px">
          <div style="display:flex; gap:11px; align-items:center">
            <span class="orb orb-halo" style="width:30px;height:30px"></span>
            <div style="flex:1">
              <b style="font-size:16px; font-family:var(--font-display)">Chat with Rebi</b>
              <div style="font-size:11.5px; color:var(--ink-faint)">Grounded on public listing data — never private dealer notes</div>
            </div>
            <span class="chip chip-teal"><span set:html={icon('shield', 13)} /> Private &amp; honest</span>
          </div>

          <div class="ai-summary" style="padding:18px 20px">
            <p style="font-size:14.5px; line-height:1.6">
              Ask Rebi anything about our cars, finance, servicing or trade-ins. It reads our real
              inventory and takes you straight to the right page — no upsell, no guesswork.
            </p>
            <button type="button" class="btn btn-primary" data-rebi-open data-rebi-kind="nav" style="margin-top:14px" id="rebi-open-cta">
              <span set:html={icon('chat', 16)} /> Ask Rebi
            </button>
          </div>

          <div>
            <div class="site-foot-h" style="color:var(--ink-faint); margin-bottom:10px">Try one of these</div>
            <div style="display:flex; flex-wrap:wrap; gap:8px">
              {chips.map((c) => (
                <a href={c.href} class="rb-act-lg">
                  <span set:html={icon(c.icon, 15)} /> {c.label}
                </a>
              ))}
            </div>
          </div>

          <p class="faint" style="font-size:11px; margin-top:4px">
            Rebi can make mistakes — confirm details with our team. The full chat opens
            automatically; you can close it any time and use the shortcuts above.
          </p>
        </div>
      </section>
    </main>

    <SiteFooter />
    <ChatWidget />

    <script>
      // Auto-open the REAL ChatWidget on load. This clicks the widget's own
      // launcher — the SAME mechanism the nav "Ask Rebi" seam uses (SiteNav.astro)
      // — so the conversation runs entirely through the shipped widget hitting
      // /api/chat with grounding intact. Nothing here touches the chat internals.
      (() => {
        const REDUCED = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
        let opened = false;
        let tries = 0;
        const tryOpen = () => {
          if (opened) return;
          tries += 1;
          const launcher = document.getElementById('reb-launcher') as HTMLElement | null;
          const panel = document.getElementById('reb-panel') as HTMLElement | null;
          if (launcher && panel) {
            if (panel.hidden) launcher.click(); // → the widget's own openPanel()
            opened = true;
            return;
          }
          if (tries < 40) setTimeout(tryOpen, 50); // widget script still initialising
        };
        // A short beat so the page paints its navigator chrome first, then the
        // chat slides in over it (skipped under reduced-motion → open promptly).
        const start = () => setTimeout(tryOpen, REDUCED ? 0 : 350);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start, { once: true });
        } else {
          start();
        }
      })();
    </script>

    <style>
      .rebi-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 24px;
        padding-block: 26px 60px;
        align-items: start;
        min-height: 72vh;
      }
      .rebi-layout aside { position: sticky; top: 92px; }
      @media (max-width: 820px) {
        .rebi-layout { grid-template-columns: 1fr; }
        .rebi-layout aside { position: static; }
      }
      .rb-act-lg {
        display: inline-flex; align-items: center; gap: 7px; text-decoration: none;
        font-size: 13.5px; font-weight: 600; color: var(--indigo-deep);
        background: var(--indigo-glow); border: 1px solid rgba(85, 102, 240, 0.22);
        padding: 9px 15px; border-radius: var(--r-pill);
        transition: background 0.15s, transform 0.15s;
      }
      .rb-act-lg:hover { background: rgba(85, 102, 240, 0.16); transform: translateY(-1px); }
    </style>
  </body>
</html>
