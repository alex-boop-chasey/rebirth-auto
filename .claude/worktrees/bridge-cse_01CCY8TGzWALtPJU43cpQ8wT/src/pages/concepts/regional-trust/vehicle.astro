---
export const prerender = false;
import '../../../styles/global.css';
import Layout from './_components/Layout.astro';
import VehicleCard from './_components/VehicleCard.astro';
import { vehicles, money } from './_data';
const v = vehicles[0]; // 2024 Toyota RAV4 Cruiser Hybrid
const similar = vehicles.slice(1, 4);
const specs = [
  ['Odometer', '12,480 km'], ['Transmission', '8-speed Auto'], ['Fuel', 'Hybrid (petrol/electric)'],
  ['Drive', 'All-wheel drive'], ['Body', 'SUV · 5 seats'], ['Engine', '2.5L 4-cyl hybrid'],
  ['Fuel use', '4.8 L/100km (claimed)'], ['ANCAP', '5 star (2019)'], ['Colour', 'Eclipse Black'],
  ['Rego', 'Demo — DEMO·000'],
];
const gallery = ['g-sage', 'g-navy', 'g-teal', 'g-clay'];
---
<Layout title={`${v.year} ${v.make} ${v.model}`} active="listings">
  <div class="rt-wrap rt-breadcrumb">
    <a href="/concepts/regional-trust/listings">Browse</a> › <a href="/concepts/regional-trust/listings">SUV</a> › <span>{v.year} {v.make} {v.model}</span>
  </div>

  <section class="rt-wrap rt-vd-top">
    <!-- gallery -->
    <div class="rt-vd-gallery">
      <div class={`rt-photo ${v.tag} rt-vd-main`}>
        <span class="rt-pill rt-pill-gold rt-vd-cond">{v.condition} · {v.badge}</span>
        <span class="rt-vd-shot">Main photo</span>
      </div>
      <div class="rt-vd-thumbs">
        {gallery.map((g, i) => <div class={`rt-photo ${g} rt-vd-thumb ${i === 0 ? 'is-active' : ''}`}><span>{i + 1}</span></div>)}
        <div class="rt-vd-thumb rt-vd-more">+18<br /><em>photos</em></div>
      </div>
    </div>

    <!-- buy rail -->
    <aside class="rt-vd-rail">
      <div class="rt-card rt-vd-buy">
        <h1>{v.year} {v.make} {v.model}</h1>
        <p class="rt-vd-variant">{v.variant}</p>
        <div class="rt-vd-price">
          <span class="rt-vd-price-label">Drive-away, no more to pay</span>
          <span class="rt-vd-price-num">{money(v.price)}</span>
          <span class="rt-vd-price-fin">or approx. <strong>$168/wk</strong> · <a href="/concepts/regional-trust/finance">estimate finance →</a></span>
        </div>
        <div class="rt-vd-actions">
          <a href="/concepts/regional-trust/test-drive" class="rt-btn rt-btn-primary">Book a test drive</a>
          <a href="/concepts/regional-trust/finance" class="rt-btn rt-btn-clay">Get finance estimate</a>
          <a href="/concepts/regional-trust/rebi" class="rt-btn rt-btn-ghost"><span class="rt-rebi-orb"></span> Ask Rebi about this car</a>
        </div>
        <div class="rt-vd-assure">
          <span>✓ Inspected &amp; safety-certified</span>
          <span>✓ Balance of factory warranty</span>
          <span>✓ Trade-in &amp; sell welcome</span>
        </div>
      </div>

      <!-- smart lead capture -->
      <div class="rt-card rt-vd-lead">
        <strong>Not ready to visit? Ask a quick question.</strong>
        <input class="rt-input" type="text" placeholder="Your name" />
        <input class="rt-input" type="text" placeholder="Mobile or email" />
        <textarea class="rt-input" rows="2" placeholder="e.g. Is it still available Saturday?"></textarea>
        <button class="rt-btn rt-btn-primary">Send to the team</button>
        <p class="rt-vd-lead-note"><span class="rt-rebi-orb"></span> Rebi replies instantly, a real local follows up.</p>
      </div>
    </aside>
  </section>

  <section class="rt-wrap rt-vd-body">
    <div class="rt-vd-main-col">
      <!-- AI summary, prominent -->
      <div class="rt-rebi-panel rt-vd-ai">
        <div class="rt-vd-ai-head">
          <span class="rt-rebi-orb lg"></span>
          <div><strong>Rebi’s honest take</strong><em>AI summary · written from this car’s details &amp; history</em></div>
        </div>
        <p class="rt-vd-ai-lead">“Genuinely one of the easiest cars to recommend right now. It’s a low-km demo, so you get near-new
          for a real saving, and the hybrid drivetrain means you’ll feel it most at the bowser doing town driving.”</p>
        <div class="rt-vd-ai-cols">
          <div><h5>Who it suits</h5><p>Families, first-hybrid buyers, anyone doing lots of short town trips.</p></div>
          <div><h5>Worth knowing</h5><p>It’s a demo, so it has a few delivery km. Warranty runs from first registration.</p></div>
          <div><h5>Running cost</h5><p>Expect roughly $28–34/wk in fuel around town — well under a petrol equivalent.</p></div>
        </div>
        <div class="rt-vd-ai-chips">
          <span class="rt-chip">Compare with the CX-5</span>
          <span class="rt-chip">What’s servicing cost?</span>
          <span class="rt-chip">Is finance worth it?</span>
        </div>
      </div>

      <!-- specs -->
      <div class="rt-vd-specs">
        <h2>The details</h2>
        <div class="rt-vd-spec-grid">
          {specs.map(([k, val]) => <div class="rt-vd-spec"><span>{k}</span><strong>{val}</strong></div>)}
        </div>
      </div>

      <!-- features -->
      <div class="rt-vd-features">
        <h2>Features &amp; extras</h2>
        <div class="rt-vd-feat-grid">
          {['Apple CarPlay & Android Auto', 'Adaptive cruise control', 'Heated front seats', 'Power tailgate', 'Wireless charging', '360° camera', 'Blind-spot monitor', 'Dual-zone climate', 'LED headlights'].map((f) => <span class="rt-vd-feat">✓ {f}</span>)}
        </div>
      </div>

      <!-- EDMUNDS EXPERT REVIEW SLOT -->
      <div class="rt-card rt-vd-expert">
        <div class="rt-vd-expert-head">
          <div>
            <span class="rt-pill rt-pill-sand">Expert review</span>
            <h2>What the critics say about the {v.make} {v.model}</h2>
          </div>
          <div class="rt-vd-expert-attr">
            <span class="rt-vd-edmunds">Edmunds</span>
            <span class="rt-vd-expert-by">Review by Edmunds</span>
          </div>
        </div>
        <div class="rt-vd-expert-score">
          <div class="rt-vd-score-ring"><strong>8.4</strong><em>/10</em></div>
          <div class="rt-vd-score-bars">
            {[['Performance', 80], ['Comfort', 88], ['Interior', 84], ['Value', 90], ['Fuel economy', 95]].map(([l, n]) => (
              <div class="rt-vd-score-row"><span>{l}</span><div class="rt-vd-bar"><div class="rt-vd-bar-fill" style={`width:${n}%`}></div></div></div>
            ))}
          </div>
        </div>
        <p class="rt-vd-expert-quote">“A sensible, efficient and well-rounded family SUV. The hybrid powertrain delivers strong
          real-world economy, and the cabin is spacious and comfortable for the class.”</p>
        <div class="rt-vd-expert-foot">
          <span class="rt-vd-expert-logo">Logo / link placeholder</span>
          <a class="rt-vd-expert-link" href="#">Read the full expert review on Edmunds →</a>
        </div>
        <p class="rt-vd-expert-disclaimer">Expert review content and rating attributed to Edmunds. Placeholder for demo — not live.</p>
      </div>
    </div>

    <!-- side rail: dealer + Rebi -->
    <aside class="rt-vd-side">
      <div class="rt-card rt-vd-dealer">
        <span class="rt-rebi-orb lg"></span>
        <h3>Talk to a real local</h3>
        <p>Our team’s here Mon–Sat. No pressure — just honest answers about this car.</p>
        <a href="/concepts/regional-trust/contact" class="rt-btn rt-btn-ghost rt-btn-sm">Call the yard</a>
      </div>
      <div class="rt-card rt-vd-trade">
        <h4>Got a car to trade?</h4>
        <p>Get an instant Rebi estimate and put it toward this one.</p>
        <a href="/concepts/regional-trust/sell" class="rt-btn rt-btn-clay rt-btn-sm">Value my car</a>
      </div>
    </aside>
  </section>

  <section class="rt-wrap rt-section rt-vd-similar">
    <div class="rt-section-head"><div><span class="rt-eyebrow">You might also like</span><h2>Similar cars locals looked at</h2></div></div>
    <div class="rt-vd-similar-grid">{similar.map((s) => <VehicleCard v={s} />)}</div>
  </section>
</Layout>

<style>
  .rt-breadcrumb { padding-block: 20px 8px; font-size: 13px; color: var(--muted); }
  .rt-breadcrumb a:hover { color: var(--green); }
  .rt-vd-top { display: grid; grid-template-columns: 1fr 400px; gap: 32px; padding-block: 16px 40px; align-items: start; }
  .rt-vd-main { height: 460px; display: grid; place-items: center; }
  .rt-vd-shot { color: rgba(255,255,255,.55); font-weight: 800; letter-spacing: .16em; text-transform: uppercase; font-size: 13px; z-index: 1; }
  .rt-vd-cond { position: absolute; top: 16px; left: 16px; z-index: 2; }
  .rt-vd-thumbs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-top: 12px; }
  .rt-vd-thumb { height: 78px; display: grid; place-items: center; color: rgba(255,255,255,.7); font-weight: 800; cursor: pointer; }
  .rt-vd-thumb.is-active { outline: 3px solid var(--green); outline-offset: 2px; }
  .rt-vd-more { background: var(--sand); color: var(--ink-70); text-align: center; line-height: 1.1; }
  .rt-vd-more em { font-style: normal; font-size: 11px; color: var(--muted); }

  .rt-vd-rail { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 120px; }
  .rt-vd-buy { padding: 24px; }
  .rt-vd-buy h1 { font-size: 28px; }
  .rt-vd-variant { color: var(--muted); font-size: 15px; margin-top: 4px; }
  .rt-vd-price { background: var(--green-soft); border: 1px solid var(--green-line); border-radius: var(--r); padding: 16px; margin: 18px 0; }
  .rt-vd-price-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--green); }
  .rt-vd-price-num { display: block; font-family: var(--ff-display); font-size: 40px; font-weight: 700; color: var(--green-deep); margin: 2px 0 4px; }
  .rt-vd-price-fin { font-size: 13px; color: var(--ink-70); }
  .rt-vd-price-fin a { color: var(--clay); font-weight: 700; }
  .rt-vd-actions { display: flex; flex-direction: column; gap: 10px; }
  .rt-vd-actions .rt-btn { width: 100%; }
  .rt-vd-assure { display: flex; flex-direction: column; gap: 7px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line-soft); font-size: 13px; color: var(--ink-70); font-weight: 600; }
  .rt-vd-lead { padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .rt-vd-lead strong { font-size: 15px; }
  .rt-vd-lead .rt-btn { width: 100%; }
  .rt-vd-lead-note { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--muted); }
  .rt-vd-lead-note .rt-rebi-orb { flex: 0 0 auto; }

  .rt-vd-body { display: grid; grid-template-columns: 1fr 300px; gap: 32px; padding-block: 20px 40px; align-items: start; }
  .rt-vd-main-col { display: flex; flex-direction: column; gap: 32px; }
  .rt-vd-ai { padding: 24px; }
  .rt-vd-ai-head { display: flex; gap: 12px; align-items: center; margin-bottom: 14px; }
  .rt-vd-ai-head strong { display: block; font-size: 18px; color: var(--green-deep); }
  .rt-vd-ai-head em { font-style: normal; font-size: 13px; color: var(--ink-70); }
  .rt-vd-ai-lead { font-family: var(--ff-display); font-size: 20px; line-height: 1.4; color: var(--ink); margin-bottom: 20px; }
  .rt-vd-ai-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; padding: 18px 0; border-top: 1px solid var(--green-line); border-bottom: 1px solid var(--green-line); }
  .rt-vd-ai-cols h5 { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--green); font-family: var(--ff-body); font-weight: 800; margin-bottom: 6px; }
  .rt-vd-ai-cols p { font-size: 13.5px; color: var(--ink-70); }
  .rt-vd-ai-chips { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }

  .rt-vd-specs h2, .rt-vd-features h2 { font-size: 26px; margin-bottom: 18px; }
  .rt-vd-spec-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 32px; }
  .rt-vd-spec { display: flex; justify-content: space-between; padding: 13px 0; border-bottom: 1px solid var(--line-soft); font-size: 14px; }
  .rt-vd-spec span { color: var(--muted); }
  .rt-vd-spec strong { color: var(--ink); font-weight: 700; }
  .rt-vd-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .rt-vd-feat { font-size: 14px; color: var(--ink-70); font-weight: 600; }

  /* Edmunds expert review */
  .rt-vd-expert { padding: 26px; background: linear-gradient(180deg, var(--cream), var(--white)); }
  .rt-vd-expert-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 22px; }
  .rt-vd-expert-head h2 { font-size: 24px; margin-top: 10px; max-width: 420px; }
  .rt-vd-expert-attr { text-align: right; flex: 0 0 auto; }
  .rt-vd-edmunds { display: block; font-family: var(--ff-display); font-weight: 700; font-size: 24px; color: var(--navy); letter-spacing: -.02em; }
  .rt-vd-expert-by { font-size: 12px; color: var(--muted); font-weight: 700; }
  .rt-vd-expert-score { display: grid; grid-template-columns: 130px 1fr; gap: 28px; align-items: center; margin-bottom: 20px; }
  .rt-vd-score-ring { width: 118px; height: 118px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--green) 0 84%, var(--sand) 84% 100%); position: relative; }
  .rt-vd-score-ring::before { content: ''; position: absolute; inset: 10px; background: var(--white); border-radius: 50%; }
  .rt-vd-score-ring strong { position: relative; font-family: var(--ff-display); font-size: 34px; color: var(--green-deep); line-height: 1; }
  .rt-vd-score-ring em { position: relative; font-style: normal; font-size: 12px; color: var(--muted); }
  .rt-vd-score-bars { display: flex; flex-direction: column; gap: 9px; }
  .rt-vd-score-row { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 12px; font-size: 13px; color: var(--ink-70); font-weight: 600; }
  .rt-vd-bar { height: 8px; border-radius: 4px; background: var(--sand); overflow: hidden; }
  .rt-vd-bar-fill { height: 100%; background: var(--green); border-radius: 4px; }
  .rt-vd-expert-quote { font-family: var(--ff-display); font-size: 18px; font-style: italic; line-height: 1.5; color: var(--ink); padding: 16px 20px; border-left: 3px solid var(--clay); background: var(--paper); border-radius: 0 12px 12px 0; }
  .rt-vd-expert-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 18px; }
  .rt-vd-expert-logo { font-size: 12px; color: var(--muted); border: 1px dashed var(--line); border-radius: 8px; padding: 8px 14px; }
  .rt-vd-expert-link { font-weight: 700; color: var(--navy); font-size: 15px; }
  .rt-vd-expert-disclaimer { font-size: 11.5px; color: var(--muted); margin-top: 12px; }

  .rt-vd-side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 120px; }
  .rt-vd-dealer { padding: 22px; }
  .rt-vd-dealer h3 { font-size: 20px; margin: 12px 0 6px; }
  .rt-vd-dealer p { font-size: 14px; color: var(--ink-70); margin-bottom: 14px; }
  .rt-vd-trade { padding: 22px; background: var(--clay-soft); border-color: #eccbb9; }
  .rt-vd-trade h4 { font-size: 17px; margin-bottom: 6px; }
  .rt-vd-trade p { font-size: 14px; color: var(--ink-70); margin-bottom: 14px; }

  .rt-vd-similar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
</style>
