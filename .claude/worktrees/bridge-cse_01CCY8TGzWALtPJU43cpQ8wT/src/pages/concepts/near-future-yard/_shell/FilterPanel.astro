---
import { icon } from './data';
---
<aside class="nfy-filter" style="width:288px">
  <div class="nfy-card" style="padding:20px 22px">
    <div class="nfy-row" style="justify-content:space-between; margin-bottom:4px">
      <div class="nfy-row" style="gap:8px"><span set:html={icon('filter',18)} style="color:var(--teal-deep)"></span><b style="font-family:var(--font-display); font-size:17px">Refine</b></div>
      <span style="font-size:13px; color:var(--teal-deep); font-weight:600">Reset</span>
    </div>

    <!-- AI assist inside the filter — the "smart filter" idea -->
    <div class="nfy-ai-summary" style="padding:12px 13px; margin:14px 0 4px">
      <div class="nfy-row" style="gap:7px; margin-bottom:6px"><span class="nfy-spark" set:html={icon('spark',14)} style="color:var(--indigo)"></span><b style="font-size:12.5px; color:var(--indigo-deep)">Rebi filter</b></div>
      <p style="font-size:12.5px; color:var(--ink-soft); line-height:1.4">Describe it in words — “diesel 4x4 that tows 3t under $70k” — and I’ll set these for you.</p>
    </div>

    <div class="nfy-filter-group">
      <div class="nfy-filter-h">Condition</div>
      <div class="nfy-seg">
        <button class="is-on">New</button><button>Demo</button><button>Used</button>
      </div>
    </div>

    <div class="nfy-filter-group">
      <div class="nfy-filter-h">Body type</div>
      {['SUV','Ute','Wagon','Van','Hatch'].map((b,i) => (
        <label class="nfy-check">
          <span class="nfy-row" style="gap:10px"><span class={`nfy-box ${i<2?'is-on':''}`}></span> {b}</span>
          <span>{[124,86,31,18,42][i]}</span>
        </label>
      ))}
    </div>

    <div class="nfy-filter-group">
      <div class="nfy-filter-h">Price</div>
      <div class="nfy-range"><i></i><b style="left:14%"></b><b style="left:74%"></b></div>
      <div class="nfy-row" style="justify-content:space-between; font-size:13px; color:var(--ink-soft)"><span>$25,000</span><span>$70,000</span></div>
    </div>

    <div class="nfy-filter-group">
      <div class="nfy-filter-h">Fuel</div>
      <div class="nfy-pillrow">
        {['Petrol','Diesel','Hybrid','Electric'].map((f,i) => (
          <span class={`nfy-chip ${i===3?'nfy-chip--teal':''}`}>{f}</span>
        ))}
      </div>
    </div>

    <div class="nfy-filter-group">
      <div class="nfy-filter-h">Drivetrain</div>
      <div class="nfy-pillrow">
        {['FWD','AWD','4x4','RWD'].map(d => <span class="nfy-chip">{d}</span>)}
      </div>
    </div>
  </div>
</aside>
