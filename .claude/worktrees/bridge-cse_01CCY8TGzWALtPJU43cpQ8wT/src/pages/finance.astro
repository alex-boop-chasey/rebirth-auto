---
// SSR (not prerendered): honours the dealer feature flag at request time and
// reads `?price=` to prefill the calculator. Mirrors service.astro / trade-in.astro.
export const prerender = false;

import '../styles/global.css';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ChatWidget from '../components/widgets/ChatWidget.astro';
import { dealerConfig } from '../config/dealer';

const cfg = dealerConfig.finance;

// Feature flag — a dealer can hide the finance tool without a deploy.
if (!cfg.enabled) return Astro.redirect('/', 302);

const { copy, bounds } = cfg;
const { locale, currency } = dealerConfig.locale;

// Prefill price from `?price=` (arriving from a vehicle), clamped to the slider
// bounds; fall back to the configured default. Never fabricate a figure.
const rawPrice = Number(Astro.url.searchParams.get('price'));
const price =
  Number.isFinite(rawPrice) && rawPrice > 0
    ? Math.min(Math.max(Math.round(rawPrice), bounds.price.min), bounds.price.max)
    : cfg.fallbackPrice;

// Seed deposit/term/rate from config defaults (deposit as a % of the price).
const deposit = Math.min(
  Math.max(Math.round((price * cfg.depositPct) / 100), bounds.deposit.min),
  bounds.deposit.max,
);
const termMonths = cfg.defaultTermMonths;
const aprPct = cfg.defaultAprPct;

// Tiny inline icon set (self-contained, no concept dependency).
const icon = (name: string, size = 16): string => {
  const s = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"`;
  const p: Record<string, string> = {
    calc: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2M12 11h2M16 11h.01M8 15h2M12 15h2M16 15h.01M8 19h6"/>',
    tag: '<path d="M3 12l9-9 8 8-9 9-8-8z"/><circle cx="8" cy="8" r="1.3"/>',
    swap: '<path d="M7 4v13M7 4L4 7M7 4l3 3M17 20V7M17 20l3-3M17 20l-3-3"/>',
    filter: '<path d="M3 5h18l-7 8v6l-4-2v-4z"/>',
    spark: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" fill="currentColor" stroke="none"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  };
  return `<svg ${s}>${p[name] ?? ''}</svg>`;
};

const title = `${copy.heading} — ${dealerConfig.identity.name}`;
const description = copy.subheading;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="page-surface min-h-screen antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <SiteNav active="buy-own" />

    <main id="main-content" tabindex="-1">
      <section class="site-container hero-wrap">
        <div class="entry-origin">Reached from a vehicle's price · Rebi · footer</div>
        <span class="eyebrow"><span set:html={icon('calc', 13)} /> {copy.eyebrow}</span>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-5xl">{copy.heading}</h1>
        <p class="lead mt-3 max-w-2xl">{copy.subheading}</p>
      </section>

      <section class="site-container fin-layout">
        <!-- CALCULATOR (real client-side computation) -->
        <div
          class="card fin-calc"
          id="fin-root"
          data-locale={locale}
          data-currency={currency}
        >
          <div class="fin-calc-head">
            <h2 class="text-lg font-semibold text-ink">Repayment calculator</h2>
            <span class="chip chip-ai"><span set:html={icon('spark', 12)} /> indicative</span>
          </div>

          <div class="fin-field">
            <div class="fin-field-row">
              <label class="muted" for="fin-price" style="font-size:13.5px">Vehicle price</label>
              <b id="fin-price-val" style="font-size:14.5px">—</b>
            </div>
            <input
              class="slider" type="range" id="fin-price" name="price"
              min={bounds.price.min} max={bounds.price.max} step="500" value={price}
              aria-label="Vehicle price"
            />
          </div>

          <div class="fin-field">
            <div class="fin-field-row">
              <label class="muted" for="fin-deposit" style="font-size:13.5px">Deposit</label>
              <b id="fin-deposit-val" style="font-size:14.5px">—</b>
            </div>
            <input
              class="slider" type="range" id="fin-deposit" name="deposit"
              min={bounds.deposit.min} max={bounds.deposit.max} step="250" value={deposit}
              aria-label="Deposit"
            />
          </div>

          <div class="fin-field">
            <div class="fin-field-row">
              <label class="muted" for="fin-term" style="font-size:13.5px">Term</label>
              <b id="fin-term-val" style="font-size:14.5px">—</b>
            </div>
            <input
              class="slider" type="range" id="fin-term" name="termMonths"
              min={bounds.termMonths.min} max={bounds.termMonths.max} step="6" value={termMonths}
              aria-label="Loan term in months"
            />
          </div>

          <div class="fin-field">
            <div class="fin-field-row">
              <label class="muted" for="fin-rate" style="font-size:13.5px">Rate (comparison)</label>
              <b id="fin-rate-val" style="font-size:14.5px">—</b>
            </div>
            <input
              class="slider" type="range" id="fin-rate" name="aprPct"
              min={bounds.aprPct.min} max={bounds.aprPct.max} step="0.1" value={aprPct}
              aria-label="Comparison interest rate"
            />
          </div>

          <hr class="divider" style="margin:6px 0 18px" />

          <div class="fin-results">
            <div class="ai-summary fin-result">
              <div class="faint" style="font-size:12px">Indicative weekly</div>
              <div class="fin-amount">
                <span id="fin-weekly">—</span><span class="fin-per">/wk</span>
              </div>
            </div>
            <div class="ai-summary fin-result">
              <div class="faint" style="font-size:12px">Indicative monthly</div>
              <div class="fin-amount">
                <span id="fin-monthly">—</span><span class="fin-per">/mo</span>
              </div>
            </div>
          </div>

          <p class="faint mt-4 text-xs leading-relaxed">{copy.disclaimer}</p>
        </div>

        <!-- side rail: pre-qualify, offers/trade folds, Rebi -->
        <aside class="stack fin-rail" style="gap:14px">
          <div class="card" style="padding:22px">
            <h3 class="text-base font-semibold text-ink" style="margin-bottom:6px">Get pre-qualified</h3>
            <p class="muted" style="font-size:13.5px">Shop with a firm budget in mind. Ask Rebi — no impact to browse.</p>
            <button
              class="btn btn-primary w-full justify-center"
              style="margin-top:14px"
              data-rebi-open data-rebi-kind="nav"
            >
              <span set:html={icon('spark', 15)} /> Pre-qualify with Rebi
            </button>
          </div>

          <!-- finance ↔ offers fold -->
          <a href="/offers" class="entry entry--amber">
            <span class="entry-ic" set:html={icon('tag', 18)} />
            <span class="entry-tx"><b>See current offers</b><span>drive-away & specials</span></span>
            <span class="entry-go" set:html={icon('arrow', 15)} />
          </a>
          <!-- trade as deposit -->
          <a href="/trade-in" class="entry">
            <span class="entry-ic" set:html={icon('swap', 18)} />
            <span class="entry-tx"><b>Trade as deposit</b><span>value your car, reduce the amount financed</span></span>
            <span class="entry-go" set:html={icon('arrow', 15)} />
          </a>
          <a href="/listings" class="entry">
            <span class="entry-ic" set:html={icon('filter', 18)} />
            <span class="entry-tx"><b>Find a car in this budget</b><span>filter by price</span></span>
            <span class="entry-go" set:html={icon('arrow', 15)} />
          </a>
        </aside>
      </section>

      <section class="site-container section">
        <h2 class="text-xl font-semibold text-ink" style="margin-bottom:16px">Common questions</h2>
        <div class="grid-auto" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,20rem),1fr))">
          {[
            ['Do you finance used cars?', 'Yes — new, demo and used, subject to application and approval.'],
            ['Will working out a repayment affect my credit?', "This on-page estimate won't — it's a calculation, not an application."],
            ['Can I pay it out early?', 'Most finance products allow early payout — ask us about any fees on the specific product.'],
            ['Can a trade-in be my deposit?', 'Yes — value your car and it reduces the amount financed.'],
          ].map(([q, a]) => (
            <div class="card" style="padding:18px">
              <b style="font-size:14.5px">{q}</b>
              <p class="muted" style="font-size:13.5px; margin-top:6px">{a}</p>
            </div>
          ))}
        </div>
      </section>
    </main>

    <SiteFooter />
    <ChatWidget />

    <script>
      const root = document.getElementById('fin-root');
      if (root) {
        const locale = root.dataset.locale || 'en-AU';
        const currency = root.dataset.currency || 'AUD';
        const money = new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: 0 });

        const priceEl = document.getElementById('fin-price') as HTMLInputElement;
        const depositEl = document.getElementById('fin-deposit') as HTMLInputElement;
        const termEl = document.getElementById('fin-term') as HTMLInputElement;
        const rateEl = document.getElementById('fin-rate') as HTMLInputElement;

        const priceVal = document.getElementById('fin-price-val') as HTMLElement;
        const depositVal = document.getElementById('fin-deposit-val') as HTMLElement;
        const termVal = document.getElementById('fin-term-val') as HTMLElement;
        const rateVal = document.getElementById('fin-rate-val') as HTMLElement;
        const weeklyEl = document.getElementById('fin-weekly') as HTMLElement;
        const monthlyEl = document.getElementById('fin-monthly') as HTMLElement;

        const monthsLabel = (m: number) => {
          const years = m / 12;
          if (Number.isInteger(years)) return `${years} ${years === 1 ? 'year' : 'years'}`;
          return `${m} months`;
        };

        const compute = () => {
          const price = Number(priceEl.value);
          // Deposit can't exceed the price — clamp for an honest financed amount.
          const deposit = Math.min(Number(depositEl.value), price);
          const months = Number(termEl.value);
          const apr = Number(rateEl.value);
          const financed = Math.max(0, price - deposit);

          // Standard amortised monthly repayment: M = P·r / (1 − (1+r)^−n).
          const r = apr / 100 / 12;
          const monthly = financed <= 0
            ? 0
            : r > 0
              ? (financed * r) / (1 - Math.pow(1 + r, -months))
              : financed / months;
          const weekly = (monthly * 12) / 52;

          priceVal.textContent = money.format(price);
          depositVal.textContent = money.format(deposit);
          termVal.textContent = monthsLabel(months);
          rateVal.textContent = `${apr.toFixed(1)}% p.a.`;
          weeklyEl.textContent = money.format(Math.round(weekly));
          monthlyEl.textContent = money.format(Math.round(monthly));
        };

        for (const el of [priceEl, depositEl, termEl, rateEl]) {
          el.addEventListener('input', compute);
        }
        compute();
      }
    </script>

    <style>
      .fin-layout {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 26px;
        align-items: start;
        padding-bottom: 20px;
      }
      @media (max-width: 820px) {
        .fin-layout { grid-template-columns: 1fr; }
      }
      .fin-calc { padding: 26px; }
      .fin-calc-head {
        display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;
      }
      .fin-field { margin-bottom: 20px; }
      .fin-field-row { display: flex; justify-content: space-between; margin-bottom: 8px; }
      /* Visible focus ring on the range sliders (accessibility). */
      .slider:focus-visible {
        outline: 2px solid var(--indigo);
        outline-offset: 4px;
      }
      .fin-results { display: flex; gap: 16px; flex-wrap: wrap; }
      .fin-result { flex: 1; min-width: 170px; padding: 18px 20px; }
      .fin-amount {
        font-family: var(--font-display); font-weight: 700; font-size: 30px; color: var(--indigo-deep);
        line-height: 1.1; margin-top: 2px;
      }
      .fin-per { font-size: 14px; color: var(--ink-faint); font-weight: 500; }
      .fin-rail { position: sticky; top: 92px; }
      @media (max-width: 820px) {
        .fin-rail { position: static; }
      }
    </style>
  </body>
</html>
