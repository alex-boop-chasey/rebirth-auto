---
// SSR (not prerendered): reads the dealer config feature flag + the live
// businessInfo document at request time. Ported from
// concepts2/inline-contextual/contact.astro onto the REAL shell + REAL config.
//
// DETERMINISM: the contact FACTS (phone / email / address / opening hours) are
// read from the businessInfo Sanity document — the existing source of truth,
// REUSED not duplicated — and each is placeholder-GATED, so a made-up phone or
// address is NEVER printed. The department cards are navigation only (no
// fabricated per-department phone/hours). The form posts to the stubbed
// /api/contact-enquiry.
export const prerender = false;

import '../styles/global.css';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ChatWidget from '../components/widgets/ChatWidget.astro';
import { dealerConfig } from '../config/dealer';
import { client } from '../sanity/lib/client';

const cfg = dealerConfig.contact;
if (!cfg.enabled) return Astro.redirect('/', 302);

const { copy, placeholders } = cfg;

// Live contact facts — read from the businessInfo document. Fail-open: any error
// leaves every fact unset, and each renders its honest placeholder instead.
interface ContactFacts {
  phone?: string;
  email?: string;
  address?: string;
  openingHours?: Array<{ day?: string; hours?: string }>;
}
let info: ContactFacts = {};
try {
  const data = await client.fetch<ContactFacts | null>(
    `*[_type == "businessInfo"][0]{ phone, email, address, openingHours[]{ day, hours } }`,
  );
  if (data) info = data;
} catch (err) {
  console.error('[contact] business facts fetch failed (using placeholders)', err);
}

const phone = info.phone?.trim() || null;
const email = info.email?.trim() || null;
const address = info.address?.trim() || null;
const hours = (info.openingHours ?? []).filter((h) => h?.day);

// Optional bot protection — only rendered when a site key is configured.
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_USER_TURNSTILE_KEY;

const icon = (name: string, size = 16): string => {
  const s = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"`;
  const p: Record<string, string> = {
    pin: '<path d="M12 21s7-5.4 7-11a7 7 0 10-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    phone: '<path d="M4 5a2 2 0 012-2h2l2 5-2 1a11 11 0 005 5l1-2 5 2v2a2 2 0 01-2 2A15 15 0 014 5z"/>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
    map: '<path d="M9 3l6 2 5-2v16l-5 2-6-2-5 2V5z"/><path d="M9 3v16M15 5v16"/>',
    send: '<path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4z"/>',
    spark: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" fill="currentColor" stroke="none"/>',
    car: '<path d="M5 11l1.5-4A2 2 0 018.4 6h7.2a2 2 0 011.9 1.3L19 11"/><path d="M4 11h16v5H4z"/><circle cx="7.5" cy="16" r="1.5"/><circle cx="16.5" cy="16" r="1.5"/>',
    wrench: '<path d="M14 7a4 4 0 01-5 5l-6 6 2 2 6-6a4 4 0 005-5l-2 2-2-2 2-2z"/>',
    gear: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/>',
  };
  return `<svg ${s}>${p[name] ?? ''}</svg>`;
};

const title = `${copy.heading} — ${dealerConfig.identity.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={copy.subheading} />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="page-surface min-h-screen antialiased text-[15px] leading-relaxed">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <SiteNav />

    <main id="main-content" tabindex="-1">
      <section class="site-container hero-wrap">
        <div class="entry-origin">Reached from footer · department cards route onward · Rebi</div>
        <span class="eyebrow"><span set:html={icon('pin', 13)} /> {copy.eyebrow}</span>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-5xl">{copy.heading}</h1>
        <p class="lead mt-3 max-w-2xl">{copy.subheading}</p>
      </section>

      <!-- department cards: navigation to each department's real surface -->
      <section class="site-container section-tight">
        <div class="grid-auto" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,17rem),1fr))">
          {cfg.departments.map((d) => (
            <div class="card" style="padding:20px">
              <span style="color:var(--teal-deep)" set:html={icon(d.icon, 22)} />
              <b style="display:block; font-family:var(--font-display); font-size:17px; margin:10px 0 3px">{d.name}</b>
              <p class="muted" style="font-size:12.5px; margin-top:2px">{d.blurb}</p>
              <div style="display:flex; gap:8px; margin-top:14px">
                <a href={d.href} class="btn btn-primary btn-sm">{d.ctaLabel}</a>
                <button type="button" class="btn btn-ghost btn-sm" data-rebi-open data-rebi-kind="nav" aria-label={`Ask Rebi about ${d.name}`}><span set:html={icon('spark', 13)} /></button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="site-container contact-layout">
        <div class="stack" style="gap:16px">
          <div class="card" style="padding:22px">
            <h2 style="font-family:var(--font-display); font-size:18px; margin-bottom:14px">{copy.infoHeading}</h2>
            <div class="stack" style="gap:12px">
              <div style="display:flex; gap:10px; align-items:flex-start">
                <span style="color:var(--teal-deep); flex:none" set:html={icon('phone', 17)} />
                {phone
                  ? <a href={`tel:${phone.replace(/\s+/g, '')}`} style="font-size:14px; color:var(--ink)">{phone}</a>
                  : <span class="faint" style="font-size:13px">{placeholders.phone}</span>}
              </div>
              <div style="display:flex; gap:10px; align-items:flex-start">
                <span style="color:var(--teal-deep); flex:none" set:html={icon('mail', 17)} />
                {email
                  ? <a href={`mailto:${email}`} style="font-size:14px; color:var(--ink)">{email}</a>
                  : <span class="faint" style="font-size:13px">{placeholders.email}</span>}
              </div>
              <div style="display:flex; gap:10px; align-items:flex-start">
                <span style="color:var(--teal-deep); flex:none" set:html={icon('pin', 17)} />
                {address
                  ? <span style="font-size:14px; color:var(--ink)">{address}</span>
                  : <span class="faint" style="font-size:13px">{placeholders.address}</span>}
              </div>
              <div style="display:flex; gap:10px; align-items:flex-start">
                <span style="color:var(--teal-deep); flex:none" set:html={icon('clock', 17)} />
                {hours.length > 0
                  ? (
                    <div class="stack" style="gap:3px">
                      {hours.map((h) => (
                        <div style="font-size:13.5px; color:var(--ink-soft)"><b style="color:var(--ink)">{h.day}</b> · {h.hours || '—'}</div>
                      ))}
                    </div>
                  )
                  : <span class="faint" style="font-size:13px">{placeholders.hours}</span>}
              </div>
            </div>
          </div>

          <div class="card" style="padding:0; overflow:hidden">
            <div style="height:150px; background:linear-gradient(135deg,#3C5A78,#7C93AC); display:grid; place-items:center; color:#fff"><span set:html={icon('map', 34)} /></div>
            <div style="padding:14px"><p class="faint" style="font-size:12px">{copy.mapNote}</p></div>
          </div>
        </div>

        <div id="contact-root" class="card" data-loading-label={copy.loadingLabel} style="padding:24px">
          <h2 style="font-family:var(--font-display); font-size:18px; margin-bottom:16px">{copy.formHeading}</h2>
          <form id="contact-form" novalidate class="stack" style="gap:14px">
            <div class="field">
              <label class="field-label" for="ce-name">Your name</label>
              <input class="field-input" id="ce-name" name="name" type="text" required autocomplete="name" placeholder="e.g. Jordan Smith" />
            </div>
            <div class="field">
              <label class="field-label" for="ce-email">Email</label>
              <input class="field-input" id="ce-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
            </div>
            <div class="field">
              <label class="field-label" for="ce-phone">Phone <span class="faint">(optional)</span></label>
              <input class="field-input" id="ce-phone" name="phone" type="tel" autocomplete="tel" placeholder="e.g. 0400 000 000" />
            </div>
            <div class="field">
              <label class="field-label" for="ce-department">Department <span class="faint">(optional)</span></label>
              <select class="field-select" id="ce-department" name="department">
                <option value="">General enquiry</option>
                {cfg.departments.map((d) => <option value={d.name}>{d.name}</option>)}
              </select>
            </div>
            <div class="field">
              <label class="field-label" for="ce-message">Message</label>
              <textarea class="field-textarea" id="ce-message" name="message" rows="4" required placeholder="How can we help?"></textarea>
            </div>

            {TURNSTILE_SITE_KEY && (
              <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>
            )}

            <div>
              <button type="submit" id="ce-submit" class="btn btn-primary w-full justify-center disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto">
                <span set:html={icon('send', 15)} /> <span id="ce-submit-label">{copy.submitLabel}</span>
              </button>
            </div>
          </form>

          <p id="ce-error" role="alert" hidden class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></p>
          <div id="ce-success" hidden aria-live="polite" class="ai-summary mt-6">
            <p id="ce-success-text" class="text-sm font-medium text-ink"></p>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
    <ChatWidget />

    {TURNSTILE_SITE_KEY && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}

    <script>
      const root = document.getElementById('contact-root');
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      if (root && form) {
        const loadingLabel = root.dataset.loadingLabel || 'Sending your enquiry…';
        const submit = document.getElementById('ce-submit') as HTMLButtonElement;
        const submitLabel = document.getElementById('ce-submit-label') as HTMLElement;
        const defaultLabel = submitLabel.textContent || 'Send enquiry';
        const errorEl = document.getElementById('ce-error') as HTMLElement;
        const successEl = document.getElementById('ce-success') as HTMLElement;
        const successText = document.getElementById('ce-success-text') as HTMLElement;

        const showError = (msg: string) => {
          errorEl.textContent = msg;
          errorEl.hidden = false;
          successEl.hidden = true;
        };
        const setLoading = (on: boolean) => {
          submit.disabled = on;
          submitLabel.textContent = on ? loadingLabel : defaultLabel;
        };
        const isEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorEl.hidden = true;
          const data = new FormData(form);
          const payload = {
            name: String(data.get('name') || '').trim(),
            email: String(data.get('email') || '').trim(),
            phone: String(data.get('phone') || '').trim(),
            department: String(data.get('department') || '').trim(),
            message: String(data.get('message') || '').trim(),
            turnstileToken: String(data.get('cf-turnstile-response') || ''),
          };
          if (!payload.name) return showError('Please enter your name.');
          if (!isEmail(payload.email)) return showError('Please enter a valid email address.');
          if (!payload.message) return showError('Please enter a short message.');

          setLoading(true);
          try {
            const res = await fetch('/api/contact-enquiry', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const body = (await res.json()) as { ok?: boolean; message?: string; error?: string; reference?: string };
            if (!res.ok || !body.ok) {
              showError(body.error || 'We could not send that enquiry right now — please try again.');
              return;
            }
            successText.textContent =
              (body.message || "Thanks — we've received your enquiry.") +
              (body.reference ? ` Reference: ${body.reference}.` : '');
            successEl.hidden = false;
            form.reset();
            if (typeof (window as any).turnstile !== 'undefined') (window as any).turnstile.reset();
            successEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } catch {
            showError('Something went wrong — please check your connection and try again.');
          } finally {
            setLoading(false);
          }
        });
      }
    </script>

    <style>
      .contact-layout {
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        gap: 26px;
        align-items: start;
        padding-bottom: 44px;
      }
      @media (max-width: 820px) {
        .contact-layout { grid-template-columns: 1fr; }
      }
      /* NFY form-control primitives (ported from sell.astro / service.astro). */
      .field { display: flex; flex-direction: column; gap: 7px; }
      .field-label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
      .field-input,
      .field-select,
      .field-textarea {
        width: 100%;
        font-family: var(--font-ui);
        font-size: 15px;
        color: var(--ink);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
        transition: border-color 0.16s, box-shadow 0.16s;
      }
      .field-input::placeholder,
      .field-textarea::placeholder { color: var(--ink-faint); }
      .field-input:focus,
      .field-select:focus,
      .field-textarea:focus {
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(15, 181, 166, 0.15);
        outline: none;
      }
      .field-textarea { resize: vertical; min-height: 96px; }
    </style>
  </body>
</html>
