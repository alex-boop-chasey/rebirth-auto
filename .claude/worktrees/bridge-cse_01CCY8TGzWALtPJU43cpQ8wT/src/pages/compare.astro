      /* section header rows — quiet slate index band with a small slate tick */
      .vboard .section .rail { background: var(--band); backdrop-filter: none; color: var(--ink); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 800; border-right: 1px solid var(--ring); border-top: 1px solid var(--ring-3); }
      .vboard .section .rail::before { content: ""; width: 3px; height: 13px; border-radius: 2px; background: var(--ink-dim); flex: none; }
      .vboard .section .fill { grid-column: 2 / -1; background: var(--band); border-bottom: 1px solid var(--ring); border-top: 1px solid var(--ring-3); }

