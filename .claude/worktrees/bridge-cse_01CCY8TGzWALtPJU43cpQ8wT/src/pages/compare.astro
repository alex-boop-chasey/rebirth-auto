    </style>

    <script>
      import { buildVerdict, LENSES, type CompareCar, type DimKey } from '../lib/compare-verdict';

      const board = document.getElementById('board');
      const dataEl = document.getElementById('vboard-data');
      if (board && dataEl?.textContent) {
        const cars = JSON.parse(dataEl.textContent) as CompareCar[];
        const grid = board.querySelector('.grid') as HTMLElement | null;
        const beam = document.getElementById('beam');
        let currentIds = cars.map((c) => c.id);
        let lensId = 'balanced';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const esc = (s: string) =>
          s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        const CHECK =
          '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.2l3 3 7-7"/></svg>';
        const BOLT =
          '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 1.5L3.5 9H8l-1 5.5L12.5 7H8z"/></svg>';

        const $ = (id: string) => document.getElementById(id);

        function renderVerdict(id: string) {
          const v = buildVerdict(cars, id);
          const lens = LENSES.find((l) => l.id === id) ?? LENSES[0];
          const pick = $('vc-pick');
          const role = $('vc-role');
          const scoreEl = $('vc-score');
          const weighEl = $('vc-weighing');
          const reasonsEl = $('vc-reasons');
          if (pick) pick.textContent = v.pickName;
          if (role) role.textContent = `for the ${lens.label.toLowerCase()} buyer`;
          if (scoreEl) scoreEl.textContent = String(v.score);
          if (weighEl) weighEl.textContent = v.weighing;
          // Confidence meter: re-animate the fill to the new match value on every
          // lens change. Reset to 0, force a reflow, then set the target so the CSS
          // transition always runs — reliable even if rAF is throttled (background
          // tab). Under reduced-motion the CSS transition is disabled, so it snaps.
          const meterFill = $('vc-meter-fill');
          if (meterFill) {
            meterFill.style.width = '0%';
            void meterFill.offsetWidth; // force reflow so the width change animates
            meterFill.style.width = `${v.score}%`;
          }
          if (reasonsEl) {
            reasonsEl.innerHTML = v.reasons
              .map(
                (r) =>
                  `<div class="vc-reason${r.caveat ? ' caveat' : ''}">${
                    r.caveat ? BOLT : CHECK
                  }<span>${esc(r.text)}</span></div>`,
              )
              .join('');
          }
          return v;
        }

        function moveBeam(pickId: string) {
          if (!beam || !grid) return;
          const cell = grid.querySelector(`.chead[data-car-id="${CSS.escape(pickId)}"]`) as HTMLElement | null;
          if (!cell) {
            beam.style.opacity = '0';
            return;
          }
          beam.style.width = `${cell.offsetWidth}px`;
          beam.style.transform = `translateX(${cell.offsetLeft}px)`;
          beam.style.opacity = '1';
        }

        function applyRelevance(id: string) {
          const lens = LENSES.find((l) => l.id === id) ?? LENSES[0];
          const w = lens.w as Partial<Record<DimKey, number>>;
          const balanced = id === 'balanced';
          grid?.querySelectorAll<HTMLElement>('.row.spec[data-dim]').forEach((row) => {
            const dim = row.dataset.dim as DimKey | undefined;
            const weighted = dim ? (w[dim] ?? 0) > 0 : false;
            row.classList.toggle('relevant', !balanced && weighted);
            row.classList.toggle('muted', !balanced && !weighted);
          });
        }

        function apply(id: string) {
          lensId = id;
          const v = renderVerdict(id);
          grid?.querySelectorAll<HTMLElement>('.chead').forEach((h) => {
            h.classList.toggle('pick', h.dataset.carId === v.pickId);
          });
          applyRelevance(id);
          moveBeam(v.pickId);
        }

        // Lens pills
        document.getElementById('lenses')?.querySelectorAll<HTMLButtonElement>('[data-lens]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.dataset.lens || 'balanced';
            document
              .getElementById('lenses')
              ?.querySelectorAll('.lens')
              .forEach((x) => x.classList.toggle('active', x === btn));
            apply(id);
          });
        });

        // Differences-only toggle
        const diff = document.getElementById('diffToggle') as HTMLInputElement | null;
        diff?.addEventListener('change', () => board.classList.toggle('diff', diff.checked));

        // Remove-from-compare (min-two guard) — reloads so the server recomputes
        // winners/deltas with the shared logic; also syncs the compare tray store.
        const COMPARE_KEY = 'astro-listings-compare';
        const META_KEY = 'astro-listings-compare-meta';
        function removeFromStore(id: string) {
          try {
            const raw = localStorage.getItem(COMPARE_KEY);
            const arr = raw ? (JSON.parse(raw) as string[]) : [];
            const next = Array.isArray(arr) ? arr.filter((x) => x !== id) : [];
            localStorage.setItem(COMPARE_KEY, JSON.stringify(next));
            const mraw = localStorage.getItem(META_KEY);
            const meta = mraw ? JSON.parse(mraw) : {};
            if (meta && typeof meta === 'object') {
              delete meta[id];
              localStorage.setItem(META_KEY, JSON.stringify(meta));
            }
          } catch {
            /* localStorage unavailable — no-op */
          }
        }
        function flashCorner() {
          const cp = grid?.querySelector('.verdict-corner') as HTMLElement | null;
          cp?.animate(
            [
              { boxShadow: 'inset 0 0 0 1px transparent' },
              { boxShadow: 'inset 0 0 0 2px #dc2626' },
              { boxShadow: 'inset 0 0 0 1px transparent' },
            ],
            { duration: 600 },
          );
        }
        grid?.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const id = btn.dataset.remove || '';
            const remaining = currentIds.filter((x) => x !== id);
            if (remaining.length < 2) {
              flashCorner();
              return;
            }
            removeFromStore(id);
            window.location.href = `/compare?ids=${remaining.map(encodeURIComponent).join(',')}`;
          });
        });

        // Keep the beam aligned when columns reflow.
        let rz: ReturnType<typeof setTimeout>;
        window.addEventListener('resize', () => {
          clearTimeout(rz);
          rz = setTimeout(() => {
            const v = buildVerdict(cars, lensId);
            moveBeam(v.pickId);
          }, 120);
        });

        // Entrance stagger
        if (!reduceMotion) {
          grid?.querySelectorAll<HTMLElement>('.verdict-corner, .chead').forEach((el, i) => {
            el.classList.add('anim');
            el.style.animationDelay = `${i * 55}ms`;
            requestAnimationFrame(() => el.classList.add('in'));
          });
        }

        // Boot: position beam + verdict for the default lens.
        apply('balanced');
        requestAnimationFrame(() => moveBeam(buildVerdict(cars, 'balanced').pickId));
      }
    </script>
  </body>
</html>
